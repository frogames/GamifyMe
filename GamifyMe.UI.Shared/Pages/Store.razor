@page "/store"
@using GamifyMe.Shared.Dtos
@using GamifyMe.Shared.Models
@using GamifyMe.UI.Shared.Helpers
@using GamifyMe.UI.Shared.Components
@using System.Net.Http.Json
@using MudBlazor
@using Microsoft.JSInterop
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4 mb-16">
    <div class="d-flex justify-space-between align-center mb-6">
        <MudText Typo="Typo.h4" Color="Color.Primary">Boutique</MudText>
        
        <MudChip T="string" Icon="@Icons.Material.Filled.MonetizationOn" Color="Color.Info" Variant="Variant.Filled" Size="Size.Large">
            @userCurrencyBalance
        </MudChip>
    </div>

    <div class="d-flex justify-end mb-4">
        <MudSelect T="string" @bind-Value="selectedFilter" Label="Catégorie" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" Class="d-inline-flex" Style="min-width: 200px;">
            <MudSelectItem Value="@("All")">Tout</MudSelectItem>
            <MudSelectItem Value="@("Physical")">Objets Physiques</MudSelectItem>
            <MudSelectItem Value="@("Interfaces")">Interfaces</MudSelectItem>
            <MudSelectItem Value="@("Sounds")">Sons</MudSelectItem>
            <MudSelectItem Value="@("QRCode")">QR Codes</MudSelectItem>
            <MudSelectItem Value="@("Boost")">Boosts</MudSelectItem>
        </MudSelect>
    </div>

    @if (isLoading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="ma-auto d-block" />
    }
    else if (!FilteredItems.Any())
    {
        <MudAlert Severity="Severity.Info">Aucun article ne correspond à votre recherche.</MudAlert>
    }
    else
    {
        <MudGrid>
            @foreach (var item in FilteredItems)
            {
                <MudItem xs="6" sm="4" md="3">
                    <MudCard Elevation="3" Class="d-flex flex-column h-100 cursor-pointer hover-effect rounded-lg" 
                             Style="@($"border-radius: 16px; overflow: hidden; {GetCardStyle(item)}")"
                             @onclick="@(() => OpenItemDetails(item))">
                        <MudCardHeader>
                            <CardHeaderAvatar>
                                <MudAvatar Color="@(string.IsNullOrEmpty(item.Color) ? Color.Primary : Color.Default)" Variant="Variant.Filled" Style="@(!string.IsNullOrEmpty(item.Color) ? $"background-color:rgba(255,255,255,0.2); color:{ColorHelper.GetContrastColor(item.Color)};" : "")">
                                    <MudIcon Icon="@IconLibrary.GetIcon(item.IconName)" Size="Size.Large" Style="@(!string.IsNullOrEmpty(item.Color) ? $"color:{ColorHelper.GetContrastColor(item.Color)};" : "color:white;")" />
                                </MudAvatar>
                            </CardHeaderAvatar>
                        </MudCardHeader>
                        <MudCardContent Class="d-flex flex-column align-center justify-center pt-2 pb-4" Style="height: 100%;">
                            <div class="d-flex flex-column align-center">
                                <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-2 text-truncate" Style="@($"font-weight:bold; color:{(string.IsNullOrEmpty(item.Color) ? "inherit" : ColorHelper.GetContrastColor(item.Color))}; width: 100%;")">@item.Name</MudText>
                                
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" 
                                         Style="@($"color:{(string.IsNullOrEmpty(item.Color) ? "inherit" : ColorHelper.GetContrastColor(item.Color))}; border-color:{(string.IsNullOrEmpty(item.Color) ? "inherit" : ColorHelper.GetContrastColor(item.Color))};")">
                                    @(item.ItemType == StoreItemType.Digital ? "Numérique" : "Physique")
                                </MudChip>
                            </div>
                            
                            <MudChip T="string" Size="Size.Medium" Icon="@Icons.Material.Filled.MonetizationOn" Variant="Variant.Filled" Color="Color.Info" Class="mt-3">
                                @item.Price
                            </MudChip>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

<style>
    .hover-effect { transition: transform 0.2s; }
    .hover-effect:hover { transform: translateY(-5px); }
    .description-clamp {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>

@code {
    private List<StoreItemDto> storeItems = new();
    private List<UserInventoryDto> userInventory = new();
    private bool isLoading = true;
    private int userCurrencyBalance = 0;
    private string selectedFilter = "All";

    private IEnumerable<StoreItemDto> FilteredItems
    {
        get
        {
            if (storeItems == null) return Enumerable.Empty<StoreItemDto>();
            
            return selectedFilter switch
            {
                "Physical" => storeItems.Where(i => i.ItemType == StoreItemType.Physical),
                "Interfaces" => storeItems.Where(i => i.ItemType == StoreItemType.Digital && 
                                                      i.DigitalActionCode != null && 
                                                      i.DigitalActionCode.StartsWith("UI_THEME_", StringComparison.OrdinalIgnoreCase)),
                "Sounds" => storeItems.Where(i => i.ItemType == StoreItemType.Digital && 
                                                 i.DigitalActionCode == "SCAN_SOUND"),
                "QRCode" => storeItems.Where(i => i.ItemType == StoreItemType.Digital && 
                                                  i.DigitalActionCode != null && 
                                                  i.DigitalActionCode.StartsWith("QR_STYLE_", StringComparison.OrdinalIgnoreCase)),
                "Boost" => storeItems.Where(i => i.ItemType == StoreItemType.Digital && 
                                                 i.DigitalActionCode != null && 
                                                 i.DigitalActionCode.Contains("BOOST", StringComparison.OrdinalIgnoreCase)),
                _ => storeItems
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadStoreItems();
    }

    private async Task LoadStoreItems()
    {
        isLoading = true;
        try
        {
            var itemsTask = Http.GetFromJsonAsync<List<StoreItemDto>>("api/store/active");
            var infoTask = Http.GetFromJsonAsync<InfoBarDto>("api/users/info-bar");
            var inventoryTask = Http.GetFromJsonAsync<List<UserInventoryDto>>("api/users/inventory");

            await Task.WhenAll(itemsTask, infoTask, inventoryTask);

            storeItems = itemsTask.Result ?? new List<StoreItemDto>();
            var info = infoTask.Result;
            userInventory = inventoryTask.Result ?? new List<UserInventoryDto>();

            if (info?.OtherWallets != null && info.OtherWallets.Any())
            {
                userCurrencyBalance = info.OtherWallets.First().Balance;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur de chargement : {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OpenItemDetails(StoreItemDto item)
    {
        // Prevent buying boost if one is already active
        if (IsBoost(item) && HasActiveBoost())
        {
             Snackbar.Add("Vous avez déjà un boost actif. Attendez qu'il expire pour en acheter un autre.", Severity.Warning);
             return;
        }

        var parameters = new DialogParameters<StoreItemDetailsDialog> 
        { 
            { x => x.Item, item },
            { x => x.OnPlaySound, EventCallback.Factory.Create<string>(this, PreviewSound) }
        };
        // Removed title "Détails" (title ignored if NoHeader=true), set NoHeader=true
        var options = new DialogOptions { NoHeader = true, CloseButton = false, MaxWidth = MaxWidth.Small, FullWidth = true };
        
        var dialog = DialogService.Show<StoreItemDetailsDialog>("", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is bool confirmed && confirmed)
        {
            await OpenPurchaseConfirmation(item);
        }
    }

    private async Task OpenPurchaseConfirmation(StoreItemDto item)
    {
        var parameters = new DialogParameters<PurchaseConfirmationDialog> 
        { 
            { x => x.Item, item },
            { x => x.UserBalance, userCurrencyBalance }
        };
        var options = new DialogOptions { CloseButton = false, MaxWidth = MaxWidth.ExtraSmall };

        var dialog = DialogService.Show<PurchaseConfirmationDialog>("Confirmation", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is bool confirmed && confirmed)
        {
            await PurchaseItem(item);
        }
    }

    private async Task PurchaseItem(StoreItemDto item)
    {
        try
        {
            var response = await Http.PostAsync($"api/store/purchase/{item.Id}", null);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"Vous avez acheté : {item.Name} !", Severity.Success);
                await LoadStoreItems(); // Refresh balance and stock
            }
            else
            {
                var errorMsg = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Achat impossible : {errorMsg}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur technique : {ex.Message}", Severity.Error);
        }
    }

    private async Task PreviewSound(string url)
    {
        try
        {
            if (!url.StartsWith("http") && Http.BaseAddress != null)
            {
                url = new Uri(Http.BaseAddress, url).ToString();
            }
            await JSRuntime.InvokeVoidAsync("eval", $"new Audio('{url}').play()");
        }
        catch
        {
            Snackbar.Add("Impossible de lire l'audio", Severity.Error);
        }
    }

    private string GetCardStyle(StoreItemDto item)
    {
        var style = "";
        
        // Background Color
        if (!string.IsNullOrEmpty(item.Color))
        {
            style += $"background-color: {item.Color}; ";
        }

        if (item.IsOwned && item.IsUnique)
        {
            style += "opacity: 0.6; filter: grayscale(100%);";
        }
        
        // Affordability Border
        bool isBoostBlocked = IsBoost(item) && HasActiveBoost();

        if (userCurrencyBalance >= item.Price && !isBoostBlocked)
        {
            style += "border: 8px solid var(--mud-palette-success);";
        }
        else
        {
            style += "border: 8px solid var(--mud-palette-error);";
        }
        
        return style;
    }

    private bool IsBoost(StoreItemDto item)
    {
        return item.DigitalActionCode != null && item.DigitalActionCode.Contains("BOOST", StringComparison.OrdinalIgnoreCase);
    }

    private bool HasActiveBoost()
    {
        // Check if user has any active boost in inventory that hasn't expired
        // Assuming inventory items have ExpiresAt and IsActive (or we calculate active based on expiry)
        // Based on UserInventory.cs, we have ExpiresAt.
        // And usually a boost is considered active if ExpiresAt > DateTime.UtcNow.
        // Let's check the DTO. I'll assume UserInventoryDto has ExpiresAt.
        return userInventory.Any(i => i.DigitalActionCode != null && 
                                      i.DigitalActionCode.Contains("BOOST", StringComparison.OrdinalIgnoreCase) && 
                                      i.ExpiresAt.HasValue && 
                                      i.ExpiresAt.Value > DateTime.UtcNow);
    }
}