@page "/store"
@using GamifyMe.Shared.Dtos
@using GamifyMe.Shared.Models
@using GamifyMe.UI.Shared.Helpers
@using GamifyMe.UI.Shared.Components
@using System.Net.Http.Json
@using MudBlazor
@using Microsoft.JSInterop
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4 mb-16">
    <div class="d-flex justify-space-between align-center mb-6">
        <MudText Typo="Typo.h4" Color="Color.Primary">Boutique</MudText>
        
        <MudChip T="string" Icon="@Icons.Material.Filled.MonetizationOn" Color="Color.Info" Variant="Variant.Filled" Size="Size.Large">
            @userCurrencyBalance
        </MudChip>
    </div>

    <MudPaper Class="mb-6 pa-4" Elevation="1">
        <MudText Typo="Typo.subtitle1" Class="mb-2">Filtrer par type :</MudText>
        <MudSelect T="string" @bind-Value="selectedFilter" Label="Catégorie" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
            <MudSelectItem Value="@("All")">Tout</MudSelectItem>
            <MudSelectItem Value="@("Physical")">Objets Physiques</MudSelectItem>
            <MudSelectItem Value="@("Interfaces")">Interfaces</MudSelectItem>
            <MudSelectItem Value="@("Sounds")">Sons</MudSelectItem>
            <MudSelectItem Value="@("QRCode")">QR Codes</MudSelectItem>
            <MudSelectItem Value="@("Boost")">Boosts</MudSelectItem>
        </MudSelect>
    </MudPaper>

    @if (isLoading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="ma-auto d-block" />
    }
    else if (!FilteredItems.Any())
    {
        <MudAlert Severity="Severity.Info">Aucun article ne correspond à votre recherche.</MudAlert>
    }
    else
    {
        <MudGrid>
            @foreach (var item in FilteredItems)
            {
                <MudItem xs="6" sm="4" md="3">
                    <MudCard Elevation="3" Class="d-flex flex-column h-100 cursor-pointer hover-effect" 
                             Style="@(item.IsOwned && item.IsUnique ? "opacity: 0.6; filter: grayscale(100%);" : "")"
                             @onclick="@(() => OpenItemDetails(item))">
                        <MudCardHeader>
                            <CardHeaderAvatar>
                                <MudIcon Icon="@IconLibrary.GetIcon(item.IconName)" Size="Size.Large" Color="Color.Primary" />
                            </CardHeaderAvatar>
                            <CardHeaderContent>
                                <MudText Typo="Typo.body1" Style="font-weight:bold;">@item.Name</MudText>
                                @if (item.IsOwned && item.IsUnique)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Success">Déjà possédé</MudText>
                                }
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent Class="flex-grow-1 pt-0">
                            <MudText Typo="Typo.caption" Class="mb-2 description-clamp">@item.Description</MudText>
                            <div class="d-flex justify-space-between align-end mt-2">
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-weight:bold;">@item.Price Cr</MudText>
                                @if (item.ItemType != StoreItemType.Digital && item.Stock == 0)
                                {
                                     <MudIcon Icon="@Icons.Material.Filled.Block" Color="Color.Error" Size="Size.Small" />
                                }
                            </div>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

<style>
    .hover-effect { transition: transform 0.2s; }
    .hover-effect:hover { transform: translateY(-5px); }
    .description-clamp {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>

@code {
    private List<StoreItemDto> storeItems = new();
    private bool isLoading = true;
    private int userCurrencyBalance = 0;
    private string selectedFilter = "All";

    private IEnumerable<StoreItemDto> FilteredItems
    {
        get
        {
            if (storeItems == null) return Enumerable.Empty<StoreItemDto>();
            
            return selectedFilter switch
            {
                "Physical" => storeItems.Where(i => i.ItemType == StoreItemType.Physical),
                "Interfaces" => storeItems.Where(i => i.ItemType == StoreItemType.Digital && 
                                                      i.DigitalActionCode != null && 
                                                      i.DigitalActionCode.StartsWith("UI_THEME_", StringComparison.OrdinalIgnoreCase)),
                "Sounds" => storeItems.Where(i => i.ItemType == StoreItemType.Digital && 
                                                 i.DigitalActionCode == "SCAN_SOUND"),
                "QRCode" => storeItems.Where(i => i.ItemType == StoreItemType.Digital && 
                                                  i.DigitalActionCode != null && 
                                                  i.DigitalActionCode.StartsWith("QR_STYLE_", StringComparison.OrdinalIgnoreCase)),
                "Boost" => storeItems.Where(i => i.ItemType == StoreItemType.Digital && 
                                                 i.DigitalActionCode != null && 
                                                 i.DigitalActionCode.Contains("BOOST", StringComparison.OrdinalIgnoreCase)),
                _ => storeItems
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadStoreItems();
    }

    private async Task LoadStoreItems()
    {
        isLoading = true;
        try
        {
            var itemsTask = Http.GetFromJsonAsync<List<StoreItemDto>>("api/store/active");
            var infoTask = Http.GetFromJsonAsync<InfoBarDto>("api/users/info-bar");

            await Task.WhenAll(itemsTask, infoTask);

            storeItems = itemsTask.Result ?? new List<StoreItemDto>();
            var info = infoTask.Result;

            if (info?.OtherWallets != null && info.OtherWallets.Any())
            {
                userCurrencyBalance = info.OtherWallets.First().Balance;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur de chargement : {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OpenItemDetails(StoreItemDto item)
    {
        var parameters = new DialogParameters<StoreItemDetailsDialog> 
        { 
            { x => x.Item, item },
            { x => x.OnPlaySound, EventCallback.Factory.Create<string>(this, PreviewSound) }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        
        var dialog = DialogService.Show<StoreItemDetailsDialog>("Détails", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is bool confirmed && confirmed)
        {
            await OpenPurchaseConfirmation(item);
        }
    }

    private async Task OpenPurchaseConfirmation(StoreItemDto item)
    {
        var parameters = new DialogParameters<PurchaseConfirmationDialog> 
        { 
            { x => x.Item, item },
            { x => x.UserBalance, userCurrencyBalance }
        };
        var options = new DialogOptions { CloseButton = false, MaxWidth = MaxWidth.ExtraSmall };

        var dialog = DialogService.Show<PurchaseConfirmationDialog>("Confirmation", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is bool confirmed && confirmed)
        {
            await PurchaseItem(item);
        }
    }

    private async Task PurchaseItem(StoreItemDto item)
    {
        try
        {
            var response = await Http.PostAsync($"api/store/purchase/{item.Id}", null);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"Vous avez acheté : {item.Name} !", Severity.Success);
                await LoadStoreItems(); // Refresh balance and stock
            }
            else
            {
                var errorMsg = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Achat impossible : {errorMsg}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur technique : {ex.Message}", Severity.Error);
        }
    }

    private async Task PreviewSound(string url)
    {
        try
        {
            if (!url.StartsWith("http") && Http.BaseAddress != null)
            {
                url = new Uri(Http.BaseAddress, url).ToString();
            }
            await JSRuntime.InvokeVoidAsync("eval", $"new Audio('{url}').play()");
        }
        catch
        {
            Snackbar.Add("Impossible de lire l'audio", Severity.Error);
        }
    }
}