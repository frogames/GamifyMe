@page "/dashboard"
@attribute [Authorize(Roles = "SuperAdmin, Admin, Editeur, Gestionnaire")]

@using MudBlazor
@using GamifyMe.Shared.Dtos
@using GamifyMe.Shared.Models
@using System.Net.Http.Json
@using GamifyMe.UI.Shared.Components

@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Dashboard Gestionnaire</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-16">

    <MudText Typo="Typo.h4" GutterBottom="true" Color="Color.Primary" Class="mb-6">Dashboard Gestionnaire</MudText>

    @* --- CARTES DE NAVIGATION --- *@
    <MudGrid Class="mb-8">
        <MudItem xs="12" sm="4">
            <MudCard Elevation="3" Class="cursor-pointer hover-effect" @onclick="@(() => Navigation.NavigateTo("/admin/scan-profile"))">
                <MudCardContent Class="d-flex flex-column align-center pa-8">
                    <MudIcon Icon="@Icons.Material.Filled.QrCodeScanner" Size="Size.Large" Color="Color.Primary" Class="mb-4" Style="font-size: 4rem;" />
                    <MudText Typo="Typo.h6" Align="Align.Center">Scanner Profil</MudText>
                    <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-2">Valider les commandes et scanner les joueurs</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudCard Elevation="3" Class="cursor-pointer hover-effect" @onclick="@(() => Navigation.NavigateTo("/admin/objectives"))">
                <MudCardContent Class="d-flex flex-column align-center pa-8">
                    <MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Large" Color="Color.Secondary" Class="mb-4" Style="font-size: 4rem;" />
                    <MudText Typo="Typo.h6" Align="Align.Center">Gérer Objectifs</MudText>
                    <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-2">Créer, modifier et scanner les objectifs</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudCard Elevation="3" Class="cursor-pointer hover-effect" @onclick="@(() => Navigation.NavigateTo("/admin/store"))">
                <MudCardContent Class="d-flex flex-column align-center pa-8">
                    <MudIcon Icon="@Icons.Material.Filled.Store" Size="Size.Large" Color="Color.Success" Class="mb-4" Style="font-size: 4rem;" />
                    <MudText Typo="Typo.h6" Align="Align.Center">Gérer Boutique</MudText>
                    <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-2">Ajouter des objets et gérer le stock</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudCard Elevation="3" Class="cursor-pointer hover-effect" @onclick="@(() => Navigation.NavigateTo("/admin/groups"))">
                <MudCardContent Class="d-flex flex-column align-center pa-8">
                    <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Large" Color="Color.Info" Class="mb-4" Style="font-size: 4rem;" />
                    <MudText Typo="Typo.h6" Align="Align.Center">Gérer Groupes</MudText>
                    <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-2">Créer et gérer les groupes</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudCard Elevation="3" Class="cursor-pointer hover-effect" @onclick="@(() => Navigation.NavigateTo("/admin/bonus-periods"))">
                <MudCardContent Class="d-flex flex-column align-center pa-8">
                    <MudIcon Icon="@Icons.Material.Filled.Stars" Size="Size.Large" Color="Color.Warning" Class="mb-4" Style="font-size: 4rem;" />
                    <MudText Typo="Typo.h6" Align="Align.Center">Gérer Bonus</MudText>
                    <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-2">Configurer les périodes de bonus</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <MudDivider Class="my-8" />

    @* --- JOURNAL D'ACTIVITÉ --- *@
    <MudText Typo="Typo.h4" Class="mb-4">Journal d'Activité</MudText>

    @if (isPageLoading)
    {
        <div class="d-flex justify-center my-8">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else
    {
        <MudTable Items="@dashboardLogs" Hover="true" Dense="true" Striped="true" Elevation="3" Class="mb-16">
            <HeaderContent>
                <MudTh>Date / Heure</MudTh>
                <MudTh>Action</MudTh>
                <MudTh>Détails</MudTh>
                <MudTh>Auteur</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Date">@context.Date.ToLocalTime().ToString("g")</MudTd>
                <MudTd DataLabel="Action">
                    <div class="d-flex align-center">
                        @{
                            var color = context.Color switch
                            {
                                "Success" => Color.Success,
                                "Warning" => Color.Warning,
                                "Info" => Color.Info,
                                _ => Color.Default
                            };
                        }
                        <MudIcon Icon="@context.Icon" Color="@color" Size="Size.Small" Class="mr-2" />
                        <MudText Typo="Typo.body2">@context.ActionType</MudText>
                    </div>
                </MudTd>
                <MudTd DataLabel="Détails"><b>@context.Details</b></MudTd>
                <MudTd DataLabel="Auteur"><MudChip T="string" Size="Size.Small" Variant="Variant.Text">@context.ActorName</MudChip></MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    }

</MudContainer>

<style>
    .hover-effect {
        transition: transform 0.2s;
    }
    .hover-effect:hover {
        transform: translateY(-5px);
    }
</style>

@code {
    private List<DashboardLogDto> dashboardLogs = new();
    private bool isPageLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            dashboardLogs = await Http.GetFromJsonAsync<List<DashboardLogDto>>("api/dashboard/activity-logs") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur chargement : {ex.Message}");
        }
        finally
        {
            isPageLoading = false;
        }
    }
}