@page "/leaderboard"
@attribute [Authorize]

@using MudBlazor
@using GamifyMe.Shared.Dtos
@using GamifyMe.UI.Shared.Helpers
@using System.Net.Http.Json
@using GamifyMe.UI.Shared.Components

@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Classements</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-16">
    <MudText Typo="Typo.h5" Class="mb-4">Classements</MudText>
    <MudText Typo="Typo.body1" Class="mb-6">
        Découvrez les meilleurs joueurs et les groupes les plus actifs de votre établissement !
    </MudText>

    @if (isLoadingProfile)
    {
         <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="d-block mb-4" />
    }

    <!-- Custom Tabs Replacement -->
    <div class="d-flex flex-column align-center gap-4">
        
        <!-- Main Category Toggle (Players vs Groups) -->
        <MudButtonGroup OverrideStyles="false" Class="gap-0" Style="border-radius: 20px; overflow: hidden; border: 1px solid var(--mud-palette-primary);">
            <MudButton Variant="@(_selectedCategory == "Players" ? Variant.Filled : Variant.Text)" 
                       Color="Color.Primary" 
                       OnClick="@(() => SetCategory("Players"))"
                       Class="px-8 py-2"
                       Style="@(_selectedCategory == "Players" ? "font-weight: bold;" : "font-weight: normal;")">
                JOUEURS
            </MudButton>
             <MudButton Variant="@(_selectedCategory == "Groups" ? Variant.Filled : Variant.Text)" 
                       Color="Color.Primary" 
                        OnClick="@(() => SetCategory("Groups"))"
                       Class="px-8 py-2"
                       Style="@(_selectedCategory == "Groups" ? "font-weight: bold;" : "font-weight: normal;")">
                GROUPES
            </MudButton>
        </MudButtonGroup>

        <!-- Sub Category Toggle -->
        @if (_selectedCategory == "Players")
        {
            <MudButtonGroup OverrideStyles="false" Class="gap-0 mt-2" Style="border-radius: 20px; overflow: hidden; border: 1px solid var(--mud-palette-primary);">
                <MudButton Variant="@(_selectedSubCategory == "XP" ? Variant.Filled : Variant.Text)" 
                           Color="Color.Primary" 
                           OnClick="@(() => SetSubCategory("XP"))"
                           Class="px-6 py-1"
                           Size="Size.Small"
                           Style="@(_selectedSubCategory == "XP" ? "font-weight: bold;" : "font-weight: normal;")">
                    XP
                </MudButton>
                 @if (currentUser?.IsShopEnabled == true)
                 {
                    <MudButton Variant="@(_selectedSubCategory == "Currency" ? Variant.Filled : Variant.Text)" 
                               Color="Color.Primary" 
                               OnClick="@(() => SetSubCategory("Currency"))"
                               Class="px-6 py-1"
                               Size="Size.Small"
                               Style="@(_selectedSubCategory == "Currency" ? "font-weight: bold;" : "font-weight: normal;")">
                        @(currentUser?.CurrencyName ?? "CRÉDITS")
                    </MudButton>
                 }
            </MudButtonGroup>
        }
        else
        {
             <MudButtonGroup OverrideStyles="false" Class="gap-0 mt-2" Style="border-radius: 20px; overflow: hidden; border: 1px solid var(--mud-palette-primary);">
                <MudButton Variant="@(_selectedSubCategory == "XP" ? Variant.Filled : Variant.Text)" 
                           Color="Color.Primary" 
                           OnClick="@(() => SetSubCategory("XP"))"
                           Class="px-6 py-1"
                           Size="Size.Small"
                           Style="@(_selectedSubCategory == "XP" ? "font-weight: bold;" : "font-weight: normal;")">
                    XP
                </MudButton>
                <MudButton Variant="@(_selectedSubCategory == "Members" ? Variant.Filled : Variant.Text)" 
                           Color="Color.Primary" 
                           OnClick="@(() => SetSubCategory("Members"))"
                           Class="px-6 py-1"
                           Size="Size.Small"
                           Style="@(_selectedSubCategory == "Members" ? "font-weight: bold;" : "font-weight: normal;")">
                    MEMBRES
                </MudButton>
            </MudButtonGroup>
        }

    </div>

    <MudPaper Class="mt-6 pa-0" Elevation="2" Style="overflow: hidden; border-radius: 8px;">
        @if (_selectedCategory == "Players")
        {
            @if (_selectedSubCategory == "XP")
            {
                 @if (isLoadingUsersXp)
                {
                    <div class="d-flex justify-center pa-4">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    </div>
                }
                else
                {
                    @if (currentUser != null && usersXpLeaderboard.Any(u => u.Username == currentUser.Username))
                    {
                         var rank = usersXpLeaderboard.First(u => u.Username == currentUser.Username);
                         <MudAlert Severity="Severity.Info" Class="ma-4">Votre rang : <strong>#@rank.Rank</strong> (@rank.TotalXp XP)</MudAlert>
                    }

                    <MudText Typo="Typo.caption" Class="d-block mt-2 mb-2 pr-4" Align="Align.End">@usersXpLeaderboard.Count joueurs classés</MudText>
                    <MudTable Items="@usersXpLeaderboard" Hover="true" Striped="true" Dense="true" Breakpoint="Breakpoint.None" RowStyleFunc="@RowStyleUser" OnRowClick="OnUserRowClick" T="UserLeaderboardEntryDto" RowClass="cursor-pointer leaderboard-row" Elevation="0">
                        <HeaderContent>
                            <MudTh>Rang</MudTh>
                            <MudTh>Joueur</MudTh>
                            <MudTh>XP</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="user">
                            <MudTd DataLabel="Rang">@RenderRank(user.Rank)</MudTd>
                            <MudTd DataLabel="Joueur"> 
                                <div class="d-flex align-center">
                                    @if(!string.IsNullOrEmpty(user.FavoriteBadgeIcon) || !string.IsNullOrEmpty(user.FavoriteBadgeImageUrl))
                                    {
                                         @if (!string.IsNullOrEmpty(user.FavoriteBadgeImageUrl))
                                         {
                                             <MudAvatar Size="Size.Small" Class="mr-2">
                                                 <MudImage Src="@GetImageSrc(user.FavoriteBadgeImageUrl)" ObjectFit="ObjectFit.Cover" />
                                             </MudAvatar>
                                         }
                                         else
                                         {
                                             <GamifyIcon IconName="@user.FavoriteBadgeIcon" Class="mr-2" Size="Size.Small" Style="@($"color:{user.FavoriteBadgeColor}")" />
                                         }
                                    }
                                    @(user.Username == currentUser?.Username ? "(Vous)" : "") @user.FirstName @user.Username
                                </div>
                            </MudTd>
                            <MudTd DataLabel="XP Total">@user.TotalXp</MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" RowsPerPageString="Lignes par page:" InfoFormat="{first_item}-{last_item} sur {all_items}" />
                        </PagerContent>
                    </MudTable>
                }
            }
            else if (_selectedSubCategory == "Currency")
            {
                 @if (isLoadingUsersCurrency)
                {
                    <div class="d-flex justify-center pa-4">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    </div>
                }
                else
                {
                    @if (currentUser != null && usersCurrencyLeaderboard.Any(u => u.Username == currentUser.Username))
                    {
                         var rank = usersCurrencyLeaderboard.First(u => u.Username == currentUser.Username);
                         <MudAlert Severity="Severity.Info" Class="ma-4">Votre rang : <strong>#@rank.Rank</strong> (@rank.TotalCurrency @(currentUser?.CurrencyName ?? "Crédits"))</MudAlert>
                    }

                    <MudText Typo="Typo.caption" Class="d-block mt-2 mb-2 pr-4" Align="Align.End">@usersCurrencyLeaderboard.Count joueurs classés</MudText>
                    <MudTable Items="@usersCurrencyLeaderboard" Hover="true" Striped="true" Dense="true" Breakpoint="Breakpoint.None" RowStyleFunc="@RowStyleUser" OnRowClick="OnUserRowClick" T="UserLeaderboardEntryDto" RowClass="cursor-pointer leaderboard-row" Elevation="0">
                        <HeaderContent>
                            <MudTh>Rang</MudTh>
                            <MudTh>Joueur</MudTh>
                            <MudTh>@(currentUser?.CurrencyName ?? "Crédits")</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="user">
                            <MudTd DataLabel="Rang">@RenderRank(user.Rank)</MudTd>
                            <MudTd DataLabel="Joueur">
                                <div class="d-flex align-center">
                                    @if(!string.IsNullOrEmpty(user.FavoriteBadgeIcon) || !string.IsNullOrEmpty(user.FavoriteBadgeImageUrl))
                                    {
                                         @if (!string.IsNullOrEmpty(user.FavoriteBadgeImageUrl))
                                         {
                                             <MudAvatar Size="Size.Small" Class="mr-2">
                                                 <MudImage Src="@GetImageSrc(user.FavoriteBadgeImageUrl)" ObjectFit="ObjectFit.Cover" />
                                             </MudAvatar>
                                         }
                                         else
                                         {
                                             <GamifyIcon IconName="@user.FavoriteBadgeIcon" Class="mr-2" Size="Size.Small" Style="@($"color:{user.FavoriteBadgeColor}")" />
                                         }
                                    }
                                    @(user.Username == currentUser?.Username ? "(Vous)" : "") @user.FirstName @user.Username
                                </div>
                            </MudTd>
                            <MudTd DataLabel="@(currentUser?.CurrencyName ?? "Crédits")">@user.TotalCurrency</MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" RowsPerPageString="Lignes par page:" InfoFormat="{first_item}-{last_item} sur {all_items}" />
                        </PagerContent>
                    </MudTable>
                }
            }
        }
        else if (_selectedCategory == "Groups")
        {
            @if (_selectedSubCategory == "XP")
            {
                 @if (isLoadingGroupsXp)
                {
                    <div class="d-flex justify-center pa-4">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    </div>
                }
                else
                {
                    @if (currentUser != null && currentUser.GroupId.HasValue && groupsXpLeaderboard.Any(g => g.GroupId == currentUser.GroupId.Value))
                    {
                         var rank = groupsXpLeaderboard.First(g => g.GroupId == currentUser.GroupId.Value);
                         <MudAlert Severity="Severity.Info" Class="ma-4">Rang de votre groupe : <strong>#@rank.Rank</strong> (@rank.TotalXp XP)</MudAlert>
                    }

                    <MudText Typo="Typo.caption" Class="d-block mt-2 mb-2 pr-4" Align="Align.End">@groupsXpLeaderboard.Count groupes classés</MudText>
                    <MudTable Items="@groupsXpLeaderboard" Hover="true" Striped="true" Dense="true" Breakpoint="Breakpoint.None" RowStyleFunc="@RowStyleGroup" Elevation="0">
                        <HeaderContent>
                            <MudTh>Rang</MudTh>
                            <MudTh>Groupe</MudTh>
                            <MudTh>XP</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="group">
                            <MudTd DataLabel="Rang">@RenderRank(group.Rank)</MudTd>
                            <MudTd DataLabel="Groupe">
                                <div class="d-flex align-center">
                                    @if (!string.IsNullOrEmpty(group.ImageUrl))
                                    {
                                         <MudAvatar Size="Size.Small" Class="mr-2">
                                             <MudImage Src="@GetImageSrc(group.ImageUrl)" ObjectFit="ObjectFit.Cover" Class="rounded-circle" Style="width:100%;height:100%"/>
                                         </MudAvatar>
                                    }
                                    else
                                    {
                                        <GamifyIcon IconName="@group.IconName" Class="mr-2" Size="Size.Small" Style="@(!string.IsNullOrEmpty(group.Color) ? $"color:{group.Color};" : "")" Color="@(string.IsNullOrEmpty(group.Color) ? Color.Primary : Color.Default)" />
                                    }
                                    <MudText Typo="Typo.body2" Style="@(group.GroupId == currentUser?.GroupId ? "font-weight:bold" : "")">@group.Name @(group.GroupId == currentUser?.GroupId ? "(Votre groupe)" : "")</MudText>
                                </div>
                            </MudTd>
                            <MudTd DataLabel="XP Total">@group.TotalXp</MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" RowsPerPageString="Lignes par page:" InfoFormat="{first_item}-{last_item} sur {all_items}" />
                        </PagerContent>
                    </MudTable>
                }
            }
            else if (_selectedSubCategory == "Members")
            {
                 @if (isLoadingGroupsMembers)
                {
                    <div class="d-flex justify-center pa-4">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    </div>
                }
                else
                {
                    @if (currentUser != null && currentUser.GroupId.HasValue && groupsMembersLeaderboard.Any(g => g.GroupId == currentUser.GroupId.Value))
                    {
                         var rank = groupsMembersLeaderboard.First(g => g.GroupId == currentUser.GroupId.Value);
                         <MudAlert Severity="Severity.Info" Class="ma-4">Rang de votre groupe : <strong>#@rank.Rank</strong> (@rank.MemberCount Membres)</MudAlert>
                    }

                    <MudText Typo="Typo.caption" Class="d-block mt-2 mb-2 pr-4" Align="Align.End">@groupsMembersLeaderboard.Count groupes classés</MudText>
                    <MudTable Items="@groupsMembersLeaderboard" Hover="true" Striped="true" Dense="true" Breakpoint="Breakpoint.None" RowStyleFunc="@RowStyleGroup" Elevation="0">
                        <HeaderContent>
                            <MudTh>Rang</MudTh>
                            <MudTh>Groupe</MudTh>
                            <MudTh>Membres</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="group">
                            <MudTd DataLabel="Rang">@RenderRank(group.Rank)</MudTd>
                            <MudTd DataLabel="Groupe">
                                <div class="d-flex align-center">
                                    @if (!string.IsNullOrEmpty(group.ImageUrl))
                                    {
                                         <MudAvatar Size="Size.Small" Class="mr-2">
                                             <MudImage Src="@GetImageSrc(group.ImageUrl)" ObjectFit="ObjectFit.Cover" Class="rounded-circle" Style="width:100%;height:100%"/>
                                         </MudAvatar>
                                    }
                                    else
                                    {
                                        <GamifyIcon IconName="@group.IconName" Class="mr-2" Size="Size.Small" Style="@(!string.IsNullOrEmpty(group.Color) ? $"color:{group.Color};" : "")" Color="@(string.IsNullOrEmpty(group.Color) ? Color.Primary : Color.Default)" />
                                    }
                                    <MudText Typo="Typo.body2" Style="@(group.GroupId == currentUser?.GroupId ? "font-weight:bold" : "")">@group.Name @(group.GroupId == currentUser?.GroupId ? "(Votre groupe)" : "")</MudText>
                                </div>
                            </MudTd>
                            <MudTd DataLabel="Membres">@group.MemberCount</MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" RowsPerPageString="Lignes par page:" InfoFormat="{first_item}-{last_item} sur {all_items}" />
                        </PagerContent>
                    </MudTable>
                }
            }
        }
    </MudPaper> 

</MudContainer>

<style>
    .leaderboard-row:hover td {
        background-color: var(--mud-palette-action-hover) !important;
        transition: background-color 0.2s;
    }
</style>

@code {
    private string GetImageSrc(string imageUrl)
    {
        if (string.IsNullOrEmpty(imageUrl)) return "";
        return $"{Http.BaseAddress}{imageUrl.TrimStart('/')}?v={Guid.NewGuid()}";
    }

    private List<UserLeaderboardEntryDto> usersXpLeaderboard = new();
    private List<UserLeaderboardEntryDto> usersCurrencyLeaderboard = new();
    private List<GroupLeaderboardEntryDto> groupsXpLeaderboard = new();
    private List<GroupLeaderboardEntryDto> groupsMembersLeaderboard = new();

    private UserProfileDetailsDto? currentUser;
    
    // State for custom tabs
    private string _selectedCategory = "Players"; // "Players" or "Groups"
    private string _selectedSubCategory = "XP";   // "XP", "Currency", "Members"

    private bool isLoadingUsersXp = true;
    private bool isLoadingUsersCurrency = true;
    private bool isLoadingGroupsXp = true;
    private bool isLoadingGroupsMembers = true;
    private bool isLoadingProfile = true;

    private void SetCategory(string category)
    {
        _selectedCategory = category;
        // Default sub-category when switching
        if (_selectedCategory == "Players")
        {
            _selectedSubCategory = "XP";
        }
        else
        {
             _selectedSubCategory = "XP";
        }
        StateHasChanged();
    }

    private void SetSubCategory(string subCategory)
    {
        _selectedSubCategory = subCategory;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        var t0 = LoadProfile();
        var t1 = LoadUsersXp();
        var t2 = LoadUsersCurrency();
        var t3 = LoadGroupsXp();
        var t4 = LoadGroupsMembers();
        await Task.WhenAll(t0, t1, t2, t3, t4);
    }

    private async Task LoadProfile()
    {
         isLoadingProfile = true;
         try
         {
             currentUser = await Http.GetFromJsonAsync<UserProfileDetailsDto>("api/users/profile-details");
         }
         catch (Exception ex)
         {
             Console.WriteLine($"Erreur profile : {ex.Message}");
         }
         finally
         {
             isLoadingProfile = false;
         }
    }

    private async Task LoadUsersXp()
    {
        isLoadingUsersXp = true;
        try
        {
            usersXpLeaderboard = await Http.GetFromJsonAsync<List<UserLeaderboardEntryDto>>("api/leaderboard/users-xp") ?? new();
        }
        catch (Exception ex) { Console.WriteLine($"Erreur users-xp : {ex.Message}"); }
        finally { isLoadingUsersXp = false; }
    }

    private async Task LoadUsersCurrency()
    {
        isLoadingUsersCurrency = true;
        try
        {
            usersCurrencyLeaderboard = await Http.GetFromJsonAsync<List<UserLeaderboardEntryDto>>("api/leaderboard/users-currency") ?? new();
        }
        catch (Exception ex) { Console.WriteLine($"Erreur users-currency : {ex.Message}"); }
        finally { isLoadingUsersCurrency = false; }
    }

    private async Task LoadGroupsXp()
    {
        isLoadingGroupsXp = true;
        try
        {
            groupsXpLeaderboard = await Http.GetFromJsonAsync<List<GroupLeaderboardEntryDto>>("api/leaderboard/groups-xp") ?? new();
        }
        catch (Exception ex) { Console.WriteLine($"Erreur groups-xp : {ex.Message}"); }
        finally { isLoadingGroupsXp = false; }
    }

    private async Task LoadGroupsMembers()
    {
        isLoadingGroupsMembers = true;
        try
        {
            groupsMembersLeaderboard = await Http.GetFromJsonAsync<List<GroupLeaderboardEntryDto>>("api/leaderboard/groups-members") ?? new();
        }
        catch (Exception ex) { Console.WriteLine($"Erreur groups-members : {ex.Message}"); }
        finally { isLoadingGroupsMembers = false; }
    }

    private string RowStyleUser(UserLeaderboardEntryDto user, int index)
    {
        if (currentUser != null && user.Username == currentUser.Username)
        {
            return "background-color: var(--mud-palette-action-selected); font-weight:bold;";
        }
        return "";
    }

    private string RowStyleGroup(GroupLeaderboardEntryDto group, int index)
    {
        if (currentUser != null && currentUser.GroupId.HasValue && group.GroupId == currentUser.GroupId.Value)
        {
            return "background-color: var(--mud-palette-action-selected); font-weight:bold;";
        }
        return "";
    }

    private RenderFragment RenderRank(int rank) => builder =>
    {
        if (rank == 1)
        {
            builder.OpenComponent<MudIcon>(0);
            builder.AddAttribute(1, "Icon", Icons.Material.Filled.EmojiEvents);
            builder.AddAttribute(2, "Color", Color.Warning);
            builder.CloseComponent();
        }
        else if (rank == 2)
        {
            builder.OpenComponent<MudIcon>(0);
            builder.AddAttribute(1, "Icon", Icons.Material.Filled.EmojiEvents);
            builder.AddAttribute(2, "Color", Color.Default); // Silver-ish
            builder.CloseComponent();
        }
        else if (rank == 3)
        {
            builder.OpenComponent<MudIcon>(0);
            builder.AddAttribute(1, "Icon", Icons.Material.Filled.EmojiEvents);
            builder.AddAttribute(2, "Color", Color.Error); // Bronze-ish
            builder.CloseComponent();
        }
        else
        {
            builder.AddContent(0, rank.ToString());
        }
    };

    private async Task OnUserRowClick(TableRowClickEventArgs<UserLeaderboardEntryDto> args)
    {
        // Don't open if it's me? User request didn't specify. Usually clicking yourself is fine.
        await OpenPlayerDetails(args.Item.UserId);
    }

    private async Task OpenPlayerDetails(Guid userId)
    {
        try
        {
            // Show loading or just wait? Better to wait and show dialog instantly or use a loading indicator.
            // Using IDialogService to show loading might be overkill.
            
            var details = await Http.GetFromJsonAsync<PlayerDetailsDto>($"api/users/{userId}/details");
            if (details != null)
            {
                var parameters = new DialogParameters { ["PlayerDetails"] = details };
                var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
                DialogService.Show<PlayerDetailsDialog>("Détails du joueur", parameters, options);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching player details: {ex.Message}");
            Snackbar.Add("Impossible de charger les détails du joueur.", Severity.Error);
        }
    }
}
