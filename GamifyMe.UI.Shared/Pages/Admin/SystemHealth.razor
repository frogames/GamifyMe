@page "/admin/system-health"
@attribute [Authorize(Roles = "SuperAdmin, Admin, Coach, Staff")]

@using MudBlazor
@using GamifyMe.Shared.Dtos
@using GamifyMe.Shared.Models
@using GamifyMe.UI.Shared.Helpers
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Santé du Système</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-16">
    <MudText Typo="Typo.h4" Class="mb-4">Santé du Système</MudText>
    <MudText Typo="Typo.body1" Class="mb-8 text-secondary">Analysez l'équilibre économique et stratégique de votre établissement.</MudText>

    @if (isLoading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else if (healthData == null)
    {
        <MudAlert Severity="Severity.Error">Impossible de charger les données de santé.</MudAlert>
    }
    else
    {
        <!-- Header & Strategy Link -->
        <MudPaper Class="pa-4 mb-8 d-flex justify-space-between align-center" Elevation="2">
            <div>
                 <MudText Typo="Typo.h6">Configuration Actuelle</MudText>
                 <MudText Typo="Typo.body2">Durée du cycle : <b>@healthData.CycleDurationMonths mois</b></MudText>
            </div>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Link="/admin/strategy">Modifier la Stratégie</MudButton>
        </MudPaper>

        <MudGrid>
            <!-- 1. Global Score -->
            <MudItem xs="12" md="4">
                <MudCard Elevation="3" Class="h-100">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Score Global de Santé</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Class="d-flex flex-column align-center justify-center">
                        <div style="position: relative; width: 160px; height: 160px;">
                            <MudProgressCircular Size="Size.Large" StrokeWidth="8" Value="@healthData.RealHealthScore" Color="@GetScoreColor(healthData.RealHealthScore)" Style="width: 100%; height: 100%;" />
                             <div class="d-flex align-center justify-center" style="position: absolute; top:0; left:0; width:100%; height:100%;">
                                <MudText Typo="Typo.h3" Color="@GetScoreColor(healthData.RealHealthScore)">@healthData.RealHealthScore</MudText>
                            </div>
                        </div>
                        <MudText Typo="Typo.caption" Class="mt-2 text-muted text-center">Basé sur l'engagement, l'économie et la progression.</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- 2. Economy Health -->
             <MudItem xs="12" md="4">
                <MudCard Elevation="3" Class="h-100">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Santé Économique</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle2">Inflation (30 jours)</MudText>
                        <MudProgressLinear Value="@(healthData.InflationRate * 50)" Color="@GetInflationColor(healthData.InflationRate)" Height="10" Class="my-2" />
                        <div class="d-flex justify-space-between mb-4">
                            <MudText Typo="Typo.caption">Déflation</MudText>
                            <MudText Typo="Typo.caption" Style="font-weight:bold;">@healthData.InflationRate.ToString("N2")x</MudText>
                            <MudText Typo="Typo.caption">Hyper-Inflation</MudText>
                        </div>

                        <MudText Typo="Typo.subtitle2">Thésaurisation (Argent dormant)</MudText>
                        <MudProgressLinear Value="@(healthData.HoardingRate * 100)" Color="@(healthData.HoardingRate > 0.8 ? Color.Warning : Color.Success)" Height="10" Class="my-2" />
                        <MudText Typo="Typo.caption" Align="Align.End" Class="d-block">@((healthData.HoardingRate * 100).ToString("N0"))% de la masse monétaire</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- 3. Engagement & Pacing -->
             <MudItem xs="12" md="4">
                <MudCard Elevation="3" Class="h-100">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Engagement</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                         <MudText Typo="Typo.subtitle2">Engagement Global (Actifs 30j)</MudText>
                         <MudProgressLinear Value="@healthData.PacingScore" Color="Color.Primary" Height="10" Class="my-2" />
                         <MudText Typo="Typo.caption" Class="mb-4 d-block">@healthData.PacingScore% des utilisateurs</MudText>

                         <MudText Typo="Typo.subtitle2">Social (Dans un groupe)</MudText>
                         <MudProgressLinear Value="@healthData.SocialEngagementScore" Color="Color.Secondary" Height="10" Class="my-2" />
                         <MudText Typo="Typo.caption" Class="mb-4 d-block">@healthData.SocialEngagementScore% des utilisateurs</MudText>
                         
                         <MudText Typo="Typo.subtitle2">Écart Riche/Pauvre (Inégalité)</MudText>
                         <MudText Typo="Typo.h5">@healthData.StatusInequalityScore.ToString("N2")</MudText>
                         <MudText Typo="Typo.caption">Ratio Top 10% / Bottom 90%</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- 4. Detailed Metrics Row -->
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-3 text-center" Elevation="2">
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Richesse Totale Boutique</MudText>
                    <MudText Typo="Typo.h5">@healthData.TotalStoreValue.ToString("N0")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-3 text-center" Elevation="2">
                     <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Richesse Créée (Est)</MudText>
                    <MudText Typo="Typo.h5">@healthData.TotalWealthCreation.ToString("N0")</MudText>
                </MudPaper>
            </MudItem>
             <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-3 text-center" Elevation="2">
                     <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Joueur le + Riche</MudText>
                    <MudText Typo="Typo.h6" Class="text-truncate">@healthData.RichestUserName</MudText>
                    <MudText Typo="Typo.caption">@healthData.RichestUserWealth.ToString("N0")</MudText>
                </MudPaper>
            </MudItem>
             <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-3 text-center" Elevation="2">
                     <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Utilisateurs</MudText>
                    <MudText Typo="Typo.h5">@healthData.UserCount / @(healthData.MaxUsers > 0 ? healthData.MaxUsers : "∞")</MudText>
                </MudPaper>
            </MudItem>


            <!-- 5. Advice / Friction Analysis -->
            <MudItem xs="12">
                <MudPaper Class="pa-6" Elevation="3" Style="border-left: 6px solid var(--mud-palette-info);">
                    <MudText Typo="Typo.h5" GutterBottom="true">Diagnostic & Conseils</MudText>
                    @if (healthData.Advice.Any())
                    {
                        <MudList T="string" Dense="true">
                            @foreach (var advice in healthData.Advice)
                            {
                                <MudListItem Icon="@Icons.Material.Filled.Info" IconColor="Color.Info">
                                    @advice
                                </MudListItem>
                            }
                        </MudList>
                    }
                    else
                    {
                        <MudText>Tout semble en ordre !</MudText>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private SystemHealthDto? healthData;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var response = await Http.GetAsync("api/establishment/health");
            if (response.IsSuccessStatusCode)
            {
                healthData = await response.Content.ReadFromJsonAsync<SystemHealthDto>();
            }
            else
            {
                Snackbar.Add("Impossible de charger les données de santé.", Severity.Error);
                healthData = null;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private Color GetScoreColor(double score)
    {
        if (score >= 80) return Color.Success;
        if (score >= 50) return Color.Warning;
        return Color.Error;
    }

    private Color GetInflationColor(double inflation) {
        if (inflation >= 0.9 && inflation <= 1.1) return Color.Success;
        if (inflation > 1.5 || inflation < 0.5) return Color.Error;
        return Color.Warning;
    }

    private Color GetUserCapacityColor()
    {
        if (healthData == null || healthData.MaxUsers <= 0) return Color.Info;
        double ratio = (double)healthData.UserCount / healthData.MaxUsers;
        if (ratio >= 1.0) return Color.Error;
        if (ratio >= 0.9) return Color.Warning;
        return Color.Success;
    }
}
