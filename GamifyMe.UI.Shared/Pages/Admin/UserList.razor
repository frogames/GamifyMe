@page "/admin/users"
@using GamifyMe.Shared.Dtos
@using GamifyMe.Shared.Models
@attribute [Authorize(Roles = "SuperAdmin,Admin,Coach")]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <MudText Typo="Typo.h4" Class="mb-4">Gestion des Utilisateurs</MudText>

    @if (_users == null)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <MudDataGrid Items="@_users" Filterable="true" SortMode="SortMode.Multiple" Groupable="false" QuickFilter="@FilterFunc">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Utilisateurs</MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog" Class="mr-4">Nouveau</MudButton>
                <MudTextField @bind-Value="_searchString" Placeholder="Rechercher" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            </ToolBarContent>
            <Columns>
                <PropertyColumn Property="x => x.Username" Title="Nom d'utilisateur" />
                <PropertyColumn Property="x => x.Email" Title="Email" />
                <PropertyColumn Property="x => x.Role" Title="Rôle" />
                <PropertyColumn Property="x => x.Status" Title="Statut" />
                <PropertyColumn Property="x => x.CreatedAt" Title="Crée le" Format="dd/MM/yyyy" />
                <PropertyColumn Property="x => x.LastActivityAt" Title="Dernière activité" Format="dd/MM/yyyy HH:mm" />
                <TemplateColumn CellClass="d-flex justify-end">
                    <CellTemplate>
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit" OnClick="@(() => EditUser(context.Item))" />
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => DeleteUser(context.Item))" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="UserSummaryDto" />
            </PagerContent>
        </MudDataGrid>
    }
</MudContainer>

@code {
    private List<UserSummaryDto>? _users;
    private string _searchString;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        try
        {
            _users = await Http.GetFromJsonAsync<List<UserSummaryDto>>("api/users/establishment/users");
        }
        catch (Exception ex)
        {
            Snackbar.Add("Erreur lors du chargement des utilisateurs: " + ex.Message, Severity.Error);
        }
    }

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var dialog = DialogService.Show<GamifyMe.UI.Shared.Pages.Admin.Dialogs.CreateUserDialog>("Créer un utilisateur", options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var newUser = (CreateUserDto)result.Data;
            var response = await Http.PostAsJsonAsync("api/users/establishment/create-user", newUser);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Utilisateur créé", Severity.Success);
                await LoadUsers();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Erreur: {error}", Severity.Error);
            }
        }
    }

    private async Task EditUser(UserSummaryDto user)
    {
        var parameters = new DialogParameters { ["model"] = new UpdateUserAdminDto 
        { 
            FirstName = user.FirstName,
            Username = user.Username,
            Email = user.Email,
            Role = user.Role,
            XpBalance = user.XpBalance,
            CurrencyBalance = user.CurrencyBalance
        }};

        var dialog = DialogService.Show<GamifyMe.UI.Shared.Pages.Admin.Dialogs.EditUserDialog>("Modifier l'utilisateur", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var updatedUser = (UpdateUserAdminDto)result.Data;
            var response = await Http.PutAsJsonAsync($"api/users/establishment/users/{user.Id}", updatedUser);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Utilisateur mis à jour", Severity.Success);
                await LoadUsers();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Erreur: {error}", Severity.Error);
            }
        }
    }

    private async Task DeleteUser(UserSummaryDto user)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Attention", 
            $"Êtes-vous sûr de vouloir supprimer l'utilisateur {user.Username} ? Cette action est irréversible.", 
            yesText:"Supprimer", cancelText:"Annuler");

        if (confirmed == true)
        {
            var response = await Http.DeleteAsync($"api/users/establishment/users/{user.Id}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Utilisateur supprimé", Severity.Success);
                await LoadUsers();
            }
            else 
            {
                 var error = await response.Content.ReadAsStringAsync();
                 Snackbar.Add($"Erreur: {error}", Severity.Error);
            }
        }
    }
    
    private bool FilterFunc(UserSummaryDto element)
    {
        if (string.IsNullOrWhiteSpace(_searchString)) return true;
        if (element.Username.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (element.Email.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (element.FirstName != null && element.FirstName.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (element.Role.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) return true;
        return false;
    }
}
