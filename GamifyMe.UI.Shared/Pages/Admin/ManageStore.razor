@page "/admin/store"
@attribute [Authorize(Roles = "SuperAdmin, Admin, Editeur, Gestionnaire")]

@using MudBlazor
@using GamifyMe.Shared.Dtos
@using GamifyMe.Shared.Models
@using System.Net.Http.Json
@using GamifyMe.UI.Shared.Components
@using GamifyMe.UI.Shared.Helpers

@inject HttpClient Http
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime

<PageTitle>Gestion Boutique</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-16">
    <div class="d-flex justify-space-between align-center mb-4">
        <div>
            <MudText Typo="Typo.h5">Gestion de la Boutique</MudText>
            <MudText Typo="Typo.caption" Class="text-muted">Valeur totale : @allStoreItemsList.Sum(x => x.Price) Crédits</MudText>
        </div>
        @if (!showForm)
        {
            <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Size="Size.Large" OnClick="ShowCreateForm" />
        }
    </div>

    @if (showForm)
    {
        <MudCard Elevation="3" Class="mb-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">@(editingStoreItemId == null ? "Créer un objet" : "Modifier l'objet")</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <EditForm Model="newStoreItem" OnValidSubmit="@(editingStoreItemId == null ? HandleCreateStoreItem : HandleUpdateStoreItem)">
                    <DataAnnotationsValidator />

                    <MudTextField T="string" Label="Nom" @bind-Value="newStoreItem.Name" For="@(() => newStoreItem.Name)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Required="true" />
                    <MudTextField T="string" Label="Description" @bind-Value="newStoreItem.Description" Variant="Variant.Outlined" Lines="2" Margin="Margin.Dense" Class="mb-3" />

                    <MudSelect T="StoreItemType" Label="Type" @bind-Value="newStoreItem.ItemType" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" AnchorOrigin="Origin.BottomCenter">
                        @foreach (StoreItemType type in Enum.GetValues(typeof(StoreItemType)))
                        {
                            <MudSelectItem T="StoreItemType" Value="@type">@type.ToString()</MudSelectItem>
                        }
                    </MudSelect>

                    <div class="d-flex gap-4 mb-3">
                        <MudNumericField T="int" Label="Prix (Crédits)" @bind-Value="newStoreItem.Price" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                        @if (newStoreItem.ItemType != StoreItemType.Digital)
                        {
                            <MudNumericField T="int" Label="Stock" @bind-Value="newStoreItem.Stock" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                        }
                    </div>

                    @if (newStoreItem.ItemType == StoreItemType.Digital)
                    {
                        <MudSelect T="DigitalItemPreset" Label="Objet Numérique" @bind-Value="selectedPreset" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" AnchorOrigin="Origin.BottomCenter">
                            @foreach (var preset in digitalPresets)
                            {
                                <MudSelectItem T="DigitalItemPreset" Value="@preset">@preset.Name</MudSelectItem>
                            }
                        </MudSelect>
                        @if (selectedPreset != null)
                        {
                            <MudText Typo="Typo.caption" Class="d-block mb-3 ml-1">Code : @selectedPreset.Code</MudText>
                        }
                    }

                    @* SÉLECTEUR D'ICÔNE ET COULEUR *@
                    <div class="d-flex justify-center align-center gap-8 mb-4">
                        <div class="d-flex flex-column align-center">
                            <MudTooltip Text="Cliquez pour changer l'icône">
                                <MudBadge Icon="@Icons.Material.Filled.Edit" Color="Color.Secondary" Overlap="true" Bordered="true" Class="cursor-pointer">
                                    <MudPaper Class="d-flex justify-center align-center pa-4" Elevation="4" Width="100px" Height="100px" @onclick="OpenIconPickerForStore">
                                        <MudIcon Icon="@IconLibrary.GetIcon(newStoreItem.IconName)" Style="font-size: 3rem; color: white;" Color="Color.Default" />
                                    </MudPaper>
                                </MudBadge>
                            </MudTooltip>
                            <MudText Typo="Typo.caption" Align="Align.Center" Class="mt-1">Icône : @newStoreItem.IconName</MudText>
                        </div>

                        <div style="width: 200px;">
                            <MudColorPicker Label="Couleur" @bind-Text="newStoreItem.Color" ColorPickerView="ColorPickerView.Palette" Palette="ColorHelper.Palette" Variant="Variant.Outlined" Margin="Margin.Dense" Style="@($"background-color: {(!string.IsNullOrEmpty(newStoreItem.Color) ? newStoreItem.Color : "#FFFFFF")}; color: {ColorHelper.GetContrastColor(newStoreItem.Color ?? "#FFFFFF")}; font-weight: bold;")" Placeholder="Selectionnez une couleur" Required="true" />
                        </div>
                    </div>

                    @* IMAGE DU PRODUIT *@
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Image du produit (facultatif)</MudText>
                    <div class="d-flex align-center gap-4 mb-4">
                        @if (!string.IsNullOrEmpty(newStoreItem.ImageUrl))
                        {
                            <MudImage Src="@newStoreItem.ImageUrl" Alt="Product Image" Elevation="25" Class="rounded-lg" Style="width: 100px; height: 100px; object-fit: cover;" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => newStoreItem.ImageUrl = null)" />
                        }
                        else
                        {
                            <MudFileUpload T="IBrowserFile" Accept=".jpg, .jpeg, .png, .webp" FilesChanged="UploadImage">
                                <ActivatorContent>
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload">
                                        Uploader une image
                                    </MudButton>
                                </ActivatorContent>
                            </MudFileUpload>
                        }
                    </div>

                    @* DATES DE DISPONIBILITÉ *@
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Disponibilité (facultatif)</MudText>
                    <div class="d-flex gap-4 mb-3">
                        <MudDatePicker Label="Date de début" @bind-Date="newStoreItem.StartDate" Editable="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" Clearable="true" />
                        <MudDatePicker Label="Date de fin" @bind-Date="newStoreItem.EndDate" Editable="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" Clearable="true" />
                    </div>

                    <MudCheckBox @bind-Value="newStoreItem.IsUnique" Label="Objet Unique (Achat unique)" Color="Color.Primary" />
                    <MudSwitch T="bool" @bind-Value="newStoreItem.IsActive" Label="Actif" Color="Color.Primary" Class="mb-3" />


                    @if (!string.IsNullOrEmpty(successMessageStore))
                    {
                        <MudAlert Severity="Severity.Success" Class="mb-3">@successMessageStore</MudAlert>
                    }
                    @if (!string.IsNullOrEmpty(errorMessageStore))
                    {
                        <MudAlert Severity="Severity.Error" Class="mb-3">@errorMessageStore</MudAlert>
                    }

                    <MudAlert Severity="@(newStoreItem.IsActive ? Severity.Info : Severity.Warning)" Variant="Variant.Outlined" Class="mb-4" Icon="@Icons.Material.Filled.Info">
                        <MudText Typo="Typo.subtitle2" Style="font-weight:bold; text-decoration:underline;">Résumé du comportement :</MudText>
                        <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@GetStoreItemSummary()</MudText>
                    </MudAlert>

                    <div class="d-flex gap-2">
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Disabled="isBusyStore">
                            @(editingStoreItemId == null ? "Créer" : "Mettre à jour")
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="CancelEditStoreItem" FullWidth="true">Annuler</MudButton>
                    </div>
                </EditForm>
            </MudCardContent>
        </MudCard>
    }
    else
    {
        <MudCard Elevation="3">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Objets existants</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudDropContainer T="StoreItemDto" @ref="_dropContainer" Items="_dropZoneItems" ItemsSelector="@((item,dropzone) => dropzone == "dropzone")" ItemDropped="ItemUpdated" Class="d-flex flex-column">
                    <ChildContent>
                        <MudDropZone T="StoreItemDto" Identifier="dropzone" Class="pa-4" AllowReorder="true" />
                    </ChildContent>
                    <ItemRenderer>
                        <MudPaper Class="d-flex align-center pa-2 mb-2 custom-hover-row" Elevation="0" Style="border-bottom: 1px solid #eee;">
                             <div class="d-flex align-center mr-4 grab-cursor">
                                <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Color="Color.Default" />
                            </div>

                             <!-- Content simulating columns -->
                             <MudGrid Spacing="0" Class="align-center w-100">
                                 <MudItem xs="4">
                                     <div class="d-flex align-center" @onclick="@(() => StartEditStoreItem(context))" style="cursor: pointer;">
                                         <MudIcon Icon="@IconLibrary.GetIcon(context.IconName)" Class="mr-2" Size="Size.Small" Style="@(!string.IsNullOrEmpty(context.Color) ? $"color:{context.Color};" : "")" />
                                         <div class="d-flex flex-column">
                                             <MudText Typo="Typo.body2" Style="font-weight:bold;">@context.Name</MudText>
                                         </div>
                                     </div>
                                 </MudItem>
                                 <MudItem xs="2">
                                     <MudText Typo="Typo.body2">@context.Price Crédits</MudText>
                                     @if (context.ItemType != StoreItemType.Digital && context.Stock > 0)
                                     {
                                         <MudChip T="string" Size="Size.Small" Color="Color.Default">Stock: @context.Stock</MudChip>
                                     }
                                 </MudItem>
                                 <MudItem xs="2">
                                     <MudChip T="string" Size="Size.Small" Color="@(context.ItemType == StoreItemType.Physical ? Color.Primary : Color.Secondary)">@context.ItemType</MudChip>
                                 </MudItem>
                                 <MudItem xs="3">
                                    @if (context.StartDate.HasValue || context.EndDate.HasValue)
                                    {
                                        @if (context.StartDate.HasValue)
                                        {
                                            <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.PlayArrow" Color="Color.Info">@context.StartDate.Value.ToString("dd/MM/yyyy")</MudChip>
                                        }
                                        @if (context.EndDate.HasValue)
                                        {
                                            <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Stop" Color="Color.Warning">@context.EndDate.Value.ToString("dd/MM/yyyy")</MudChip>
                                        }
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success">Toujours</MudChip>
                                    }
                                 </MudItem>
                                 <MudItem xs="1" Class="d-flex justify-end">
                                     <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" OnClick="() => DuplicateStoreItem(context)" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteStoreItem(context)" />
                                 </MudItem>
                             </MudGrid>
                        </MudPaper>
                    </ItemRenderer>
                </MudDropContainer>
            </MudCardContent>
        </MudCard>
    }
</MudContainer>

@code {
    private StoreItemDto newStoreItem = new();
    private List<StoreItemDto> allStoreItemsList = new();
    private Guid? editingStoreItemId = null;
    private List<StoreItemDto> _dropZoneItems = new();
    private MudDropContainer<StoreItemDto>? _dropContainer;

    public class DigitalItemPreset
    {
        public string Name { get; set; } = "";
        public string Code { get; set; } = "";
        public string Url { get; set; } = "";
        
        // Override Equals/GetHashCode for MudSelect to work correctly with objects
        public override bool Equals(object? o)
        {
            var other = o as DigitalItemPreset;
            return other?.Name == Name;
        }
        public override int GetHashCode() => Name.GetHashCode();
    }

    private List<DigitalItemPreset> digitalPresets = new()
    {
        new DigitalItemPreset { Name = "Boost XP x2 (24h)", Code = "XP_BOOST_2X_24H", Url = "xp-boost-2x" },
        new DigitalItemPreset { Name = "Son - Beep 1", Code = "SCAN_SOUND", Url = "/sounds/beep1.mp3" },
        new DigitalItemPreset { Name = "Son - Beep 2", Code = "SCAN_SOUND", Url = "/sounds/beep2.mp3" },
        new DigitalItemPreset { Name = "Son - Beep 3", Code = "SCAN_SOUND", Url = "/sounds/beep3.mp3" },
        new DigitalItemPreset { Name = "Thème - Hiver", Code = "UI_THEME_WINTER", Url = "theme-winter" },
        new DigitalItemPreset { Name = "Thème - Été", Code = "UI_THEME_SUMMER", Url = "theme-summer" },
        new DigitalItemPreset { Name = "Thème - Automne", Code = "UI_THEME_AUTUMN", Url = "theme-autumn" },
        new DigitalItemPreset { Name = "Thème - Printemps", Code = "UI_THEME_SPRING", Url = "theme-spring" },
        new DigitalItemPreset { Name = "Thème - Mode Nuit", Code = "UI_THEME_NIGHT", Url = "theme-night" },
        new DigitalItemPreset { Name = "QR Code - Doré", Code = "QR_STYLE_GOLD", Url = "style-gold" },
        new DigitalItemPreset { Name = "QR Code - Inversé", Code = "QR_STYLE_INVERTED", Url = "style-inverted" }
    };

    private DigitalItemPreset? _selectedPreset;
    private DigitalItemPreset? selectedPreset
    {
        get => _selectedPreset;
        set
        {
            _selectedPreset = value;
            if (_selectedPreset != null)
            {
                newStoreItem.DigitalActionCode = _selectedPreset.Code;
                newStoreItem.DigitalAssetUrl = _selectedPreset.Url;
                
                // Si c'est un boost, ce n'est pas unique par défaut (consommable)
                if (newStoreItem.DigitalActionCode.Contains("BOOST"))
                {
                    newStoreItem.IsUnique = false;
                }

                Console.WriteLine($"[ManageStore] Preset selected - Code: {_selectedPreset.Code}, URL: {_selectedPreset.Url}");
                Console.WriteLine($"[ManageStore] Item updated - DigitalActionCode: {newStoreItem.DigitalActionCode}, DigitalAssetUrl: {newStoreItem.DigitalAssetUrl}");
            }
        }
    }
    
    private string? successMessageStore;
    private string? errorMessageStore;
    private bool isBusyStore = false;
    private bool showForm = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            var items = await Http.GetFromJsonAsync<List<StoreItemDto>>("api/store/list-all") ?? new();
            allStoreItemsList = items.OrderBy(i => i.SortOrder).ToList();
            _dropZoneItems = allStoreItemsList;
            StateHasChanged();
            _dropContainer?.Refresh();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur chargement : {ex.Message}");
        }
    }

    private void ShowCreateForm()
    {
        editingStoreItemId = null;
        newStoreItem = new StoreItemDto();
        newStoreItem.Color = "#FFFFFF"; // Default color
        newStoreItem.IsUnique = true; // Par défaut, tous les objets sont uniques
        selectedPreset = null;
        showForm = true;
    }

    private async Task HandleCreateStoreItem()
    {
        isBusyStore = true;
        successMessageStore = null;
        errorMessageStore = null;
        try
        {
            var response = await Http.PostAsJsonAsync("api/store", newStoreItem);
            if (response.IsSuccessStatusCode)
            {
                successMessageStore = "Objet créé !";
                newStoreItem = new StoreItemDto();
                await LoadData();
                showForm = false;
            }
            else { errorMessageStore = $"Erreur: {await response.Content.ReadAsStringAsync()}"; }
        }
        catch (Exception ex) { errorMessageStore = $"Erreur: {ex.Message}"; }
        finally { isBusyStore = false; }
    }

    private void StartEditStoreItem(StoreItemDto itemToEdit)
    {
        editingStoreItemId = itemToEdit.Id;
        newStoreItem = new StoreItemDto
        {
            Id = itemToEdit.Id,
            Name = itemToEdit.Name,
            Description = itemToEdit.Description,
            Price = itemToEdit.Price,
            IconName = itemToEdit.IconName,
            ItemType = itemToEdit.ItemType,
            DigitalActionCode = itemToEdit.DigitalActionCode,
            Stock = itemToEdit.Stock,
            IsActive = itemToEdit.IsActive,
            StartDate = itemToEdit.StartDate,
            EndDate = itemToEdit.EndDate,
            DigitalAssetUrl = itemToEdit.DigitalAssetUrl,
            IsUnique = itemToEdit.IsUnique,
            ImageUrl = itemToEdit.ImageUrl,
            Color = !string.IsNullOrEmpty(itemToEdit.Color) ? itemToEdit.Color : "#FFFFFF",
            SortOrder = itemToEdit.SortOrder
        };

        if (newStoreItem.ItemType == StoreItemType.Digital)
        {
            _selectedPreset = digitalPresets.FirstOrDefault(p => p.Code == newStoreItem.DigitalActionCode && p.Url == newStoreItem.DigitalAssetUrl);
        }
        else
        {
            _selectedPreset = null;
        }
        showForm = true;
    }

    private void CancelEditStoreItem()
    {
        editingStoreItemId = null;
        newStoreItem = new StoreItemDto();
        selectedPreset = null;
        errorMessageStore = null;
        showForm = false;
    }

    private async Task HandleUpdateStoreItem()
    {
        if (editingStoreItemId == null) return;
        isBusyStore = true;
        try
        {
            var response = await Http.PutAsJsonAsync($"api/store/{editingStoreItemId.Value}", newStoreItem);
            if (response.IsSuccessStatusCode)
            {
                successMessageStore = "Mis à jour !";
                CancelEditStoreItem();
                await LoadData();
            }
            else { errorMessageStore = $"Erreur: {await response.Content.ReadAsStringAsync()}"; }
        }
        catch (Exception ex) { errorMessageStore = ex.Message; }
        finally { isBusyStore = false; }
    }

    private async Task DeleteStoreItem(StoreItemDto itemToDelete)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Supprimer '{itemToDelete.Name}' ?");
        if (!confirmed) return;
        try
        {
            var response = await Http.DeleteAsync($"api/store/{itemToDelete.Id}");
            if (response.IsSuccessStatusCode) await LoadData();
            else errorMessageStore = "Erreur suppression.";
        }
        catch (Exception ex) { errorMessageStore = ex.Message; }
    }

    private async Task DuplicateStoreItem(StoreItemDto itemToDuplicate)
    {
        isBusyStore = true;
        try
        {
            var duplicate = new StoreItemDto
            {
                Name = $"Copie de {itemToDuplicate.Name}",
                Description = itemToDuplicate.Description,
                Price = itemToDuplicate.Price,
                IconName = itemToDuplicate.IconName,
                ItemType = itemToDuplicate.ItemType,
                DigitalActionCode = itemToDuplicate.DigitalActionCode,
                Stock = itemToDuplicate.Stock,
                IsActive = itemToDuplicate.IsActive,
                StartDate = itemToDuplicate.StartDate,
                EndDate = itemToDuplicate.EndDate,
                DigitalAssetUrl = itemToDuplicate.DigitalAssetUrl,
                IsUnique = itemToDuplicate.IsUnique,
                ImageUrl = itemToDuplicate.ImageUrl,
                Color = itemToDuplicate.Color,
                SortOrder = itemToDuplicate.SortOrder
            };

            var response = await Http.PostAsJsonAsync("api/store", duplicate);
            if (response.IsSuccessStatusCode)
            {
                successMessageStore = "Objet dupliqué !";
                await LoadData();
            }
            else { errorMessageStore = $"Erreur duplication: {await response.Content.ReadAsStringAsync()}"; }
        }
        catch (Exception ex) { errorMessageStore = $"Erreur duplication: {ex.Message}"; }
        finally { isBusyStore = false; }
    }

    private async Task OpenIconPickerForStore()
    {
        var options = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<IconPickerDialog>("Choisir une icône", options);
        var result = await dialog.Result;
        if (!result.Canceled && result.Data is string iconName) newStoreItem.IconName = iconName;
    }

    private async Task UploadImage(IBrowserFile file)
    {
        if (file == null) return;

        // Validation client-side
        if (file.Size > 2 * 1024 * 1024)
        {
            errorMessageStore = "L'image est trop lourde (max 2Mo).";
            return;
        }

        var content = new MultipartFormDataContent();
        var fileContent = new StreamContent(file.OpenReadStream(2 * 1024 * 1024));
        fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
        content.Add(fileContent, "file", file.Name);

        isBusyStore = true;
        try
        {
            var response = await Http.PostAsync("api/store/upload-image", content);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ImageUploadResult>();
                if (result != null)
                {
                    newStoreItem.ImageUrl = result.Url;
                    successMessageStore = "Image uploadée !";
                }
            }
            else
            {
                errorMessageStore = $"Erreur upload : {await response.Content.ReadAsStringAsync()}";
            }
        }
        catch (Exception ex)
        {
            errorMessageStore = $"Erreur upload : {ex.Message}";
        }
        finally
        {
            isBusyStore = false;
        }
    }

    public class ImageUploadResult
    {
        public string Url { get; set; }
    }
    
    private async Task ItemUpdated(MudItemDropInfo<StoreItemDto> dropItem)
    {
        _dropZoneItems.Remove(dropItem.Item);
        _dropZoneItems.Insert(dropItem.IndexInZone, dropItem.Item);
        
        var orderedIds = _dropZoneItems.Select(x => x.Id).ToList();
        var reorderDto = new ReorderRequestDto { OrderedIds = orderedIds };
        
        try 
        {
            var response = await Http.PostAsJsonAsync("api/store/reorder", reorderDto);
             if (!response.IsSuccessStatusCode)
             {
                 errorMessageStore = "Erreur lors de la réorganisation.";
                 await LoadData();
             }
        }
        catch (Exception ex)
        {
             errorMessageStore = ex.Message;
        }
    }

    private string GetStoreItemSummary()
    {
        var sb = new System.Text.StringBuilder();

        // 1. Statut Actif
        if (!newStoreItem.IsActive)
        {
            return "⛔ CET OBJET EST INACTIF. Il ne sera visible dans la boutique pour aucun joueur.";
        }

        // 2. Type d'objet
        sb.Append($"🛍️ TYPE : {newStoreItem.ItemType}. ");
        if (newStoreItem.ItemType == StoreItemType.Digital)
        {
            sb.AppendLine("C'est un objet immatériel (boost, thème, son...) activable immédiatement ou depuis l'inventaire.");
            if (!string.IsNullOrEmpty(newStoreItem.DigitalActionCode))
                sb.AppendLine($"   Code Action : {newStoreItem.DigitalActionCode}");
        }
        else
        {
            sb.AppendLine("C'est un objet physique à récupérer auprès du staff.");
        }

        // 3. Stock
        if (newStoreItem.ItemType == StoreItemType.Physical)
        {
            if (newStoreItem.Stock <= 0)
                sb.AppendLine("⚠ RUPTURE : Stock à 0, l'objet apparaîtra comme épuisé.");
            else
                sb.AppendLine($"📦 STOCK : {newStoreItem.Stock} unités disponibles.");
        }
        else
        {
            sb.AppendLine("✨ ILLIMITÉ : Pas de gestion de stock pour les objets numériques.");
        }

        // 4. Unicité
        if (newStoreItem.IsUnique)
        {
            sb.AppendLine("1️⃣ ACHAT UNIQUE : Le joueur ne peut posséder cet objet qu'une seule fois.");
        }
        else
        {
             sb.AppendLine("🔄 CUMULABLE : Le joueur peut acheter cet objet plusieurs fois.");
        }

        // 5. Dates
        if (newStoreItem.StartDate.HasValue || newStoreItem.EndDate.HasValue)
        {
            if (newStoreItem.StartDate.HasValue && newStoreItem.EndDate.HasValue)
                sb.AppendLine($"📅 DISPONIBILITÉ : Du {newStoreItem.StartDate:dd/MM/yyyy} au {newStoreItem.EndDate:dd/MM/yyyy}.");
            else if (newStoreItem.StartDate.HasValue)
                sb.AppendLine($"📅 DISPONIBILITÉ : À partir du {newStoreItem.StartDate:dd/MM/yyyy}.");
            else if (newStoreItem.EndDate.HasValue)
                sb.AppendLine($"📅 DISPONIBILITÉ : Jusqu'au {newStoreItem.EndDate:dd/MM/yyyy}.");
        }
        else
        {
            sb.AppendLine("📅 DISPONIBILITÉ : Toujours disponible (si actif).");
        }

        return sb.ToString();
    }
}

<style>
    .custom-hover-row:hover {
        background-color: rgba(128, 128, 128, 0.1) !important;
    }
    .grab-cursor {
        cursor: grab;
    }
    .grab-cursor:active {
        cursor: grabbing;
    }
</style>
