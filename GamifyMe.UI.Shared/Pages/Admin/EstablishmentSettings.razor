@page "/admin/establishment"
@using GamifyMe.Shared.Dtos
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "SuperAdmin,Admin,Editeur")]
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <MudText Typo="Typo.h4" Class="mb-4">Paramètres de l'établissement</MudText>

    @if (_settings == null)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <MudGrid>
             <MudItem xs="12" md="6">
                <!-- Card 1: Paramètres Généraux -->
                <MudPaper Class="pa-4 mb-4">
                    <MudText Typo="Typo.h6" Class="mb-4">Paramètres Généraux</MudText>
                    
                    <MudTextField @bind-Value="_settings.Name" Label="Nom de l'établissement" Variant="Variant.Outlined" Class="mb-4" />
                    
                    <MudTextField @bind-Value="_settings.CurrencyName" Label="Nom de la monnaie" HelperText="Ex: Crédits, Points..." Variant="Variant.Outlined" Class="mb-4" />
                    
                    <MudButton OnClick="SaveSettings" Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving" Class="mt-2">
                        @(_saving ? "Enregistrement..." : "Enregistrer")
                    </MudButton>
                </MudPaper>
             </MudItem>

             <MudItem xs="12" md="6">
                 <MudPaper Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-4">Modules</MudText>
                    <MudSwitch @bind-Value="_settings.IsShopEnabled" Color="Color.Success" Label="Boutique & Inventaire" />
                    <MudSwitch @bind-Value="_settings.IsGroupsEnabled" Color="Color.Success" Label="Groupes & Classements" />
                    <MudSwitch @bind-Value="_settings.IsChallengesEnabled" Color="Color.Success" Label="Défis (Bientôt)" Disabled="true" />
                    <MudButton OnClick="SaveSettings" Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving" Class="mt-4">
                        @(_saving ? "Enregistrement..." : "Enregistrer")
                    </MudButton>
                 </MudPaper>
             </MudItem>
             
              <!-- Zone de Danger + Cleanup -->
              <MudItem xs="12">
                 <MudPaper Class="pa-4 border-danger">
                      <MudText Typo="Typo.h6" Class="mb-4 text-danger">Zone de Danger</MudText>
                      
                      <MudText Typo="Typo.subtitle1" Class="mb-2">Nettoyage des comptes inactifs</MudText>
                      <div class="d-flex align-center gap-4 mb-4">
                          <MudNumericField @bind-Value="_cleanupDays" Label="Inactif depuis (jours)" Variant="Variant.Outlined" Min="30" Class="flex-grow-0" Style="width: 200px;" />
                          <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="CleanupInactiveUsers">Supprimer les comptes</MudButton>
                      </div>
                      <MudText Typo="Typo.caption" Class="d-block mb-4">Supprime définitivement les utilisateurs n'ayant eu aucune activité depuis le nombre de jours spécifié.</MudText>

                      <MudDivider Class="my-4"/>

                      <MudText Typo="Typo.subtitle1" Class="mb-2">Réinitialisation Globale</MudText>
                      <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="ResetCredits">Remise à zéro des Crédits & XP</MudButton>
                      <MudText Typo="Typo.caption" Class="d-block mt-1">Réinitialise les crédits de TOUS les utilisateurs et l'XP des Groupes à 0. Irréversible.</MudText>
                 </MudPaper>
              </MudItem>

             <MudItem xs="12">
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-4">Kits de contenu</MudText>
                    <MudText Class="mb-4">Ajoutez rapidement du contenu thématique à votre établissement. <MudLink Href="/admin/kits">Voir tout le catalogue</MudLink></MudText>
                    
                    @if (_topKits == null)
                    {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                    }
                    else if (_topKits.Any())
                    {
                        <MudGrid>
                            @foreach (var kit in _topKits)
                            {
                                <MudItem xs="12" sm="6" md="4">
                                    <MudCard Class="h-100">
                                        @if (!string.IsNullOrEmpty(kit.ImageUrl))
                                        {
                                            <MudCardMedia Image="@kit.ImageUrl" Height="140" />
                                        }
                                        <MudCardContent>
                                            <MudText Typo="Typo.h6">@kit.Name</MudText>
                                            <MudText Typo="Typo.body2" Class="text-truncate-3">@kit.Description</MudText>
                                        </MudCardContent>
                                        <MudCardActions>
                                            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => OpenKitDetails(kit))">Détails</MudButton>
                                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Class="ml-auto" OnClick="@(() => ImportKit(kit))">Importer</MudButton>
                                        </MudCardActions>
                                    </MudCard>
                                </MudItem>
                            }
                        </MudGrid>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info">Aucun kit disponible pour le moment.</MudAlert>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private EstablishmentSettingsDto? _settings;
    private List<ContentKitDto>? _topKits;
    private bool _saving = false;

    protected override async Task OnInitializedAsync()
    {
        try 
        {
            var settingsTask = Http.GetFromJsonAsync<EstablishmentSettingsDto>("api/establishment/settings");
            var kitsTask = Http.GetFromJsonAsync<List<ContentKitDto>>("api/kits/top");
            
            await Task.WhenAll(settingsTask, kitsTask);
            
            _settings = await settingsTask;
            _topKits = await kitsTask;
        }
        catch (Exception ex)
        {
            Snackbar.Add("Erreur lors du chargement: " + ex.Message, Severity.Error);
        }
    }

    private async Task SaveSettings()
    {
        _saving = true;
        try
        {
            var response = await Http.PutAsJsonAsync("api/establishment/settings", _settings);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Paramètres enregistrés.", Severity.Success);
            }
            else 
            {
                Snackbar.Add("Erreur lors de l'enregistrement.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Erreur: " + ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ResetCredits()
    {
         var confirmed = await DialogService.ShowMessageBox(
            "Attention", 
            "Êtes-vous sûr de vouloir réinitialiser les crédits de TOUS les utilisateurs à 0 ? Cette action est irréversible.", 
            yesText:"Réinitialiser", cancelText:"Annuler");

        if (confirmed == true)
        {
             var response = await Http.PostAsync("api/establishment/reset-credits", null);
             if (response.IsSuccessStatusCode)
             {
                 Snackbar.Add("Crédits réinitialisés.", Severity.Success);
             }
             else 
             {
                 Snackbar.Add("Erreur lors de la réinitialisation.", Severity.Error);
             }
        }
    }

    [Inject] IDialogService DialogService { get; set; }

    private int _cleanupDays = 365;
    
    private async Task CleanupInactiveUsers()
    {
         var confirmed = await DialogService.ShowMessageBox(
            "Attention - Zone de Danger", 
            $"Voulez-vous vraiment supprimer DÉFINITIVEMENT les utilisateurs inactifs depuis plus de {_cleanupDays} jours ? Cette action est irréversible.", 
            yesText:"Supprimer", cancelText:"Annuler");

        if (confirmed == true)
        {
             try
             {
                 var response = await Http.PostAsync($"api/establishment/cleanup-inactive-users?days={_cleanupDays}", null);
                 if (response.IsSuccessStatusCode)
                 {
                     var msg = await response.Content.ReadAsStringAsync();
                     Snackbar.Add(msg, Severity.Success); // API should return generic message or count
                 }
                 else 
                 {
                     var err = await response.Content.ReadAsStringAsync();
                     Snackbar.Add($"Erreur: {err}", Severity.Error);
                 }
             }
             catch (Exception ex)
             {
                 Snackbar.Add($"Erreur: {ex.Message}", Severity.Error);
             }
        }
    }

    private void OpenKitDetails(ContentKitDto kit)
    {
        var parameters = new DialogParameters { ["KitId"] = kit.Id };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        
        DialogService.Show<GamifyMe.UI.Shared.Pages.Admin.Dialogs.ViewKitDialog>("Détails du Kit", parameters, options);
    }

    private async Task ImportKit(ContentKitDto kit)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Confirmation", 
            $"Voulez-vous vraiment importer le kit '{kit.Name}' ? Les contenus seront ajoutés à votre établissement.", 
            yesText:"Importer", cancelText:"Annuler");

        if (confirmed == true)
        {
            try
            {
               var response = await Http.PostAsync($"api/kits/{kit.Id}/import", null);
               if (response.IsSuccessStatusCode)
               {
                   Snackbar.Add("Kit importé avec succès !", Severity.Success);
               }
               else
               {
                    Snackbar.Add("Erreur lors de l'import.", Severity.Error);
               }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Erreur: {ex.Message}", Severity.Error);
            }
        }
    }
}
