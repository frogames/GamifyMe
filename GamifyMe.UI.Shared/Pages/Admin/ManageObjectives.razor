@page "/admin/objectives"
@attribute [Authorize(Roles = "SuperAdmin, Admin, Coach, Staff")]

@using MudBlazor
@using GamifyMe.Shared.Dtos
@using GamifyMe.Shared.Models
@using System.Net.Http.Json
@using GamifyMe.UI.Shared.Components
@using GamifyMe.UI.Shared.Helpers

@inject HttpClient Http
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime

<PageTitle>Gestion Objectifs</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-16">
    <div class="d-flex justify-space-between align-center mb-4">
        <div>
            <MudText Typo="Typo.h5">Gestion des Objectifs</MudText>
        </div>
        @if (!showForm)
        {
            <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Size="Size.Large" OnClick="ShowCreateForm" />
        }
    </div>

    @if (showForm)
    {
        <MudCard Elevation="3" Class="mb-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">@(editingObjectiveId == null ? "Créer un nouvel objectif" : "Modifier l'objectif")</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
        <EditForm Model="newObjective" OnValidSubmit="@(editingObjectiveId == null ? HandleCreateObjective : HandleUpdateObjective)">
                    <DataAnnotationsValidator />

                    <div class="d-flex align-center gap-4 mb-3" style="background-color: var(--mud-palette-background); padding: 10px; border-radius: 4px; border: 1px solid var(--mud-palette-lines-inputs);">
                        <MudText Typo="Typo.subtitle2" Class="mr-4">Méthodes de Validation :</MudText>
                        
                        <div class="d-flex align-center">
                            <img src="img/validation_icon_staff_scan.png" style="height: 32px; width: auto; margin-right: 4px;" />
                            <MudCheckBox T="bool" Value="true" Disabled="true" Label="Scan par Staff" Color="Color.Primary" Dense="true" />
                        </div>
                        
                        <div class="d-flex align-center">
                            <img src="img/validation_icon_user_scan.png" style="height: 32px; width: auto; margin-right: 4px;" />
                            <MudCheckBox T="bool" Value="@HasValidationMethod(ValidationMethod.QrCode)" ValueChanged="@((v) => ToggleValidationMethod(ValidationMethod.QrCode, v))" Label="QR Code" Color="Color.Secondary" Dense="true" />
                        </div>
                        
                        <div class="d-flex align-center">
                            <img src="img/validation_icon_user_auto.png" style="height: 32px; width: auto; margin-right: 4px;" />
                            <MudCheckBox T="bool" Value="@HasValidationMethod(ValidationMethod.Self)" ValueChanged="@((v) => ToggleValidationMethod(ValidationMethod.Self, v))" Label="Auto-validation" Color="Color.Warning" Dense="true" />
                        </div>

                        <div class="d-flex align-center ml-4">
                            <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Medium" Class="mr-1" Color="Color.Info" />
                            <MudCheckBox T="bool" Value="@HasValidationMethod(ValidationMethod.PeerDuo)" ValueChanged="@((v) => ToggleValidationMethod(ValidationMethod.PeerDuo, v))" Label="Duo (Entraide)" Color="Color.Info" Dense="true" />
                        </div>

                        <div class="d-flex align-center ml-4">
                            <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Medium" Class="mr-1" Color="Color.Success" />
                            <MudCheckBox T="bool" Value="@HasValidationMethod(ValidationMethod.PeerCrowd)" ValueChanged="@((v) => ToggleValidationMethod(ValidationMethod.PeerCrowd, v))" Label="Foule (Crowd)" Color="Color.Success" Dense="true" />
                        </div>

                        @if (editingObjectiveId != null && HasValidationMethod(ValidationMethod.QrCode))
                        {
                             <MudButton StartIcon="@Icons.Material.Filled.Download" Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" OnClick="DownloadQrCode" Class="ml-auto">Télécharger QR</MudButton>
                        }
                    </div>

                    @if (HasValidationMethod(ValidationMethod.PeerCrowd))
                    {
                        <div class="mb-3">
                             <MudTextField T="int?" Label="Nombre de signatures requises (Foule)" @bind-Value="newObjective.RequiredPeerValidations" HelperText="Combien de personnes doivent scanner le QR code ?" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" />
                        </div>
                    }

                    <MudTextField T="string" Label="Titre" @bind-Value="newObjective.Title" For="@(() => newObjective.Title)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Required="true" />
                    <MudTextField T="string" Label="Description" @bind-Value="newObjective.Description" For="@(() => newObjective.Description)" Variant="Variant.Outlined" Lines="3" Margin="Margin.Dense" Class="mb-3" />

                    <div class="d-flex gap-4 mb-3">
                        <MudTextField T="int" Label="Récompense XP" @bind-Value="newObjective.XpReward" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" Required="true" />
                        <MudTextField T="int" Label="@($"Récompense {CurrencyName}")" @bind-Value="newObjective.DocPointsReward" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" Required="true" />
                    </div>

                    <MudSelect T="ObjectiveCategory" Label="Catégorie" @bind-Value="newObjective.Category" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Disabled="@IsCategoryAutomatic" Required="true" >
                        @foreach (ObjectiveCategory cat in Enum.GetValues(typeof(ObjectiveCategory)))
                        {
                            if (cat != ObjectiveCategory.Rechargement)
                            {
                                <MudSelectItem Value="@cat">@cat</MudSelectItem>
                            }
                        }
                    </MudSelect>


                    
                    @if (newObjective.Category == ObjectiveCategory.Onboarding)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Info" Class="mb-3 d-block">Utilisez les prérequis ci-dessous pour définir l'ordre du parcours d'onboarding.</MudText>
                    }

                    @* SÉLECTEUR D'ICÔNE ET COULEUR *@
                    <div class="d-flex justify-center align-center gap-8 mb-4">
                        <div class="d-flex flex-column align-center">
                            <MudTooltip Text="Cliquez pour changer l'icône">
                                <MudBadge Icon="@Icons.Material.Filled.Edit" Color="Color.Secondary" Overlap="true" Bordered="true" Class="cursor-pointer">
                                    <MudPaper Class="d-flex justify-center align-center pa-4" Elevation="4" Width="100px" Height="100px" @onclick="OpenIconPickerForObjective" Style="@($"background-color: {newObjective.Color};")">
                                        <GamifyIcon IconName="@newObjective.IconName" Style="@($"font-size: 3rem; color: {ColorHelper.GetContrastColor(newObjective.Color ?? "#FFFFFF")};")" />
                                    </MudPaper>
                                </MudBadge>
                            </MudTooltip>
                            <MudText Typo="Typo.caption" Align="Align.Center" Class="mt-1">Icône : @newObjective.IconName</MudText>
                        </div>

                        <div style="width: 200px;">
                            <MudColorPicker Label="Couleur" @bind-Text="newObjective.Color" ColorPickerView="ColorPickerView.Palette" Palette="ColorHelper.Palette" Variant="Variant.Outlined" Margin="Margin.Dense" Style="@($"background-color: {(!string.IsNullOrEmpty(newObjective.Color) ? newObjective.Color : "#FFFFFF")}; color: {ColorHelper.GetContrastColor(newObjective.Color ?? "#FFFFFF")}; font-weight: bold;")" Placeholder="Selectionnez une couleur" Required="true" />
                        </div>
                    </div>

                    <MudTextField T="string" Label="Lieu" @bind-Value="newObjective.Location" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />

                    <div class="d-flex gap-4 mb-3 align-center">
                        <MudDatePicker Label="Date Événement" @bind-Date="newObjective.EventDate" Editable="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                        <MudField Label="Heure" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width: 120px; padding-top: 10px;">
                            <input type="time" value="@(eventTime?.ToString(@"hh\:mm"))" @onchange="@((ChangeEventArgs e) => eventTime = string.IsNullOrEmpty(e.Value?.ToString()) ? null : TimeSpan.Parse(e.Value.ToString()))" style="width:100%; border:none; outline:none; background:transparent;" />
                        </MudField>
                    </div>

                    <div class="d-flex gap-4 mb-3 align-center">
                        <MudDatePicker Label="Date Fin" @bind-Date="newObjective.EndDate" Editable="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                        <MudField Label="Heure" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width: 120px; padding-top: 10px;">
                            <input type="time" value="@(endTime?.ToString(@"hh\:mm"))" @onchange="@((ChangeEventArgs e) => endTime = string.IsNullOrEmpty(e.Value?.ToString()) ? null : TimeSpan.Parse(e.Value.ToString()))" style="width:100%; border:none; outline:none; background:transparent;" />
                        </MudField>
                    </div>

                    <div class="d-flex gap-4 mb-3 align-center">
                        <MudDatePicker Label="Affichage : Début" @bind-Date="newObjective.DisplayStartDate" Editable="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" HelperText="Date à partir de laquelle l'objectif est visible" />
                        <MudDatePicker Label="Affichage : Fin" @bind-Date="newObjective.DisplayEndDate" Editable="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" HelperText="Date après laquelle l'objectif disparaît" />
                    </div>

                    @if (newObjective.Category != ObjectiveCategory.Onboarding && newObjective.Category != ObjectiveCategory.Evenement)
                    {
                        <MudTextField T="int?" Label="Durée de vie (Heures)" @bind-Value="newObjective.LifespanHours" HelperText="Temps avant autodestruction (optionnel)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                    }

                    <MudText Typo="Typo.subtitle2" Class="mt-2">Prérequis (facultatif)</MudText>
                    <MudSelect T="Guid?" Label="Choisir un prérequis" @bind-Value="selectedPrerequisiteId" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-3">
                        @foreach (var objective in allObjectivesList.Where(o => o.Id != editingObjectiveId))
                        {
                            <MudSelectItem Value="@((Guid?)objective.Id)">@objective.Title</MudSelectItem>
                        }
                    </MudSelect>



                    <MudSwitch T="bool" @bind-Value="newObjective.IsUnique" Label="Objectif unique" Color="Color.Primary" Class="mb-2" />
                    @if (!newObjective.IsUnique)
                    {
                        <MudTextField T="int?" Label="Fréquence (Heures)" @bind-Value="newObjective.FrequencyHours" HelperText="Délai minimum entre deux validations (en heures)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                         
                        <div class="d-flex align-center gap-4 mb-3" style="background-color: var(--mud-palette-background); padding: 10px; border-radius: 4px;">
                            <MudSwitch T="bool" @bind-Value="newObjective.IsStreakEnabled" Label="Activer les Séries (Streaks)" Color="Color.Warning" />
                            @if (newObjective.IsStreakEnabled)
                            {
                                <div class="d-flex gap-4 mb-2 flex-wrap">
                                    <MudSelect T="StreakFrequency" Label="Fréquence de la Série" @bind-Value="newObjective.StreakFrequency" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 300px;">
                                        <MudSelectItem Value="StreakFrequency.Hourly">Par Heure</MudSelectItem>
                                        <MudSelectItem Value="StreakFrequency.Daily">Quotidien (Jours)</MudSelectItem>
                                        <MudSelectItem Value="StreakFrequency.Weekly">Hebdomadaire</MudSelectItem>
                                        <MudSelectItem Value="StreakFrequency.Monthly">Mensuel</MudSelectItem>
                                    </MudSelect>

                                    @if (newObjective.StreakFrequency == StreakFrequency.Hourly)
                                    {
                                        <MudTextField T="int?" Label="Délai max (Heures)" @bind-Value="newObjective.StreakTerminalHours" HelperText="Temps max entre 2 validations" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                                    }
                                </div>

                                @if (newObjective.StreakFrequency == StreakFrequency.Daily)
                                {
                                    <MudText Typo="Typo.caption" Class="mb-1 d-block">Jours EXCLUS (la série ne cassera pas ces jours-là) :</MudText>
                                    <div class="d-flex gap-2 flex-wrap mb-2">
                                        @foreach (var day in Enum.GetValues(typeof(DayOfWeek)).Cast<DayOfWeek>())
                                        {
                                            var isChecked = IsDayExcluded(day);
                                            <MudCheckBox T="bool" Value="@isChecked" ValueChanged="@((v) => ToggleDayExclusion(day, v))" Label="@ToFrenchDay(day)" Dense="true" Color="Color.Primary" Size="Size.Small" />
                                        }
                                    </div>
                                }

                                @if (newObjective.StreakFrequency == StreakFrequency.Monthly)
                                {
                                    <MudText Typo="Typo.caption" Class="mb-1 d-block">Mois EXCLUS (vacances, etc) :</MudText>
                                    <div class="d-flex gap-2 flex-wrap mb-2">
                                        @for (int m = 1; m <= 12; m++)
                                        {
                                            int month = m;
                                            var isChecked = IsMonthExcluded(month);
                                            <MudCheckBox T="bool" Value="@isChecked" ValueChanged="@((v) => ToggleMonthExclusion(month, v))" Label="@ToFrenchMonth(month)" Dense="true" Color="Color.Primary" Size="Size.Small" />
                                        }
                                    </div>
                                }
                            }
                        </div>
                    }






                    <MudSwitch T="bool" @bind-Value="newObjective.IsActive" Label="Actif" Color="Color.Primary" Class="mb-3" />

                    @if (!string.IsNullOrEmpty(successMessageObjective))
                    {
                        <MudAlert Severity="Severity.Success" Class="mb-3">@successMessageObjective</MudAlert>
                    }
                    @if (!string.IsNullOrEmpty(errorMessageObjective))
                    {
                        <MudAlert Severity="Severity.Error" Class="mb-3">@errorMessageObjective</MudAlert>
                    }

                    <MudAlert Severity="@(newObjective.IsActive ? Severity.Info : Severity.Warning)" Variant="Variant.Outlined" Class="mb-4" Icon="@Icons.Material.Filled.Info">
                        <MudText Typo="Typo.subtitle2" Style="font-weight:bold; text-decoration:underline;">Résumé du comportement :</MudText>
                        <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@GetObjectiveSummary()</MudText>
                    </MudAlert>

                    <div class="d-flex gap-2">
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Disabled="isBusyObjective">
                            @(editingObjectiveId == null ? "Créer" : "Mettre à jour")
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="CancelEditObjective" FullWidth="true">Annuler</MudButton>
                    </div>
                </EditForm>
            </MudCardContent>
        </MudCard>
    }
    else
    {
        <MudCard Elevation="3">
            <MudCardHeader>
                <CardHeaderContent>
                    <div class="d-flex align-center justify-space-between w-100">
                        <MudText Typo="Typo.h6">Objectifs existants</MudText>
                        <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Calculate" OnClick="ShowWealthEstimation">Estimation Richesse</MudButton>
                    </div>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                @if (_dropZoneItems.Any())
                {
                    <div class="d-flex align-center gap-4 mb-4 pa-2 rounded mud-background-gray border-all border-solid border-1">
                        <MudCheckBox T="bool" Label="Tout sélectionner" Value="@(selectedIds.Count > 0 && selectedIds.Count == _dropZoneItems.Count)" ValueChanged="ToggleSelectAll" Color="Color.Primary" />
                        <MudSpacer />
                        @if (selectedIds.Any())
                        {
                            <MudButton StartIcon="@Icons.Material.Filled.ContentCopy" Color="Color.Primary" Variant="Variant.Filled" OnClick="DuplicateSelected" Class="mr-2">Dupliquer (@selectedIds.Count)</MudButton>
                            <MudButton StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error" Variant="Variant.Filled" OnClick="DeleteSelected">Supprimer (@selectedIds.Count)</MudButton>
                        }
                    </div>
                }

                @foreach (var categoryGroup in _dropZoneItems.GroupBy(x => x.Category).OrderBy(g => g.Key))
                {
                    <div class="mb-6">
                        <MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-2 border-b-2 pb-1">@categoryGroup.Key</MudText>
                        
                        <div class="d-flex flex-column">
                            @foreach (var context in categoryGroup)
                            {
                                <MudPaper @key="context.Id" Class="d-flex align-center pa-2 mb-2 custom-hover-row" Elevation="0" Style="@($"border-bottom: 1px solid var(--mud-palette-table-lines); {(context.IsActive ? "" : "opacity: 0.5; background-color: rgba(0,0,0,0.05);")}")">
                                    <MudCheckBox T="bool" Value="@selectedIds.Contains(context.Id)" ValueChanged="@((v) => ToggleSelect(context.Id, v))" Color="Color.Primary" Class="mr-2" />
                                    
                                    <div class="d-flex flex-column mr-2">
                                        @{
                                            var list = categoryGroup.ToList();
                                            var index = list.IndexOf(context);
                                            var isFirst = index == 0;
                                            var isLast = index == list.Count - 1;
                                        }
                                        <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp" Size="Size.Small" OnClick="@(() => MoveUp(context))" Disabled="@isFirst" />
                                        <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" OnClick="@(() => MoveDown(context))" Disabled="@isLast" />
                                    </div>

                                    <div style="width: 100%;">
                                        <MudGrid Spacing="0" Class="align-center w-100">
                                            <MudItem xs="4">
                                                <div class="d-flex align-center" @onclick="@(() => StartEditObjective(context))" style="cursor: pointer;">
                                                    <MudAvatar Color="@(string.IsNullOrEmpty(context.Color) ? Color.Primary : Color.Default)" Variant="Variant.Filled" Size="Size.Small" Class="mr-2" Style="@(!string.IsNullOrEmpty(context.Color) ? $"background-color:{context.Color};" : "")">
                                                        <GamifyIcon IconName="@context.IconName" Size="Size.Small" Style="@($"color: {ColorHelper.GetContrastColor(context.Color ?? "#FFFFFF")};")" />
                                                    </MudAvatar>
                                                    <div class="d-flex flex-column">
                                                        <MudText Typo="Typo.body2" Style="font-weight:bold;">@context.Title</MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Category</MudText>
                                                    </div>
                                                    @if (context.Category == ObjectiveCategory.Onboarding)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.School" Class="ml-2">Onboarding</MudChip>
                                                    }
                                                    @if (!context.IsActive)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" Class="ml-2">Inactif</MudChip>
                                                    }
                                                </div>
                                            </MudItem>
                                            <MudItem xs="2">
                                                <MudText Typo="Typo.body2">@context.Location</MudText>
                                            </MudItem>
                                            <MudItem xs="3">
                                                 @if (context.EventDate.HasValue)
                                                {
                                                    <div class="mb-1"><MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Event" Color="Color.Primary">@context.EventDate.Value.ToString("dd/MM/yyyy HH:mm")</MudChip></div>
                                                }
                                            </MudItem>
                                            <MudItem xs="3">
                                                <div class="d-flex gap-1">
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">@context.XpReward XP</MudChip>
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Success">@context.DocPointsReward @CurrencyName</MudChip>
                                                </div>
                                            </MudItem>
                                        </MudGrid>
                                    </div>
                                </MudPaper>
                            }
                        </div>
                    </div>
                }
            </MudCardContent>
        </MudCard>
    }
</MudContainer>

<ScanValidationModal @ref="scanModal" OnScanSuccessRefresh="LoadData" />

@code {
    private bool showForm = false;
    private Guid? editingObjectiveId;
    private CreateObjectiveDto newObjective = new();
    private List<ObjectiveSimpleDto> allObjectivesList = new();
    private List<ObjectiveDto> allObjectivesFullList = new();
    private bool isBusyObjective = false;
    private string? successMessageObjective;
    private string? errorMessageObjective;
    private TimeSpan? eventTime;
    private TimeSpan? endTime;
    private Guid? selectedPrerequisiteId;
    private string CurrencyName = "Crédits";
    
    private HashSet<Guid> selectedIds = new();
    private List<ObjectiveDto> _dropZoneItems = new();
    
    private ScanValidationModal scanModal = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            var objectivesTask = Http.GetFromJsonAsync<List<ObjectiveSimpleDto>>("api/objectives/list-all");
            var objectivesFullTask = Http.GetFromJsonAsync<List<ObjectiveDto>>("api/objectives/list-all-full");
            await Task.WhenAll(objectivesTask, objectivesFullTask);
            allObjectivesList = objectivesTask.Result ?? new();
            allObjectivesFullList = objectivesFullTask.Result ?? new();
            
            // Sort by Category then SortOrder for the view
            _dropZoneItems = allObjectivesFullList
                .OrderBy(o => o.Category)
                .ThenBy(o => o.SortOrder)
                .ToList();
            
            // Allow failure for this one, non-critical
            try 
            {
                var profile = await Http.GetFromJsonAsync<UserProfileDetailsDto>("api/users/profile-details");
                if (profile != null) CurrencyName = profile.CurrencyName ?? "Crédits";
            }
            catch {}

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur chargement : {ex.Message}");
        }
    }

    private void ToggleSelect(Guid id, bool selected)
    {
        if (selected) selectedIds.Add(id);
        else selectedIds.Remove(id);
    }

    private void ToggleSelectAll(bool selected)
    {
        if (selected) selectedIds = new HashSet<Guid>(_dropZoneItems.Select(i => i.Id));
        else selectedIds.Clear();
    }

    private async Task MoveUp(ObjectiveDto item)
    {
        // Find the sub-list for this category
        var categoryList = _dropZoneItems.Where(x => x.Category == item.Category).OrderBy(x => x.SortOrder).ToList();
        var index = categoryList.IndexOf(item);
        
        if (index > 0)
        {
            var other = categoryList[index - 1];
            // Swap SortOrders locally to reflect in UI immediately (if we re-sort by SortOrder)
            // But we are using _dropZoneItems which is the master list.
            
            // Swap locally
            var tempOrder = item.SortOrder;
            item.SortOrder = other.SortOrder;
            other.SortOrder = tempOrder;
            
            // Re-sort the master list to reflect changes
            _dropZoneItems = _dropZoneItems.OrderBy(o => o.Category).ThenBy(o => o.SortOrder).ToList();
            
            // Save
            await SaveOrder();
        }
    }

    private async Task MoveDown(ObjectiveDto item)
    {
        // Find the sub-list for this category
        var categoryList = _dropZoneItems.Where(x => x.Category == item.Category).OrderBy(x => x.SortOrder).ToList();
        var index = categoryList.IndexOf(item);
        
        if (index < categoryList.Count - 1)
        {
            var other = categoryList[index + 1];
            
            // Swap locally
            var tempOrder = item.SortOrder;
            item.SortOrder = other.SortOrder;
            other.SortOrder = tempOrder;
            
             // Re-sort the master list to reflect changes
            _dropZoneItems = _dropZoneItems.OrderBy(o => o.Category).ThenBy(o => o.SortOrder).ToList();

            await SaveOrder();
        }
    }

    private async Task SaveOrder()
    {
        // We construct a full ordered list where we respect Category grouping first, then the local SortOrder
        // Actually, the simplest way to persist "visual order" is to send the IDs in the order they appear in the list.
        // Our controller will assign SortOrder = Index.
        // So we need to make sure _dropZoneItems is correctly sorted before sending.
        // The View iterates: groupBy(Category).orderBy(Key) -> then items inside are implicitely standard list order.
        
        // Let's rebuilding the flat sorted list based on the visual grouping
        var flatSortedIds = new List<Guid>();
        
        var groups = _dropZoneItems.GroupBy(x => x.Category).OrderBy(g => g.Key);
        foreach (var group in groups)
        {
            // Inside the group, we rely on the SortOrder we just swapped or existing order
            foreach (var item in group.OrderBy(x => x.SortOrder))
            {
                flatSortedIds.Add(item.Id);
            }
        }
        
        var reorderDto = new ReorderRequestDto { OrderedIds = flatSortedIds };
        
        try 
        {
            var response = await Http.PostAsJsonAsync("api/objectives/reorder", reorderDto);
            if (!response.IsSuccessStatusCode)
            {
                errorMessageObjective = "Erreur lors de la réorganisation.";
                await LoadData(); // Revert
            }
        }
        catch (Exception ex)
        {
             errorMessageObjective = ex.Message;
        }
    }

    private async Task DeleteSelected()
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Supprimer les {selectedIds.Count} objectifs sélectionnés ?");
        if (!confirmed) return;
        
        isBusyObjective = true;
        try 
        {
            foreach (var id in selectedIds.ToList())
            {
                var response = await Http.DeleteAsync($"api/objectives/{id}");
                if (!response.IsSuccessStatusCode)
                {
                    errorMessageObjective = $"Erreur lors de la suppression de l'ID {id}";
                }
            }
            selectedIds.Clear();
            await LoadData();
        }
        catch (Exception ex) { errorMessageObjective = ex.Message; }
        finally { isBusyObjective = false; }
    }

    private async Task DuplicateSelected()
    {
        isBusyObjective = true;
        try 
        {
            foreach (var id in selectedIds.ToList())
            {
                var item = allObjectivesFullList.FirstOrDefault(o => o.Id == id);
                if (item != null)
                {
                    await DuplicateObjectiveInternal(item);
                }
            }
            selectedIds.Clear();
            await LoadData();
        }
        catch (Exception ex) { errorMessageObjective = ex.Message; }
        finally { isBusyObjective = false; }
    }

