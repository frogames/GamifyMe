    private string GetObjectiveSummary()
    {
        var sb = new System.Text.StringBuilder();

        // 1. Statut Actif
        if (!newObjective.IsActive)
        {
            return "⛔ CET OBJECTIF EST INACTIF. Il ne sera visible pour aucun joueur, même si toutes les autres conditions sont remplies.";
        }

        // 1.5. Description Catégorie
        switch (newObjective.Category)
        {
            case ObjectiveCategory.Principal:
                sb.AppendLine($"⭐ CATÉGORIE ({newObjective.Category}) : Objectif majeur, mis en avant dans l'interface.");
                break;
            case ObjectiveCategory.Secondaire:
                sb.AppendLine($"📝 CATÉGORIE ({newObjective.Category}) : Objectif standard, enrichit l'expérience quotidienne.");
                break;
            case ObjectiveCategory.Evenement:
                sb.AppendLine($"🎉 CATÉGORIE ({newObjective.Category}) : Objectif ponctuel lié à un événement, avec une priorité d'affichage élevée.");
                break;
            case ObjectiveCategory.Onboarding:
                sb.AppendLine($"🎓 CATÉGORIE ({newObjective.Category}) : Étape du parcours d'intégration des nouveaux joueurs.");
                break;
        }

        // 2. Prérequis
        if (selectedPrerequisiteId.HasValue)
        {
            var pre = allObjectivesList.FirstOrDefault(o => o.Id == selectedPrerequisiteId.Value);
            if (pre != null)
            {
                sb.AppendLine($"🔒 VERROUILLÉ : Cet objectif n'apparaîtra QUE lorsque le joueur aura validé l'objectif \"{pre.Title}\".");
            }
        }
        else
        {
             if (newObjective.Category == ObjectiveCategory.Onboarding)
                sb.AppendLine("🏁 DÉPART : Accessible dès le début du parcours d'intégration.");
             else
                sb.AppendLine("🔓 DÉVERROUILLÉ : Accessible par défaut (si les dates correspondent).");
        }

        // 3. Dates d'affichage
        if (newObjective.DisplayStartDate.HasValue || newObjective.DisplayEndDate.HasValue)
        {
            if (newObjective.DisplayStartDate.HasValue && newObjective.DisplayEndDate.HasValue)
                sb.AppendLine($"📅 VISIBILITÉ : Visible uniquement du {newObjective.DisplayStartDate:dd/MM/yyyy HH:mm} au {newObjective.DisplayEndDate:dd/MM/yyyy HH:mm}.");
            else if (newObjective.DisplayStartDate.HasValue)
                sb.AppendLine($"📅 VISIBILITÉ : Visible à partir du {newObjective.DisplayStartDate:dd/MM/yyyy HH:mm}.");
            else if (newObjective.DisplayEndDate.HasValue)
                sb.AppendLine($"📅 VISIBILITÉ : Visible jusqu'au {newObjective.DisplayEndDate:dd/MM/yyyy HH:mm}, puis disparaît.");
        }


        // 4. Durée de vie (Chrono)
        if (newObjective.LifespanHours.HasValue && newObjective.Category != ObjectiveCategory.Onboarding && newObjective.Category != ObjectiveCategory.Evenement)
        {
             sb.AppendLine($"⏳ COMPTE À REBOURS : Une fois apparu dans la liste du joueur, il a {newObjective.LifespanHours} heures pour le valider avant qu'il ne disparaisse définitivement.");
        }

        // 5. Répétition et Fréquence
        if (newObjective.IsUnique)
        {
            sb.Append("✅ VALIDATION UNIQUE : Cet objectif ne peut être accompli qu'une seule fois.");
        }
        else
        {
            sb.Append("🔄 RÉPÉTABLE : Le joueur peut valider cet objectif plusieurs fois. Le compteur de validations sera affiché au joueur.");
            if (newObjective.FrequencyHours.HasValue && newObjective.FrequencyHours > 0)
                sb.Append($" Un délai d'attente de {newObjective.FrequencyHours} heures est imposé entre chaque validation.");
            else
                sb.Append(" Aucune limite de temps entre deux validations.");

            if (newObjective.IsStreakEnabled)
            {
                sb.Append(" 🔥 SÉRIE ACTIVÉE : ");
                switch(newObjective.StreakFrequency) {
                    case StreakFrequency.Hourly: 
                        sb.Append("Validation requise HEURE PAR HEURE."); 
                        if (newObjective.StreakTerminalHours.HasValue) sb.Append($" (Délai max: {newObjective.StreakTerminalHours}h)."); 
                        break;
                    case StreakFrequency.Daily: sb.Append("Validation requise CHAQUE JOUR."); break;
                    case StreakFrequency.Weekly: sb.Append("Validation requise CHAQUE SEMAINE."); break;
                    case StreakFrequency.Monthly: sb.Append("Validation requise CHAQUE MOIS."); break;
                }
                sb.Append(" Une série sera maintenue.");
            }
        }
        sb.AppendLine(); 

        // 6. Méthodes de Validation
        sb.Append("🛡️ MÉTHODES DE VALIDATION : ");
        var methods = new List<string>();
        if (newObjective.AllowedValidationMethods.HasFlag(ValidationMethod.StaffScan)) methods.Add("Scan Staff");
        if (newObjective.AllowedValidationMethods.HasFlag(ValidationMethod.QrCode)) methods.Add("QR Code");
        if (newObjective.AllowedValidationMethods.HasFlag(ValidationMethod.Self)) methods.Add("Auto-validation");
        if (newObjective.AllowedValidationMethods.HasFlag(ValidationMethod.PeerDuo)) methods.Add("Validation Duo (Pair)");
        if (newObjective.AllowedValidationMethods.HasFlag(ValidationMethod.PeerCrowd)) methods.Add($"Validation Foule ({newObjective.RequiredPeerValidations ?? 1} signatures)");
        
        if (methods.Any())
            sb.Append(string.Join(" OU ", methods) + ".");
        else
            sb.Append("Aucune méthode sélectionnée (Attention !).");

        return sb.ToString();
    }
    
    // UI Helpers for Checkboxes
    private bool IsDayExcluded(DayOfWeek day)
    {
        if (string.IsNullOrEmpty(newObjective.StreakExcludedDays)) return false;
        var parts = newObjective.StreakExcludedDays.Split(',');
        return parts.Contains(((int)day).ToString());
    }
    
    private void ToggleDayExclusion(DayOfWeek day, bool isChecked)
    {
        var current = new HashSet<string>(string.IsNullOrEmpty(newObjective.StreakExcludedDays) ? Array.Empty<string>() : newObjective.StreakExcludedDays.Split(','));
        string val = ((int)day).ToString();
        if (isChecked) current.Add(val);
        else current.Remove(val);
        newObjective.StreakExcludedDays = string.Join(",", current.Where(s => !string.IsNullOrEmpty(s)));
    }

    private bool IsMonthExcluded(int month)
    {
        if (string.IsNullOrEmpty(newObjective.StreakExcludedMonths)) return false;
        var parts = newObjective.StreakExcludedMonths.Split(',');
        return parts.Contains(month.ToString());
    }

    private void ToggleMonthExclusion(int month, bool isChecked)
    {
        var current = new HashSet<string>(string.IsNullOrEmpty(newObjective.StreakExcludedMonths) ? Array.Empty<string>() : newObjective.StreakExcludedMonths.Split(','));
        string val = month.ToString();
        if (isChecked) current.Add(val);
        else current.Remove(val);
        newObjective.StreakExcludedMonths = string.Join(",", current.Where(s => !string.IsNullOrEmpty(s)));
    }
    
    private string ToFrenchDay(DayOfWeek d) => System.Globalization.CultureInfo.GetCultureInfo("fr-FR").DateTimeFormat.GetDayName(d);
    private string ToFrenchMonth(int m) => System.Globalization.CultureInfo.GetCultureInfo("fr-FR").DateTimeFormat.GetMonthName(m);

    private bool HasValidationMethod(ValidationMethod method)
    {
        return newObjective.AllowedValidationMethods.HasFlag(method);
    }

    private void ToggleValidationMethod(ValidationMethod method, bool isChecked)
    {
        if (isChecked)
            newObjective.AllowedValidationMethods |= method;
        else
            newObjective.AllowedValidationMethods &= ~method;
    }

    private async Task DownloadQrCode()
    {
        if (editingObjectiveId == null) return;
        string qrImageUrl = $"https://api.qrserver.com/v1/create-qr-code/?size=300x300&data={editingObjectiveId}&color=000000&bgcolor=FFFFFF";
        await JSRuntime.InvokeVoidAsync("open", qrImageUrl, "_blank");
    }
