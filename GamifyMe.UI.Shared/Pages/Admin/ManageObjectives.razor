@page "/admin/objectives"
@attribute [Authorize(Roles = "SuperAdmin, Admin, Editeur, Gestionnaire")]

@using MudBlazor
@using GamifyMe.Shared.Dtos
@using GamifyMe.Shared.Models
@using System.Net.Http.Json
@using GamifyMe.UI.Shared.Components
@using GamifyMe.UI.Shared.Helpers

@inject HttpClient Http
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime

<PageTitle>Gestion Objectifs</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-16">
    <div class="d-flex justify-space-between align-center mb-4">
        <div>
            <MudText Typo="Typo.h5">Gestion des Objectifs</MudText>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ShowWealthEstimation" StartIcon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" Class="mt-2">Estimation Richesse</MudButton>
        </div>
        @if (!showForm)
        {
            <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Size="Size.Large" OnClick="ShowCreateForm" />
        }
    </div>

    @if (showForm)
    {
        <MudCard Elevation="3" Class="mb-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">@(editingObjectiveId == null ? "Créer un nouvel objectif" : "Modifier l'objectif")</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
        <EditForm Model="newObjective" OnValidSubmit="@(editingObjectiveId == null ? HandleCreateObjective : HandleUpdateObjective)">
                    <DataAnnotationsValidator />

                    <MudTextField T="string" Label="Titre" @bind-Value="newObjective.Title" For="@(() => newObjective.Title)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Required="true" />
                    <MudTextField T="string" Label="Description" @bind-Value="newObjective.Description" For="@(() => newObjective.Description)" Variant="Variant.Outlined" Lines="3" Margin="Margin.Dense" Class="mb-3" />

                    <div class="d-flex gap-4 mb-3">
                        <MudTextField T="int" Label="Récompense XP" @bind-Value="newObjective.XpReward" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" Required="true" />
                        <MudTextField T="int" Label="Récompense Crédits" @bind-Value="newObjective.DocPointsReward" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" Required="true" />
                    </div>

                    <MudSelect T="ObjectiveCategory" Label="Catégorie" @bind-Value="newObjective.Category" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Disabled="@IsCategoryAutomatic" Required="true" >
                        @foreach (ObjectiveCategory cat in Enum.GetValues(typeof(ObjectiveCategory)))
                        {
                            if (cat != ObjectiveCategory.Rechargement)
                            {
                                <MudSelectItem Value="@cat">@cat</MudSelectItem>
                            }
                        }
                    </MudSelect>


                    
                    @if (newObjective.Category == ObjectiveCategory.Onboarding)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Info" Class="mb-3 d-block">Utilisez les prérequis ci-dessous pour définir l'ordre du parcours d'onboarding.</MudText>
                    }

                    @* SÉLECTEUR D'ICÔNE ET COULEUR *@
                    <div class="d-flex justify-center align-center gap-8 mb-4">
                        <div class="d-flex flex-column align-center">
                            <MudTooltip Text="Cliquez pour changer l'icône">
                                <MudBadge Icon="@Icons.Material.Filled.Edit" Color="Color.Secondary" Overlap="true" Bordered="true" Class="cursor-pointer">
                                    <MudPaper Class="d-flex justify-center align-center pa-4" Elevation="4" Width="100px" Height="100px" @onclick="OpenIconPickerForObjective">
                                        <MudIcon Icon="@IconLibrary.GetIcon(newObjective.IconName)" Style="font-size: 3rem; color: white;" Color="Color.Default" />
                                    </MudPaper>
                                </MudBadge>
                            </MudTooltip>
                            <MudText Typo="Typo.caption" Align="Align.Center" Class="mt-1">Icône : @newObjective.IconName</MudText>
                        </div>

                        <div style="width: 200px;">
                            <MudColorPicker Label="Couleur" @bind-Text="newObjective.Color" ColorPickerView="ColorPickerView.Palette" Palette="ColorHelper.Palette" Variant="Variant.Outlined" Margin="Margin.Dense" Style="@($"background-color: {(!string.IsNullOrEmpty(newObjective.Color) ? newObjective.Color : "#FFFFFF")}; color: {ColorHelper.GetContrastColor(newObjective.Color ?? "#FFFFFF")}; font-weight: bold;")" Placeholder="Selectionnez une couleur" Required="true" />
                        </div>
                    </div>

                    <MudTextField T="string" Label="Lieu" @bind-Value="newObjective.Location" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />

                    <div class="d-flex gap-4 mb-3 align-center">
                        <MudDatePicker Label="Date Événement" @bind-Date="newObjective.EventDate" Editable="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                        <MudField Label="Heure" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width: 120px; padding-top: 10px;">
                            <input type="time" value="@(eventTime?.ToString(@"hh\:mm"))" @onchange="@((ChangeEventArgs e) => eventTime = string.IsNullOrEmpty(e.Value?.ToString()) ? null : TimeSpan.Parse(e.Value.ToString()))" style="width:100%; border:none; outline:none; background:transparent;" />
                        </MudField>
                    </div>

                    <div class="d-flex gap-4 mb-3 align-center">
                        <MudDatePicker Label="Date Fin" @bind-Date="newObjective.EndDate" Editable="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                        <MudField Label="Heure" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width: 120px; padding-top: 10px;">
                            <input type="time" value="@(endTime?.ToString(@"hh\:mm"))" @onchange="@((ChangeEventArgs e) => endTime = string.IsNullOrEmpty(e.Value?.ToString()) ? null : TimeSpan.Parse(e.Value.ToString()))" style="width:100%; border:none; outline:none; background:transparent;" />
                        </MudField>
                    </div>

                    <div class="d-flex gap-4 mb-3 align-center">
                        <MudDatePicker Label="Affichage : Début" @bind-Date="newObjective.DisplayStartDate" Editable="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" HelperText="Date à partir de laquelle l'objectif est visible" />
                        <MudDatePicker Label="Affichage : Fin" @bind-Date="newObjective.DisplayEndDate" Editable="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" HelperText="Date après laquelle l'objectif disparaît" />
                    </div>

                    @if (newObjective.Category != ObjectiveCategory.Onboarding && newObjective.Category != ObjectiveCategory.Evenement)
                    {
                        <MudTextField T="int?" Label="Durée de vie (Heures)" @bind-Value="newObjective.LifespanHours" HelperText="Temps avant autodestruction (optionnel)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                    }

                    <MudText Typo="Typo.subtitle2" Class="mt-2">Prérequis (facultatif)</MudText>
                    <MudSelect T="Guid?" Label="Choisir un prérequis" @bind-Value="selectedPrerequisiteId" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-3">
                        @foreach (var objective in allObjectivesList.Where(o => o.Id != editingObjectiveId))
                        {
                            <MudSelectItem Value="@((Guid?)objective.Id)">@objective.Title</MudSelectItem>
                        }
                    </MudSelect>



                    <MudSwitch T="bool" @bind-Value="newObjective.IsUnique" Label="Objectif unique" Color="Color.Primary" Class="mb-2" />
                    @if (!newObjective.IsUnique)
                    {
                        <MudTextField T="int?" Label="Fréquence (Heures)" @bind-Value="newObjective.FrequencyHours" HelperText="Délai minimum entre deux validations (en heures)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                    }



                    <MudSwitch T="bool" @bind-Value="newObjective.IsActive" Label="Actif" Color="Color.Primary" Class="mb-3" />

                    @if (!string.IsNullOrEmpty(successMessageObjective))
                    {
                        <MudAlert Severity="Severity.Success" Class="mb-3">@successMessageObjective</MudAlert>
                    }
                    @if (!string.IsNullOrEmpty(errorMessageObjective))
                    {
                        <MudAlert Severity="Severity.Error" Class="mb-3">@errorMessageObjective</MudAlert>
                    }

                    <MudAlert Severity="@(newObjective.IsActive ? Severity.Info : Severity.Warning)" Variant="Variant.Outlined" Class="mb-4" Icon="@Icons.Material.Filled.Info">
                        <MudText Typo="Typo.subtitle2" Style="font-weight:bold; text-decoration:underline;">Résumé du comportement :</MudText>
                        <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@GetObjectiveSummary()</MudText>
                    </MudAlert>

                    <div class="d-flex gap-2">
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Disabled="isBusyObjective">
                            @(editingObjectiveId == null ? "Créer" : "Mettre à jour")
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="CancelEditObjective" FullWidth="true">Annuler</MudButton>
                    </div>
                </EditForm>
            </MudCardContent>
        </MudCard>
    }
    else
    {
        <MudCard Elevation="3">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Objectifs existants</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudDropContainer T="ObjectiveDto" @ref="_dropContainer" Items="_dropZoneItems" ItemsSelector="@((item,dropzone) => dropzone == "dropzone")" ItemDropped="ItemUpdated" Class="d-flex flex-column">
                    <ChildContent>
                        <MudDropZone T="ObjectiveDto" Identifier="dropzone" Class="pa-4" AllowReorder="true" />
                    </ChildContent>
                    <ItemRenderer>
                        <MudPaper Class="d-flex align-center pa-2 mb-2 custom-hover-row" Elevation="0" Style="border-bottom: 1px solid #eee;">
                            <div class="d-flex align-center mr-4 grab-cursor">
                                <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Color="Color.Default" />
                            </div>
                            
                            <!-- Content simulating columns -->
                            <MudGrid Spacing="0" Class="align-center w-100">
                                <MudItem xs="4">
                                    <div class="d-flex align-center" @onclick="@(() => StartEditObjective(context))" style="cursor: pointer;">
                                        <MudAvatar Color="@(string.IsNullOrEmpty(context.Color) ? Color.Primary : Color.Default)" Variant="Variant.Filled" Size="Size.Small" Class="mr-2" Style="@(!string.IsNullOrEmpty(context.Color) ? $"background-color:{context.Color};" : "")">
                                            <MudIcon Icon="@IconLibrary.GetIcon(context.IconName)" Size="Size.Small" Style="color: white;" />
                                        </MudAvatar>
                                        <div class="d-flex flex-column">
                                            <MudText Typo="Typo.body2" Style="font-weight:bold;">@context.Title</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Category</MudText>
                                        </div>
                                        @if (context.Category == ObjectiveCategory.Onboarding)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.School" Class="ml-2">Onboarding</MudChip>
                                        }
                                    </div>
                                </MudItem>
                                <MudItem xs="2">
                                    <MudText Typo="Typo.body2">@context.Location</MudText>
                                </MudItem>
                                <MudItem xs="3">
                                     @if (context.EventDate.HasValue)
                                    {
                                        <div class="mb-1"><MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Event" Color="Color.Primary">@context.EventDate.Value.ToString("dd/MM/yyyy HH:mm")</MudChip></div>
                                    }
                                </MudItem>
                                <MudItem xs="2">
                                    <div class="d-flex gap-1">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">@context.XpReward XP</MudChip>
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success">@context.DocPointsReward Crédits</MudChip>
                                    </div>
                                </MudItem>
                                <MudItem xs="1" Class="d-flex justify-end">
                                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" OnClick="@(() => DuplicateObjective(context))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteObjective(context))" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </ItemRenderer>
                </MudDropContainer>
            </MudCardContent>
        </MudCard>
    }
</MudContainer>

<ScanValidationModal @ref="scanModal" OnScanSuccessRefresh="LoadData" />

@code {
    private bool showForm = false;
    private Guid? editingObjectiveId;
    private CreateObjectiveDto newObjective = new();
    private List<ObjectiveSimpleDto> allObjectivesList = new();
    private List<ObjectiveDto> allObjectivesFullList = new();
    private bool isBusyObjective = false;
    private string? successMessageObjective;
    private string? errorMessageObjective;
    private TimeSpan? eventTime;
    private TimeSpan? endTime;
    private Guid? selectedPrerequisiteId;
    
    private List<ObjectiveDto> _dropZoneItems = new();
    private MudDropContainer<ObjectiveDto>? _dropContainer;
    
    private ScanValidationModal scanModal = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            var objectivesTask = Http.GetFromJsonAsync<List<ObjectiveSimpleDto>>("api/objectives/list-all");
            var objectivesFullTask = Http.GetFromJsonAsync<List<ObjectiveDto>>("api/objectives/list-all-full");
            await Task.WhenAll(objectivesTask, objectivesFullTask);
            allObjectivesList = objectivesTask.Result ?? new();
            allObjectivesFullList = objectivesFullTask.Result ?? new();
            
            // Sort by Category then SortOrder for the view
            _dropZoneItems = allObjectivesFullList
                .OrderBy(o => o.Category)
                .ThenBy(o => o.SortOrder)
                .ToList();
            
            StateHasChanged();
            _dropContainer?.Refresh();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur chargement : {ex.Message}");
        }
    }

    private void ShowCreateForm()
    {
        editingObjectiveId = null;
        newObjective = new CreateObjectiveDto();
        newObjective.Color = "#FFFFFF"; // Default color
        newObjective.XpReward = 5;
        newObjective.DocPointsReward = 5;
        newObjective.IsActive = true;
        eventTime = null;
        endTime = null;
        selectedPrerequisiteId = null;
        showForm = true;
    }

    private async Task HandleCreateObjective()
    {
        MergeDatesAndTimes();
        
        // Sync selected prerequisite
        newObjective.PrerequisiteObjectiveIds.Clear();
        if (selectedPrerequisiteId.HasValue)
        {
            newObjective.PrerequisiteObjectiveIds.Add(selectedPrerequisiteId.Value);
        }

        isBusyObjective = true;
        successMessageObjective = null;
        errorMessageObjective = null;
        try
        {
            var response = await Http.PostAsJsonAsync("api/objectives", newObjective);
            if (response.IsSuccessStatusCode)
            {
                successMessageObjective = "Objectif créé !";
                newObjective = new CreateObjectiveDto();
                selectedPrerequisiteId = null;
                await LoadData();
                showForm = false;
            }
            else { errorMessageObjective = $"Erreur: {await response.Content.ReadAsStringAsync()}"; }
        }
        catch (Exception ex) { errorMessageObjective = $"Erreur: {ex.Message}"; }
        finally { isBusyObjective = false; }
    }

    private void StartEditObjective(ObjectiveDto objectiveToEdit)
    {
        editingObjectiveId = objectiveToEdit.Id;
        eventTime = objectiveToEdit.EventDate?.TimeOfDay;
        endTime = objectiveToEdit.EndDate?.TimeOfDay;
        
        selectedPrerequisiteId = objectiveToEdit.PrerequisiteObjectiveIds.FirstOrDefault();
        if (selectedPrerequisiteId == Guid.Empty) selectedPrerequisiteId = null;

        newObjective = new CreateObjectiveDto
        {
            Title = objectiveToEdit.Title,
            Description = objectiveToEdit.Description,
            IconName = objectiveToEdit.IconName,
            Location = objectiveToEdit.Location,
            EventDate = objectiveToEdit.EventDate,
            EndDate = objectiveToEdit.EndDate,
            XpReward = objectiveToEdit.XpReward,
            DocPointsReward = objectiveToEdit.DocPointsReward,
            IsUnique = objectiveToEdit.IsUnique,
            FrequencyHours = objectiveToEdit.FrequencyHours,
            IsActive = objectiveToEdit.IsActive,
            DisplayStartDate = objectiveToEdit.DisplayStartDate,
            DisplayEndDate = objectiveToEdit.DisplayEndDate,
            PrerequisiteObjectiveIds = objectiveToEdit.PrerequisiteObjectiveIds ?? new List<Guid>(),
            LifespanHours = objectiveToEdit.LifespanHours,
            Category = objectiveToEdit.Category,
            SortOrder = objectiveToEdit.SortOrder,
            Color = !string.IsNullOrEmpty(objectiveToEdit.Color) ? objectiveToEdit.Color : "#FFFFFF"
        };
        showForm = true;
    }

    private void CancelEditObjective()
    {
        editingObjectiveId = null;
        newObjective = new CreateObjectiveDto();
        eventTime = null;
        endTime = null;
        selectedPrerequisiteId = null;
        errorMessageObjective = null;
        showForm = false;
    }

    private async Task HandleUpdateObjective()
    {
        if (editingObjectiveId == null) return;
        MergeDatesAndTimes();

        // Sync selected prerequisite
        newObjective.PrerequisiteObjectiveIds.Clear();
        if (selectedPrerequisiteId.HasValue)
        {
            newObjective.PrerequisiteObjectiveIds.Add(selectedPrerequisiteId.Value);
        }

        isBusyObjective = true;
        try
        {
            var response = await Http.PutAsJsonAsync($"api/objectives/{editingObjectiveId.Value}", newObjective);
            if (response.IsSuccessStatusCode)
            {
                successMessageObjective = "Mis à jour !";
                CancelEditObjective();
                await LoadData();
            }
            else { errorMessageObjective = $"Erreur: {await response.Content.ReadAsStringAsync()}"; }
        }
        catch (Exception ex) { errorMessageObjective = $"Erreur: {ex.Message}"; }
        finally { isBusyObjective = false; }
    }

    private async Task DeleteObjective(ObjectiveDto objectiveToDelete)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Supprimer '{objectiveToDelete.Title}' ?");
        if (!confirmed) return;
        try
        {
            var response = await Http.DeleteAsync($"api/objectives/{objectiveToDelete.Id}");
            if (response.IsSuccessStatusCode) await LoadData();
            else errorMessageObjective = "Erreur suppression.";
        }
        catch (Exception ex) { errorMessageObjective = ex.Message; }
    }

    private async Task DuplicateObjective(ObjectiveDto objectiveToDuplicate)
    {
        isBusyObjective = true;
        try
        {
            var duplicate = new CreateObjectiveDto
            {
                Title = $"Copie de {objectiveToDuplicate.Title}",
                Description = objectiveToDuplicate.Description,
                IconName = objectiveToDuplicate.IconName,
                Location = objectiveToDuplicate.Location,
                EventDate = objectiveToDuplicate.EventDate,
                EndDate = objectiveToDuplicate.EndDate,
                XpReward = objectiveToDuplicate.XpReward,
                DocPointsReward = objectiveToDuplicate.DocPointsReward,
                IsUnique = objectiveToDuplicate.IsUnique,
                FrequencyHours = objectiveToDuplicate.FrequencyHours,
                IsActive = false,
                DisplayStartDate = objectiveToDuplicate.DisplayStartDate,
                DisplayEndDate = objectiveToDuplicate.DisplayEndDate,
                PrerequisiteObjectiveIds = objectiveToDuplicate.PrerequisiteObjectiveIds != null ? new List<Guid>(objectiveToDuplicate.PrerequisiteObjectiveIds) : new List<Guid>(),
                LifespanHours = objectiveToDuplicate.LifespanHours,
                Category = objectiveToDuplicate.Category,
                SortOrder = objectiveToDuplicate.SortOrder
            };

            var response = await Http.PostAsJsonAsync("api/objectives", duplicate);
            if (response.IsSuccessStatusCode)
            {
                successMessageObjective = "Objectif dupliqué !";
                await LoadData();
            }
            else { errorMessageObjective = $"Erreur duplication: {await response.Content.ReadAsStringAsync()}"; }
        }
        catch (Exception ex) { errorMessageObjective = $"Erreur duplication: {ex.Message}"; }
        finally { isBusyObjective = false; }
    }

    private async Task OpenIconPickerForObjective()
    {
        var options = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<IconPickerDialog>("Choisir une icône", options);
        var result = await dialog.Result;
        if (!result.Canceled && result.Data is string iconName) newObjective.IconName = iconName;
    }

    private async Task ShowWealthEstimation()
    {
        var parameters = new DialogParameters { ["Objectives"] = allObjectivesFullList };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<WealthEstimationDialog>("Estimation Richesse", parameters, options);
    }

    private void MergeDatesAndTimes()
    {
        if (newObjective.EventDate.HasValue)
        {
            newObjective.EventDate = newObjective.EventDate.Value.Date + (eventTime ?? TimeSpan.Zero);
        }
        if (newObjective.EndDate.HasValue)
        {
            newObjective.EndDate = newObjective.EndDate.Value.Date + (endTime ?? TimeSpan.Zero);
        }
    }

    private bool IsCategoryAutomatic => 
        (newObjective.EventDate.HasValue && newObjective.EndDate.HasValue);

    private async Task ItemUpdated(MudItemDropInfo<ObjectiveDto> dropItem)
    {
        // Update local list
        dropItem.Item.Category = dropItem.Item.Category; // Keep category? Or assume single list.
        // Actually, with a single DropZone, we just reorder the list.
        
        // Remove item from old position
        _dropZoneItems.Remove(dropItem.Item);
        // Insert at new position
        _dropZoneItems.Insert(dropItem.IndexInZone, dropItem.Item);
        
        // Trigger server update
        var orderedIds = _dropZoneItems.Select(x => x.Id).ToList();
        var reorderDto = new ReorderRequestDto { OrderedIds = orderedIds };
        
        try 
        {
            var response = await Http.PostAsJsonAsync("api/objectives/reorder", reorderDto);
             if (!response.IsSuccessStatusCode)
             {
                 errorMessageObjective = "Erreur lors de la réorganisation.";
                 await LoadData(); // Revert
             }
        }
        catch (Exception ex)
        {
             errorMessageObjective = ex.Message;
        }
    }

    private string GetObjectiveSummary()
    {
        var sb = new System.Text.StringBuilder();

        // 1. Statut Actif
        if (!newObjective.IsActive)
        {
            return "⛔ CET OBJECTIF EST INACTIF. Il ne sera visible pour aucun joueur, même si toutes les autres conditions sont remplies.";
        }

        // 1.5. Description Catégorie
        switch (newObjective.Category)
        {
            case ObjectiveCategory.Principal:
                sb.AppendLine("⭐ TYPE : Objectif majeur, mis en avant dans l'interface.");
                break;
            case ObjectiveCategory.Secondaire:
                sb.AppendLine("📝 TYPE : Objectif standard, enrichit l'expérience quotidienne.");
                break;
            case ObjectiveCategory.Evenement:
                sb.AppendLine("🎉 TYPE : Objectif ponctuel lié à un événement, avec une priorité d'affichage élevée.");
                break;
            case ObjectiveCategory.Onboarding:
                sb.AppendLine("🎓 TYPE : Étape du parcours d'intégration des nouveaux joueurs.");
                break;
        }

        // 2. Prérequis
        if (selectedPrerequisiteId.HasValue)
        {
            var pre = allObjectivesList.FirstOrDefault(o => o.Id == selectedPrerequisiteId.Value);
            if (pre != null)
            {
                sb.AppendLine($"🔒 VERROUILLÉ : Cet objectif n'apparaîtra QUE lorsque le joueur aura validé l'objectif \"{pre.Title}\".");
            }
        }
        else
        {
             if (newObjective.Category == ObjectiveCategory.Onboarding)
                sb.AppendLine("🏁 DÉPART : Accessible dès le début du parcours d'intégration.");
             else
                sb.AppendLine("🔓 DÉVERROUILLÉ : Accessible par défaut (si les dates correspondent).");
        }

        // 3. Dates d'affichage
        if (newObjective.DisplayStartDate.HasValue || newObjective.DisplayEndDate.HasValue)
        {
            if (newObjective.DisplayStartDate.HasValue && newObjective.DisplayEndDate.HasValue)
                sb.AppendLine($"📅 VISIBILITÉ : Visible uniquement du {newObjective.DisplayStartDate:dd/MM/yyyy HH:mm} au {newObjective.DisplayEndDate:dd/MM/yyyy HH:mm}.");
            else if (newObjective.DisplayStartDate.HasValue)
                sb.AppendLine($"📅 VISIBILITÉ : Visible à partir du {newObjective.DisplayStartDate:dd/MM/yyyy HH:mm}.");
            else if (newObjective.DisplayEndDate.HasValue)
                sb.AppendLine($"📅 VISIBILITÉ : Visible jusqu'au {newObjective.DisplayEndDate:dd/MM/yyyy HH:mm}, puis disparaît.");
        }
        else
        {
            sb.AppendLine("📅 VISIBILITÉ : Visible en permanence (selon prérequis).");
        }

        // 4. Durée de vie (Chrono)
        if (newObjective.LifespanHours.HasValue && newObjective.Category != ObjectiveCategory.Onboarding && newObjective.Category != ObjectiveCategory.Evenement)
        {
             sb.AppendLine($"⏳ COMPTE À REBOURS : Une fois apparu dans la liste du joueur, il a {newObjective.LifespanHours} heures pour le valider avant qu'il ne disparaisse définitivement.");
        }

        // 5. Répétition et Fréquence
        if (newObjective.IsUnique)
        {
            sb.Append("✅ VALIDATION UNIQUE : Cet objectif ne peut être accompli qu'une seule fois.");
        }
        else
        {
            sb.Append("🔄 RÉPÉTABLE : Le joueur peut valider cet objectif plusieurs fois.");
            if (newObjective.FrequencyHours.HasValue && newObjective.FrequencyHours > 0)
                sb.Append($" Un délai d'attente de {newObjective.FrequencyHours} heures est imposé entre chaque validation.");
            else
                sb.Append(" Aucune limite de temps entre deux validations.");
        }

        return sb.ToString();
    }
}

