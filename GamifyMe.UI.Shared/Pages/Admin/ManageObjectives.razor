    private bool IsCategoryAutomatic => newObjective.Category == ObjectiveCategory.Rechargement;

    private void ShowCreateForm()
    {
        editingObjectiveId = null;
        newObjective = new CreateObjectiveDto { IconName = "fas fa-star", Color = "#FFFFFF", IsActive = true };
        eventTime = null;
        endTime = null;
