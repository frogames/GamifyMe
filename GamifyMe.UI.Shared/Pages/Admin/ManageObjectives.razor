    private void CancelEditObjective()
    {
        showForm = false;
        editingObjectiveId = null;
        successMessageObjective = null;
        errorMessageObjective = null;
    }

    private async Task StartEditObjective(ObjectiveDto objective)
    {
        editingObjectiveId = objective.Id;
        newObjective = new CreateObjectiveDto
        {
            Title = objective.Title,
            Description = objective.Description,
            IconName = objective.IconName,
            Location = objective.Location,
            EventDate = objective.EventDate,
            EndDate = objective.EndDate,
            XpReward = objective.XpReward,
            DocPointsReward = objective.DocPointsReward,
            IsUnique = objective.IsUnique,
            FrequencyHours = objective.FrequencyHours,
            IsActive = objective.IsActive,
            DisplayStartDate = objective.DisplayStartDate,
            DisplayEndDate = objective.DisplayEndDate,
            PrerequisiteObjectiveIds = objective.PrerequisiteObjectiveIds != null ? new List<Guid>(objective.PrerequisiteObjectiveIds) : new List<Guid>(),
            LifespanHours = objective.LifespanHours,
            Category = objective.Category,
            SortOrder = objective.SortOrder,
            IsStreakEnabled = objective.IsStreakEnabled,
            StreakTerminalHours = objective.StreakTerminalHours,
            StreakFrequency = objective.StreakFrequency,

            StreakExcludedMonths = objective.StreakExcludedMonths,
            Color = objective.Color,
            AllowedValidationMethods = objective.AllowedValidationMethods,
            RequiredPeerValidations = objective.RequiredPeerValidations
        };
        
        selectedPrerequisiteId = newObjective.PrerequisiteObjectiveIds?.FirstOrDefault();
        eventTime = objective.EventDate?.TimeOfDay;
        endTime = objective.EndDate?.TimeOfDay;
        
        showForm = true;
    }

    private async Task HandleCreateObjective()
    {
        PrepareObjectiveBeforeSave();
        isBusyObjective = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/objectives", newObjective);
            if (response.IsSuccessStatusCode)
            {
                successMessageObjective = "Objectif créé !";
                await LoadData();
                CancelEditObjective();
            }
            else { errorMessageObjective = await response.Content.ReadAsStringAsync(); }
        }
        catch (Exception ex) { errorMessageObjective = ex.Message; }
        finally { isBusyObjective = false; }
    }

    private async Task HandleUpdateObjective()
    {
        if (editingObjectiveId == null) return;
        PrepareObjectiveBeforeSave();
        isBusyObjective = true;
        try
        {
            var response = await Http.PutAsJsonAsync($"api/objectives/{editingObjectiveId}", newObjective);
            if (response.IsSuccessStatusCode)
            {
                successMessageObjective = "Mis à jour !";
                await LoadData();
                CancelEditObjective();
            }
            else { errorMessageObjective = await response.Content.ReadAsStringAsync(); }
        }
        catch (Exception ex) { errorMessageObjective = ex.Message; }
        finally { isBusyObjective = false; }
    }

    private void PrepareObjectiveBeforeSave()
    {
        if (newObjective.EventDate.HasValue && eventTime.HasValue)
            newObjective.EventDate = newObjective.EventDate.Value.Date + eventTime.Value;
        if (newObjective.EndDate.HasValue && endTime.HasValue)
            newObjective.EndDate = newObjective.EndDate.Value.Date + endTime.Value;
            
        newObjective.PrerequisiteObjectiveIds = selectedPrerequisiteId.HasValue 
            ? new List<Guid> { selectedPrerequisiteId.Value } 
            : new List<Guid>();
    }

