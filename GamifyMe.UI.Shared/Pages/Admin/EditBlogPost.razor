@page "/admin/blog/new"
@page "/admin/blog/edit/{Id:guid}"
@using GamifyMe.Shared.Dtos
@using GamifyMe.UI.Shared.Services
@using MudBlazor
@attribute [Authorize(Roles = "SuperAdmin")]
@inject BlogService BlogService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6 mb-16">
    <div class="d-flex align-center gap-4 mb-6">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack" />
        <MudText Typo="Typo.h4" Color="Color.Primary">@(IsEdit ? "Éditer l'article" : "Nouvel Article")</MudText>
    </div>

    @if (isLoading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudForm @ref="form" @bind-IsValid="@success">
            <MudPaper Class="pa-4 mb-4" Elevation="3">
                <MudTextField @bind-Value="model.Title" Label="Titre" Required="true" Variant="Variant.Outlined" Class="mb-4" />
                
                @if (IsEdit)
                {
                    <MudTextField @bind-Value="model.Slug" Label="Slug (URL)" Variant="Variant.Outlined" Class="mb-4" HelperText="Laissez vide pour générer automatiquement" />
                }

                <MudTextField @bind-Value="model.Summary" Label="Résumé (Méta description)" Lines="3" Variant="Variant.Outlined" Class="mb-4" />
                
                <MudTextField @bind-Value="model.CoverImageUrl" Label="URL Image de couverture" Variant="Variant.Outlined" Class="mb-4" />
                
                @if(!string.IsNullOrEmpty(model.CoverImageUrl))
                {
                    <MudImage Src="@model.CoverImageUrl" Height="200" ObjectFit="ObjectFit.Cover" Class="rounded mb-4" />
                }

                <MudCheckBox @bind-Value="model.IsPublished" Label="Publier immédiatement" Color="Color.Success" />
            </MudPaper>

            <MudTabs Elevation="3" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
                <MudTabPanel Text="Édition" Icon="@Icons.Material.Filled.Edit">
                    <MudPaper Class="pa-4 mb-4" Elevation="0">
                         <MudToolBar Dense="true" Class="gap-2 border-bottom mb-2">
                            <MudIconButton Icon="@Icons.Material.Filled.FormatBold" OnClick='@(() => InsertTag("<b>", "</b>"))' Title="Gras" />
                            <MudIconButton Icon="@Icons.Material.Filled.FormatItalic" OnClick='@(() => InsertTag("<i>", "</i>"))' Title="Italique" />
                            <MudDivider Vertical="true" FlexItem="true" />
                            <MudIconButton Icon="fas fa-heading" Size="Size.Small" OnClick='@(() => InsertTag("<h2>", "</h2>"))'>H2</MudIconButton>
                            <MudIconButton Icon="fas fa-heading" Size="Size.Small" OnClick='@(() => InsertTag("<h3>", "</h3>"))'>H3</MudIconButton>
                            <MudDivider Vertical="true" FlexItem="true" />
                            <MudIconButton Icon="@Icons.Material.Filled.FormatListBulleted" OnClick='@(() => InsertTag("<ul>\n<li>", "</li>\n</ul>"))' Title="Liste à puces" />
                            <MudIconButton Icon="@Icons.Material.Filled.Link" OnClick='@(() => InsertTag("<a href=\"URL_ICI\">", "</a>"))' Title="Lien" />
                            <MudIconButton Icon="@Icons.Material.Filled.Image" OnClick='@(() => InsertTag("<img src=\"URL_IMAGE\" alt=\"Description\" />", ""))' Title="Image" />
                        </MudToolBar>

                        <MudTextField @bind-Value="model.Content" 
                                      Label="Contenu HTML" 
                                      Lines="20" 
                                      Variant="Variant.Outlined" 
                                      Required="true" 
                                      Id="content-editor"
                                      Adornment="Adornment.None" />
                    </MudPaper>
                </MudTabPanel>
                <MudTabPanel Text="Aperçu" Icon="@Icons.Material.Filled.Preview">
                     <MudPaper Class="pa-6" Elevation="0" Style="min-height: 500px; background-color: white;">
                        <div class="article-content">
                            @((MarkupString)model.Content)
                        </div>
                    </MudPaper>
                     <!-- Styles for preview mirroring the actual blog post styles -->
                    <style>
                        .article-content h2 { font-size: 1.75rem; font-weight: 700; margin-top: 2rem; margin-bottom: 1rem; color: #1a2b4c; }
                        .article-content h3 { font-size: 1.5rem; font-weight: 600; margin-top: 1.75rem; margin-bottom: 0.75rem; color: #1a2b4c; }
                        .article-content p { margin-bottom: 1.5rem; }
                        .article-content ul, .article-content ol { margin-bottom: 1.5rem; padding-left: 1.5rem; }
                        .article-content li { margin-bottom: 0.5rem; }
                        .article-content blockquote { border-left: 4px solid var(--mud-palette-primary); padding-left: 1rem; margin-left: 0; font-style: italic; color: #495057; }
                        .article-content img { max-width: 100%; height: auto; border-radius: 8px; margin: 1rem 0; }
                    </style>
                </MudTabPanel>
            </MudTabs>

            <div class="d-flex justify-end gap-2 mt-4">
                <MudButton OnClick="GoBack" Variant="Variant.Text">Annuler</MudButton>
                <MudButton OnClick="Save" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!success || isSaving)">
                    @if (isSaving)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                        <MudText Class="ms-2">Enregistrement...</MudText>
                    }
                    else
                    {
                        <MudText>Enregistrer</MudText>
                    }
                </MudButton>
            </div>
        </MudForm>
    }
</MudContainer>

@code {
    [Parameter] public Guid? Id { get; set; }
    
    [Inject] private IJSRuntime JSRuntime { get; set; }

    private bool IsEdit => Id.HasValue;
    private bool isLoading = false;
    private bool isSaving = false;
    private bool success;
    private MudForm form;

    private UpdateBlogPostDto model = new(); 

    private async Task InsertTag(string openId, string closeId)
    {
        await JSRuntime.InvokeVoidAsync("siteUtils.insertTextAtCursor", "content-editor", openId, closeId);
        // Trigger state change just in case, though JS events should handle binding updates mostly
    }

    protected override async Task OnInitializedAsync()
    {
        if (IsEdit)
        {
            isLoading = true;
            try
            {
                var allPosts = await BlogService.GetAllPostsAdminAsync();
                var existing = allPosts.FirstOrDefault(p => p.Id == Id.Value);

                if (existing != null)
                {
                    model = new UpdateBlogPostDto
                    {
                        Title = existing.Title,
                        Slug = existing.Slug,
                        Content = existing.Content,
                        Summary = existing.Summary,
                        CoverImageUrl = existing.CoverImageUrl,
                        IsPublished = existing.IsPublished
                    };
                }
                else
                {
                    Snackbar.Add("Article introuvable", Severity.Error);
                    Navigation.NavigateTo("/admin/blog");
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Erreur: {ex.Message}", Severity.Error);
            }
            finally
            {
                isLoading = false;
            }
        }
    }

    private async Task Save()
    {
        isSaving = true;
        try
        {
            if (IsEdit)
            {
                await BlogService.UpdatePostAsync(Id.Value, model);
                Snackbar.Add("Article mis à jour", Severity.Success);
            }
            else
            {
                var createDto = new CreateBlogPostDto
                {
                    Title = model.Title,
                    Content = model.Content,
                    Summary = model.Summary,
                    CoverImageUrl = model.CoverImageUrl,
                    IsPublished = model.IsPublished,
                    Author = "Meritopass" // Default
                };
                await BlogService.CreatePostAsync(createDto);
                Snackbar.Add("Article créé", Severity.Success);
            }
            Navigation.NavigateTo("/admin/blog");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur lors de l'enregistrement: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/admin/blog");
    }
}
