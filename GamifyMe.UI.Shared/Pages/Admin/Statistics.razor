@page "/admin/stats"
@using GamifyMe.Shared.Dtos
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "SuperAdmin,Admin,Editeur")]
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <MudText Typo="Typo.h4" Class="mb-4">Statistiques Détaillées</MudText>

    @if (_stats == null)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <!-- Key Figures -->
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 d-flex flex-column align-center justify-center mud-theme-primary" Elevation="3">
                    <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" Class="mb-2" />
                    <MudText Typo="Typo.h5">@_stats.KeyFigures.TotalUsers</MudText>
                    <MudText Typo="Typo.body2">Utilisateurs Total</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 d-flex flex-column align-center justify-center mud-theme-secondary" Elevation="3">
                    <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Large" Class="mb-2" />
                     <MudText Typo="Typo.h5">@_stats.KeyFigures.NewUsersLast30Days</MudText>
                    <MudText Typo="Typo.body2">Nouveaux (30j)</MudText>
                </MudPaper>
            </MudItem>
             <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 d-flex flex-column align-center justify-center mud-theme-tertiary" Elevation="3">
                    <MudIcon Icon="@Icons.Material.Filled.LocalActivity" Size="Size.Large" Class="mb-2" />
                     <MudText Typo="Typo.h5">@_stats.KeyFigures.ActiveUsersLast30Days</MudText>
                    <MudText Typo="Typo.body2">Actifs (30j)</MudText>
                </MudPaper>
            </MudItem>
             <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 d-flex flex-column align-center justify-center mud-theme-info" Elevation="3">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" Class="mb-2" />
                     <MudText Typo="Typo.h5">@_stats.KeyFigures.TotalValidations</MudText>
                    <MudText Typo="Typo.body2">Validations Totales</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudGrid>
            <!-- User Growth Charts -->
            <MudItem xs="12" md="8">
                <MudPaper Class="pa-4" Elevation="3">
                    <div class="d-flex justify-space-between align-center mb-4">
                         <MudText Typo="Typo.h6">Évolution des Utilisateurs</MudText>
                         <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined" OverrideStyles="false">
                            <MudButton OnClick="@(() => LoadGrowthData("week"))" Variant="@(_currentPeriod == "week" ? Variant.Filled : Variant.Outlined)">Semaine</MudButton>
                            <MudButton OnClick="@(() => LoadGrowthData("month"))" Variant="@(_currentPeriod == "month" ? Variant.Filled : Variant.Outlined)">Mois</MudButton>
                            <MudButton OnClick="@(() => LoadGrowthData("year"))" Variant="@(_currentPeriod == "year" ? Variant.Filled : Variant.Outlined)">Année</MudButton>
                        </MudButtonGroup>
                    </div>

                    @if (_loadingGrowth)
                    {
                         <div class="d-flex justify-center align-center" style="height: 350px;">
                             <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                         </div>
                    }
                    else
                    {
                        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-2">
                            <MudTabPanel Text="Nouveaux Utilisateurs">
                                <MudChart ChartType="ChartType.Line" ChartSeries="@_newUsersSeries" XAxisLabels="@_xAxisLabels" Width="100%" Height="350px"></MudChart>
                            </MudTabPanel>
                            <MudTabPanel Text="Utilisateurs Total">
                                <MudChart ChartType="ChartType.Line" ChartSeries="@_totalUsersSeries" XAxisLabels="@_xAxisLabels" Width="100%" Height="350px"></MudChart>
                            </MudTabPanel>
                        </MudTabs>
                    }
                </MudPaper>
            </MudItem>
            
            <!-- Objective KPIs -->
             <MudItem xs="12" md="4">
                <MudPaper Class="pa-4" Elevation="3" Style="height: 100%; overflow-y: auto; max-height: 450px;">
                    <MudText Typo="Typo.h6" Class="mb-4">Performance Objectifs</MudText>
                    <MudTable Items="@_stats.ObjectiveKpis" Hover="true" Breakpoint="Breakpoint.None" Dense="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Objectif</MudTh>
                            <MudTh>Taux</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Objectif">
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@context.ObjectiveTitle</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Default">@context.UniqueUsers complétions</MudText>
                            </MudTd>
                            <MudTd DataLabel="Taux">
                                <MudText Typo="Typo.body2" Color="@GetColorForRate(context.CompletionRate)">@context.CompletionRate%</MudText>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private AdminDetailedStatsDto? _stats;
    private List<ChartSeries> _newUsersSeries = new();
    private List<ChartSeries> _totalUsersSeries = new();
    private string[] _xAxisLabels = { };
    private string _currentPeriod = "month";
    private bool _loadingGrowth = false;

    protected override async Task OnInitializedAsync()
    {
        try 
        {
            // Load Base Stats
            _stats = await Http.GetFromJsonAsync<AdminDetailedStatsDto>("api/stats/detailed");
            
            // Load Initial Growth Chart
            await LoadGrowthData("month");
        }
        catch (Exception ex)
        {
             Snackbar.Add("Erreur de chargement des statistiques: " + ex.Message, Severity.Error);
        }
    }

    private async Task LoadGrowthData(string period)
    {
        _currentPeriod = period;
        _loadingGrowth = true;
        StateHasChanged(); // Show loader

        try
        {
            var growthData = await Http.GetFromJsonAsync<List<StatsUserGrowthDto>>($"api/stats/growth?period={period}");
            
            if (growthData != null)
            {
                 _xAxisLabels = growthData.Select(g => g.Period).ToArray();
                 
                 _newUsersSeries = new List<ChartSeries>
                 {
                     new ChartSeries { Name = "Nouveaux", Data = growthData.Select(g => (double)g.NewUsers).ToArray() }
                 };

                 _totalUsersSeries = new List<ChartSeries>
                 {
                     new ChartSeries { Name = "Total", Data = growthData.Select(g => (double)g.CumulativeUsers).ToArray() }
                 };
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Erreur chargement graphiques: " + ex.Message, Severity.Error);
        }
        finally
        {
            _loadingGrowth = false;
        }
    }

    private Color GetColorForRate(double rate)
    {
        if (rate >= 50) return Color.Success;
        if (rate >= 20) return Color.Info;
        return Color.Warning;
    }
}
