@page "/join-group/{GroupId:guid}"
@using GamifyMe.Shared.Dtos
@using Microsoft.AspNetCore.Components.Authorization
@using System.Net.Http
@using System.Net.Http.Json
@using MudBlazor
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Rejoindre un Groupe</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16 d-flex flex-column align-center">
    <MudPaper Elevation="3" Class="pa-8 d-flex flex-column align-center" Style="width: 100%;">
        <MudIcon Icon="@Icons.Material.Filled.GroupAdd" Size="Size.Large" Color="Color.Primary" Class="mb-4" Style="font-size: 4rem;" />
        
        <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-2">Rejoindre le groupe</MudText>
        
        @if (isLoading)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="my-4" />
            <MudText Typo="Typo.body1">Traitement en cours...</MudText>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="my-4">@errorMessage</MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/" FullWidth="true" Class="mt-4">Retour à l'accueil</MudButton>
        }
        else
        {
            <MudAlert Severity="Severity.Success" Class="my-4">@successMessage</MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/" FullWidth="true" Class="mt-4">Continuer</MudButton>
        }
    </MudPaper>
</MudContainer>

@code {
    [Parameter] public Guid GroupId { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private bool isLoading = true;
    private string? successMessage;
    private string? errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Check if user is authenticated
            if (AuthenticationStateTask != null)
            {
                var authState = await AuthenticationStateTask;
                var user = authState.User;

                if (!user.Identity?.IsAuthenticated ?? true)
                {
                    // Not authenticated - redirect to login with return URL
                    var returnUrl = Uri.EscapeDataString($"/join-group/{GroupId}");
                    Navigation.NavigateTo($"/login?returnUrl={returnUrl}", forceLoad: true);
                    return;
                }
            }

            // User is authenticated, proceed with joining
            await ExecuteJoinGroup();
            StateHasChanged();
        }
    }

    private async Task ExecuteJoinGroup()
    {
        isLoading = true;
        try
        {
            var response = await Http.PostAsync($"api/groups/join/{GroupId}", null);
            
            if (response.IsSuccessStatusCode)
            {
                var message = await response.Content.ReadAsStringAsync();
                // Remove quotes if present
                successMessage = message.Trim('"');
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                // In case auth check didn't catch it
                var returnUrl = Uri.EscapeDataString($"/join-group/{GroupId}");
                Navigation.NavigateTo($"/login?returnUrl={returnUrl}", forceLoad: true);
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                errorMessage = error.Trim('"');
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Une erreur s'est produite : {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
