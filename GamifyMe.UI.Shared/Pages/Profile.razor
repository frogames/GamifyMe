@page "/profile"
@using GamifyMe.Shared.Dtos
@using GamifyMe.UI.Shared.Helpers
@using GamifyMe.UI.Shared.Services
@using System.Net.Http.Json
@using MudBlazor
@using GamifyMe.UI.Shared.Components
@using Microsoft.Extensions.Localization
@inject HttpClient Http
@inject NavigationManager Navigation
@inject TokenStorageService TokenService
@inject AuthenticationStateProvider AuthStateProvider
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<GamifyMe.UI.Shared.Resources.App> Loc

<PageTitle>@Loc["MyProfile"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-4 mb-16">

    @if (isLoading)
    {
        <div class="d-flex justify-center mt-8">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else if (profile == null)
    {
        <MudAlert Severity="Severity.Error">@Loc["UnableToLoadProfile"]</MudAlert>
        <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Logout" OnClick="Logout" FullWidth="true" Class="mt-4">
            @Loc["Logout"]
        </MudButton>
    }
    else
    {
        @* 1. EN-TÊTE *@
        <div class="d-flex flex-column align-center mb-6">
            <MudAvatar Style="width:80px; height:80px; font-size:2rem;" Color="Color.Primary" Class="mb-2">
                @profile.FirstName.Substring(0, 1).ToUpper()
            </MudAvatar>
            
            @* NOM & PRÉNOM *@
            <div class="d-flex align-center">
                <MudText Typo="Typo.h5">@profile.FirstName @profile.Username</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default" OnClick="EditName" Class="ml-2" Title="@Loc["EditNameTitle"]" />
            </div>

            @* EMAIL *@
            <div class="d-flex align-center mt-1">
                <MudText Typo="Typo.body2" Color="Color.Secondary">@profile.Email</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default" OnClick="EditEmail" Class="ml-1" Title="@Loc["EditEmailTitle"]" />
            </div>

            <MudText Typo="Typo.body2" Color="Color.Secondary">@profile.EstablishmentName</MudText>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="mt-1 mb-4">@profile.Role</MudChip>
            
            <CultureSelector />
        </div>

        @* 2. NIVEAU & PROGRESSION *@
        <MudCard Elevation="3" Class="mb-6 pa-4">
            <div class="d-flex justify-space-between align-end mb-2">
                <MudText Typo="Typo.h6" Color="Color.Warning"><b>@Loc["Level", profile.Level]</b></MudText>
                <MudText Typo="Typo.caption">@profile.CurrentXp / @profile.XpForNextLevel XP</MudText>
            </div>
            <MudProgressLinear Color="Color.Warning" Value="@profile.ProgressPercentage" Size="Size.Large" Rounded="true" Striped="true" Class="my-2" />
            <MudText Typo="Typo.caption" Align="Align.Center" Class="d-block mt-1 text-muted">
                @Loc["XpForNextLevel", (profile.XpForNextLevel - profile.CurrentXp)]
            </MudText>
        </MudCard>

        @* 4. PORTEFEUILLE *@
        <MudGrid Class="mb-6">
            <MudItem xs="6">
                <MudPaper Elevation="2" Class="pa-4 d-flex flex-column align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Bolt" Color="Color.Secondary" Size="Size.Large" Class="mb-2" />
                    <MudText Typo="Typo.h5">@profile.CurrentXp</MudText>
                    <MudText Typo="Typo.caption">@Loc["TotalXP"]</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6">
                <MudPaper Elevation="2" Class="pa-4 d-flex flex-column align-center">
                    <MudIcon Icon="@Icons.Material.Filled.MonetizationOn" Color="Color.Info" Size="Size.Large" Class="mb-2" />
                    <MudText Typo="Typo.h5">@profile.CurrencyBalance</MudText>
                    <MudText Typo="Typo.caption">@Loc["Credits"]</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        @* 5. HISTORIQUE RÉCENT *@
        @if (profile.RecentActivity != null && profile.RecentActivity.Any())
        {
            <MudList T="string" Dense="true" DisablePadding="true">
                @foreach (var activity in profile.RecentActivity.Skip((currentPage - 1) * 10).Take(10))
                {
                    <MudListItem Icon="@activity.Icon" IconColor="Color.Primary">
                        <div class="d-flex justify-space-between align-center width-100">
                            <div>
                                <MudText Typo="Typo.body2">@activity.Description</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@activity.Date.ToLocalTime().ToString("g")</MudText>
                            </div>
                            <div class="d-flex flex-column align-end">
                                @if (activity.XpChange != 0)
                                {
                                    <MudText Typo="Typo.caption" Color="@(activity.XpChange > 0 ? Color.Success : Color.Error)">
                                        @(activity.XpChange > 0 ? "+" : "")@activity.XpChange XP
                                    </MudText>
                                }
                                @if (activity.CurrencyChange != 0)
                                {
                                    <MudText Typo="Typo.caption" Color="@(activity.CurrencyChange > 0 ? Color.Success : Color.Error)">
                                        @(activity.CurrencyChange > 0 ? "+" : "")@activity.CurrencyChange Cr
                                    </MudText>
                                }
                            </div>
                        </div>
                    </MudListItem>
                    <MudDivider />
                }
            </MudList>
            @if (profile.RecentActivity.Count > 10)
            {
                <div class="d-flex justify-center mt-4">
                    <MudPagination Color="Color.Primary" Count="@((int)Math.Ceiling((double)profile.RecentActivity.Count / 10))" Selected="@currentPage" SelectedChanged="PageChanged" />
                </div>
            }
        }
        else
        {
            <MudText Typo="Typo.body2" Align="Align.Center" Class="py-4 text-muted">@Loc["NoRecentActivity"]</MudText>
        }

        @* 6. ACTIONS & DÉCONNEXION *@
        <div class="mt-8 d-flex flex-column gap-2">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Lock" OnClick="ChangePassword" FullWidth="true">
                @Loc["ChangePassword"]
            </MudButton>

            <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Logout" OnClick="Logout" FullWidth="true">
                @Loc["Logout"]
            </MudButton>

            @* Zone de danger (Suppression) *@
            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error" OnClick="DeleteAccount">@Loc["DeleteAccount"]</MudButton>
        </div>
    }

</MudContainer>

@code {
    private UserProfileDetailsDto? profile;
    private bool isLoading = true;
    private int currentPage = 1;

    private void PageChanged(int i)
    {
        currentPage = i;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadProfile();
    }

    private async Task LoadProfile()
    {
        try
        {
            isLoading = true;
            profile = await Http.GetFromJsonAsync<UserProfileDetailsDto>("api/users/profile-details");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur chargement profil : {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Logout()
    {
        await TokenService.RemoveTokenAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private async Task EditName()
    {
        if (profile == null) return;

        var model = new UpdateUserNameDto
        {
            FirstName = profile.FirstName,
            Username = profile.Username
        };

        var parameters = new DialogParameters<DialogEditName> { { x => x.Model, model } };
        var dialog = await DialogService.ShowAsync<DialogEditName>(Loc["EditNameDialogTitle"], parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var updatedModel = (UpdateUserNameDto)result.Data;
            try
            {
                var response = await Http.PutAsJsonAsync("api/users/profile/name", updatedModel);
                if (response.IsSuccessStatusCode)
                {
                    profile = await response.Content.ReadFromJsonAsync<UserProfileDetailsDto>();
                    Snackbar.Add(Loc["ProfileUpdated"], Severity.Success);
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"Erreur : {error}", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task EditEmail()
    {
        if (profile == null) return;

        var model = new UpdateUserEmailDto { NewEmail = profile.Email };

        var parameters = new DialogParameters<DialogEditEmail> { { x => x.Model, model } };
        var dialog = await DialogService.ShowAsync<DialogEditEmail>(Loc["EditEmailDialogTitle"], parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var updatedModel = (UpdateUserEmailDto)result.Data;
            try
            {
                var response = await Http.PutAsJsonAsync("api/users/profile/email", updatedModel);
                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add(Loc["EmailUpdated"], Severity.Success);
                    await Logout(); // Force logout for re-confirmation
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"Erreur : {error}", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task ChangePassword()
    {
        var model = new ChangePasswordDto();
        var parameters = new DialogParameters<DialogChangePassword> { { x => x.Model, model } };
        var dialog = await DialogService.ShowAsync<DialogChangePassword>(Loc["ChangePasswordDialogTitle"], parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var updatedModel = (ChangePasswordDto)result.Data;
            try
            {
                var response = await Http.PutAsJsonAsync("api/users/profile/password", updatedModel);
                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add(Loc["PasswordUpdated"], Severity.Success);
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"Erreur : {error}", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task DeleteAccount()
    {
        var parameters = new DialogParameters<DialogConfirmation>
        {
            { x => x.ContentText, Loc["ConfirmDeleteAccountMessage"] },
            { x => x.ButtonText, Loc["ConfirmDeleteButton"] },
            { x => x.Color, Color.Error }
        };

        var dialog = await DialogService.ShowAsync<DialogConfirmation>(Loc["DeleteAccountDialogTitle"], parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            try
            {
                var response = await Http.DeleteAsync("api/users/me");
                if (response.IsSuccessStatusCode)
                {
                    await Logout();
                }
                else
                {
                    Snackbar.Add(Loc["DeleteError"], Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Erreur API : {ex.Message}");
            }
        }
    }
}