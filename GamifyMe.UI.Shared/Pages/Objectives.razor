@page "/objectives"

@attribute [Authorize]
@using GamifyMe.Shared.Dtos
@using GamifyMe.UI.Shared.Helpers
@using GamifyMe.UI.Shared.Components
@inject HttpClient Http
@using System.Net.Http.Json
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDialogService DialogService
@implements IDisposable


<PageTitle>Mes Objectifs</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4 mb-16">

    <MudText Typo="Typo.h4" Class="mb-6" Color="Color.Primary">Objectifs Disponibles</MudText>

    @if (isLoading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="ma-auto d-block" />
    }
    else if (objectives == null || !objectives.Any())
    {
        <MudAlert Severity="Severity.Info">Aucun objectif disponible pour le moment.</MudAlert>
    }
    else
    {
        <MudGrid>
            @foreach (var obj in objectives)
            {
                var isCooldown = obj.IsAlreadyCompleted && obj.NextAvailableDate.HasValue && obj.NextAvailableDate > DateTime.UtcNow;
                var isExpiring = obj.ExpirationDate.HasValue && obj.ExpirationDate > DateTime.UtcNow;
                
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Elevation="3" Class="h-100 d-flex flex-column cursor-pointer hover-effect" 
                             Style="@(isCooldown ? "opacity: 0.6; filter: grayscale(100%); cursor: not-allowed;" : "")"
                             @onclick="@(() => OpenDetails(obj))">
                        <MudCardHeader>
                            <CardHeaderAvatar>
                                <MudAvatar Color="@(string.IsNullOrEmpty(obj.Color) ? Color.Primary : Color.Default)" Variant="Variant.Filled" Style="@(!string.IsNullOrEmpty(obj.Color) ? $"background-color:{obj.Color};" : "")">
                                    <MudIcon Icon="@IconLibrary.GetIcon(obj.IconName)" />
                                </MudAvatar>
                            </CardHeaderAvatar>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">@obj.Title</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @if (obj.EventDate.HasValue)
                                    {
                                        <div class="d-flex align-center">
                                            <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" Class="mr-1" />
                                            <span>@obj.EventDate.Value.ToString("g")</span>
                                        </div>
                                    }

                                    @if (obj.EndDate.HasValue)
                                    {
                                        <div class="d-flex align-center mt-1">
                                            <MudIcon Icon="@Icons.Material.Filled.Timer" Size="Size.Small" Class="mr-1" />
                                            <span>Fin : @obj.EndDate.Value.ToString("g")</span>
                                        </div>
                                    }
                                </MudText>
                            </CardHeaderContent>
                            <CardHeaderActions>
                                @if (obj.IsUnique)
                                {
                                    <MudTooltip Text="Objectif Unique">
                                        <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" />
                                    </MudTooltip>
                                }
                            </CardHeaderActions>
                        </MudCardHeader>

                        <MudCardContent Class="flex-grow-1">
                            <MudText Typo="Typo.body2" Class="mb-2 description-clamp">@obj.Description</MudText>

                            @if (!string.IsNullOrEmpty(obj.Location))
                            {
                                <div class="d-flex align-center mt-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" Color="Color.Default"
                                        Class="mr-1" />
                                    <MudText Typo="Typo.caption">@obj.Location</MudText>
                                </div>
                            }

                            @if (isExpiring)
                            {
                                var timeToLive = obj.ExpirationDate!.Value - DateTime.UtcNow;
                                <div class="d-flex align-center mt-2">
                                    <MudIcon Icon="@Icons.Material.Filled.HourglassBottom" Color="Color.Warning" Size="Size.Small" Class="mr-1" />
                                    <MudText Typo="Typo.caption" Color="Color.Warning">
                                        Disparaît dans : @timeToLive.ToString(@"hh\:mm\:ss")
                                    </MudText>
                                </div>
                            }
                            
                            @if (isCooldown)
                            {
                                var timeLeft = obj.NextAvailableDate!.Value - DateTime.UtcNow;
                                <div class="d-flex align-center mt-3 justify-center pa-2" style="background-color: rgba(0,0,0,0.05); border-radius: 4px; border: 1px solid var(--mud-palette-error);">
                                    <MudIcon Icon="@Icons.Material.Filled.Timer" Color="Color.Error" Size="Size.Small" Class="mr-2"/>
                                    <MudText Typo="Typo.body2" Color="Color.Error" Style="font-weight:bold;">
                                        Disponible dans : @timeLeft.ToString(@"hh\:mm\:ss")
                                    </MudText>
                                </div>
                            }
                        </MudCardContent>

                        <MudCardActions Class="d-flex justify-end pa-3 bg-gray-light">
                            <MudChip T="string" Icon="@Icons.Material.Filled.Bolt" Color="Color.Warning" Size="Size.Small">
                                +@obj.XpReward XP</MudChip>
                            <MudChip T="string" Icon="@Icons.Material.Filled.MonetizationOn" Color="Color.Info"
                                Size="Size.Small">+@obj.DocPointsReward Crédits</MudChip>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

<style>
    .hover-effect {
        transition: transform 0.2s;
    }
    .hover-effect:hover {
        transform: translateY(-5px);
    }
    .description-clamp {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>

@code {
    private List<ObjectiveDto> objectives = new();
    private bool isLoading = true;
    private System.Timers.Timer? _timer;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

            if (authState.User.Identity != null && authState.User.Identity.IsAuthenticated)
            {
                await LoadObjectives();
                StartTimer();
            }
            else
            {
                isLoading = false;
            }

            StateHasChanged();
        }
    }

    public void Dispose()
    {
        _timer?.Stop();
        _timer?.Dispose();
    }

    private void StartTimer()
    {
        _timer = new System.Timers.Timer(1000);
        _timer.Elapsed += (s, e) => InvokeAsync(StateHasChanged);
        _timer.AutoReset = true;
        _timer.Start();
    }

    private async Task LoadObjectives()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            objectives = await Http.GetFromJsonAsync<List<ObjectiveDto>>("api/objectives/active") ?? new List<ObjectiveDto>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur chargement objectifs : {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenDetails(ObjectiveDto obj)
    {
        if (obj.IsAlreadyCompleted && obj.NextAvailableDate.HasValue && obj.NextAvailableDate > DateTime.UtcNow) return;

        var parameters = new DialogParameters<ObjectiveDetailsDialog> { { x => x.Objective, obj } };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        DialogService.Show<ObjectiveDetailsDialog>("Détails de l'objectif", parameters, options);
    }
}