@page "/"
@attribute [Authorize]
@using System.Net.Http.Json
@using MudBlazor
@using GamifyMe.Shared.Dtos
@using Microsoft.AspNetCore.Components

@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Accueil</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-16">
    <MudText Typo="Typo.h4" GutterBottom="true" Color="Color.Primary" Class="mb-2">Bienvenue @firstName</MudText>
    <MudText Typo="Typo.body1" Class="mb-8 text-secondary">Atteignez vos objectifs, faites les valider par le staff et gagnez des crédits à dépenser dans la boutique !</MudText>
    <MudGrid Class="mb-8" Spacing="2">
        <!-- Mon Pass Card -->
        <MudItem xs="6" sm="4">
            <MudCard Elevation="3" Class="cursor-pointer hover-effect h-100" @onclick="@(() => Navigation.NavigateTo("/my-qrcode"))">
                <MudCardContent Class="d-flex flex-column align-center home-card-content">
                    <MudIcon Icon="@Icons.Material.Filled.QrCode2" Color="Color.Primary" Class="mb-2 home-card-icon" />
                    <MudText Typo="Typo.subtitle1" Align="Align.Center" Style="font-weight:bold; line-height: 1.2;">Mon Pass</MudText>
                    <MudText Typo="Typo.caption" Align="Align.Center" Class="mt-1 d-none d-sm-block">Accéder à mon QR code</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <!-- Objectifs Card -->
        <MudItem xs="6" sm="4">
            <MudCard Elevation="3" Class="cursor-pointer hover-effect h-100" @onclick="@(() => Navigation.NavigateTo("/objectives"))">
                <MudCardContent Class="d-flex flex-column align-center home-card-content">
                    <MudIcon Icon="@Icons.Material.Filled.Assignment" Color="Color.Secondary" Class="mb-2 home-card-icon" />
                    <MudText Typo="Typo.subtitle1" Align="Align.Center" Style="font-weight:bold; line-height: 1.2;">Objectifs</MudText>
                    <MudText Typo="Typo.caption" Align="Align.Center" Class="mt-1 d-none d-sm-block">@objectiveCount objectifs disponibles</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <!-- Boutique Card -->
        <MudItem xs="6" sm="4">
            <MudCard Elevation="3" Class="cursor-pointer hover-effect h-100" @onclick="@(() => Navigation.NavigateTo("/store"))">
                <MudCardContent Class="d-flex flex-column align-center home-card-content">
                    <MudIcon Icon="@Icons.Material.Filled.Store" Color="Color.Success" Class="mb-2 home-card-icon" />
                    <MudText Typo="Typo.subtitle1" Align="Align.Center" Style="font-weight:bold; line-height: 1.2;">Boutique</MudText>
                    <MudText Typo="Typo.caption" Align="Align.Center" Class="mt-1 d-none d-sm-block">@storeItemCount articles en boutique</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <!-- Inventaire Card -->
        <MudItem xs="6" sm="4">
            <MudCard Elevation="3" Class="cursor-pointer hover-effect h-100" @onclick="@(() => Navigation.NavigateTo("/inventory"))">
                <MudCardContent Class="d-flex flex-column align-center home-card-content">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory" Color="Color.Info" Class="mb-2 home-card-icon" />
                    <MudText Typo="Typo.subtitle1" Align="Align.Center" Style="font-weight:bold; line-height: 1.2;">Inventaire</MudText>
                    <MudText Typo="Typo.caption" Align="Align.Center" Class="mt-1 d-none d-sm-block">@inventoryCount éléments possédés</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <!-- Groupes Card -->
        <MudItem xs="6" sm="4">
            <MudCard Elevation="3" Class="cursor-pointer hover-effect h-100" @onclick="@(() => Navigation.NavigateTo("/groups"))">
                <MudCardContent Class="d-flex flex-column align-center home-card-content">
                    <MudIcon Icon="@Icons.Material.Filled.Groups" Color="Color.Tertiary" Class="mb-2 home-card-icon" />
                    <MudText Typo="Typo.subtitle1" Align="Align.Center" Style="font-weight:bold; line-height: 1.2;">Groupes</MudText>
                    <MudText Typo="Typo.caption" Align="Align.Center" Class="mt-1 d-none d-sm-block">Rejoindre ou voir mon groupe</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <!-- Classements Card -->
        <MudItem xs="6" sm="4">
            <MudCard Elevation="3" Class="cursor-pointer hover-effect h-100" @onclick="@(() => Navigation.NavigateTo("/leaderboard"))">
                <MudCardContent Class="d-flex flex-column align-center home-card-content">
                    <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Warning" Class="mb-2 home-card-icon" />
                    <MudText Typo="Typo.subtitle1" Align="Align.Center" Style="font-weight:bold; line-height: 1.2;">Classements</MudText>
                    <MudText Typo="Typo.caption" Align="Align.Center" Class="mt-1 d-none d-sm-block">Voir les meilleurs scores</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>

    </MudGrid>
</MudContainer>

<style>
    .hover-effect { transition: transform 0.2s; }
    .hover-effect:hover { transform: translateY(-5px); }

    /* Mobile Styles (Default) */
    .home-card-content {
        padding: 12px !important;
    }
    .home-card-icon {
        font-size: 2.5rem !important;
    }

    /* Desktop/Tablet Styles */
    @@media (min-width: 600px) {
        .home-card-content {
            padding: 32px !important;
        }
        .home-card-icon {
            font-size: 4rem !important;
        }
    }
</style>

@code {
    private int objectiveCount;
    private int storeItemCount;
    private int inventoryCount;
    private string firstName = "";

    protected override async Task OnInitializedAsync()
    {
        try 
        {
            var profile = await Http.GetFromJsonAsync<UserProfileDetailsDto>("api/users/profile-details");
            firstName = profile?.FirstName ?? "Invité";
        }
        catch
        {
            // Fallback to claims if API fails
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            firstName = user.FindFirst("FirstName")?.Value 
                        ?? user.Identity?.Name 
                        ?? "Invité";
        }
        
        StateHasChanged();
        
        await LoadCounts();
    }

    private async Task LoadCounts()
    {
        try
        {
            var objectives = await Http.GetFromJsonAsync<List<ObjectiveDto>>("api/objectives/active");
            objectiveCount = objectives?.Count ?? 0;
        }
        catch
        {
            objectiveCount = 0;
        }

        try
        {
            var storeItems = await Http.GetFromJsonAsync<List<StoreItemDto>>("api/store/active");
            storeItemCount = storeItems?.Count ?? 0;
        }
        catch
        {
            storeItemCount = 0;
        }

        try
        {
            var inventory = await Http.GetFromJsonAsync<List<UserInventoryDto>>("api/users/inventory");
            inventoryCount = inventory?.Count ?? 0;
        }
        catch
        {
            inventoryCount = 0;
        }
    }
}
