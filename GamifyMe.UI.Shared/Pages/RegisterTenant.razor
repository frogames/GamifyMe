@page "/register-tenant"
@layout GamifyMe.UI.Shared.Layout.LandingLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using GamifyMe.Shared.Dtos
@using GamifyMe.UI.Shared.Services
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject TokenStorageService TokenService

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center mud-width-full" Style="height: 100vh;">
    <MudPaper Elevation="3" Class="pa-8" Width="100%">
        <MudText Typo="Typo.h4" GutterBottom="true" Align="Align.Center">Commencer avec MeritoPass</MudText>
        <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="mb-4">@GetPlanName()</MudText>

        <EditForm Model="@model" OnValidSubmit="OnValidSubmit">
            <DataAnnotationsValidator />

            <MudTextField Label="Nom de votre établissement" @bind-Value="model.EstablishmentName"
                          For="@(() => model.EstablishmentName)" Variant="Variant.Outlined" Class="mb-4" />

            <MudDivider Class="my-4" />
            <MudText Typo="Typo.subtitle2" Class="mb-2">Administrateur</MudText>

            <MudTextField Label="Prénom" @bind-Value="model.AdminFirstName"
                          For="@(() => model.AdminFirstName)" Variant="Variant.Outlined" Class="mb-4" />

            <MudTextField Label="Email" @bind-Value="model.AdminEmail"
                          For="@(() => model.AdminEmail)" Variant="Variant.Outlined" Class="mb-4" />

            <MudTextField Label="Mot de passe" @bind-Value="model.AdminPassword"
                          For="@(() => model.AdminPassword)" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-6" />

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       Size="Size.Large" Disabled="@_processing">
                @if (_processing)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">Création...</MudText>
                }
                else
                {
                    <MudText>@(_planId != "evaluation" ? "Valider & Payer" : "Créer mon compte")</MudText>
                }
            </MudButton>
        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    private CreateTenantDto model = new CreateTenantDto();
    private bool _processing = false;
    private string _planId = "evaluation";

    private class RegisterTenantResponse
    {
        public string Token { get; set; } = string.Empty;
        public Guid EstablishmentId { get; set; }
        public Guid UserId { get; set; }
        public bool RequirePayment { get; set; }
    }

    private string _billingCycle = "monthly"; // "monthly" or "yearly"

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        _planId = query["plan"] ?? "evaluation";
        _billingCycle = query["billing"] ?? "monthly";
        model.PlanId = _planId;
    }

    private string GetPlanName()
    {
        bool isYearly = _billingCycle == "yearly";
        switch (_planId)
        {
            case "standard": return isYearly ? "Offre Standard (390€ HT/an)" : "Offre Standard (39€ HT/mois)";
            case "corporate": return isYearly ? "Offre Corporate (1980€ HT/an)" : "Offre Corporate (198€ HT/mois)";
            default: return "Offre Evaluation (Gratuit)";
        }
    }

    private async Task OnValidSubmit()
    {
        _processing = true;
        try
        {
            model.PlanId = _planId; // Ensure it's set
            var response = await Http.PostAsJsonAsync("api/users/register-tenant", model);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<RegisterTenantResponse>();
                if (result != null)
                {
                    // Store Token
                    await TokenService.SetTokenAsync(result.Token);
                    
                    if (result.RequirePayment)
                    {
                        // Redirect to Stripe
                        await InitiateStripeCheckout();
                    }
                    else
                    {
                        // Free plan -> Go to Dashboard
                        Snackbar.Add("Compte créé avec succès !", Severity.Success);
                        Navigation.NavigateTo("/admin/dashboard");
                    }
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Erreur : {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur technique : {ex.Message}", Severity.Error);
        }
        finally
        {
            _processing = false;
        }
    }

    private async Task InitiateStripeCheckout()
    {
        try
        {
            // Pass plan and billing interval
            var request = new { PlanType = _planId, Interval = _billingCycle };
            var response = await Http.PostAsJsonAsync("api/billing/create-checkout-session", request);
            if (response.IsSuccessStatusCode)
            {
               var json = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>();
               if (json != null && json.ContainsKey("url"))
               {
                   Navigation.NavigateTo(json["url"], forceLoad: true);
               }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Erreur Stripe : {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
             Snackbar.Add($"Erreur redirection paiement : {ex.Message}", Severity.Error);
        }
    }
}
