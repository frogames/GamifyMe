@page "/my-qrcode"
@using GamifyMe.Shared.Dtos
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

@implements IDisposable
@inject IDialogService DialogService
@inject GamifyMe.UI.Shared.Services.UserStateService UserStateService

<PageTitle>Mon Pass</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8 mb-16 d-flex flex-column align-center">

    <MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-2">Mon Pass</MudText>
    <MudText Typo="Typo.body1" Class="mb-8 text-muted">Présentez ce code pour valider vos objectifs.</MudText>

    @if (isLoading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else if (profile != null)
    {
        string color = "000000";
        string bgcolor = "FFFFFF";

        if (profile.ActiveQrCodeStyle == "QR_STYLE_GOLD")
        {
            color = "000000";
            bgcolor = "D4AF37";
        }
        else if (profile.ActiveQrCodeStyle == "QR_STYLE_INVERTED")
        {
            color = "FFFFFF";
            bgcolor = "000000";
        }

        string qrUrl = $"https://api.qrserver.com/v1/create-qr-code/?size=300x300&data={profile.QrCode}&color={color}&bgcolor={bgcolor}";
        string style = $"width: 100%; max-width: 350px; background-color: #{bgcolor}; color: {(bgcolor == "000000" ? "white" : "black")}; border: 1px solid #e0e0e0;";

        <MudCard Elevation="4" Class="pa-8 d-flex flex-column align-center rounded-xl" Style="@style">

            <MudImage Src="@qrUrl" Alt="QR Code" Class="mb-6 rounded-lg" Style="width: 250px; height: 250px;" />

            <MudText Typo="Typo.h5" Class="mb-1" Style="@($"color: {(bgcolor == "000000" ? "white" : "black")}; font-weight: bold;")">@profile.FirstName @profile.Username</MudText>
            <MudText Typo="Typo.body2" Class="mb-6" Style="@($"color: {(bgcolor == "000000" ? "rgba(255,255,255,0.7)" : "rgba(0,0,0,0.6)")};")">@profile.EstablishmentName</MudText>

            <div class="d-flex gap-4 w-100">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Print"
                           OnClick="PrintCard"
                           FullWidth="true">
                    Imprimer
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Share"
                           OnClick="ShareCard"
                           FullWidth="true">
                    Partager
                </MudButton>
            </div>

        </MudCard>
    }
    else
    {
        <MudAlert Severity="Severity.Error">Impossible de charger votre pass.</MudAlert>
    }
</MudContainer>

@code {
    private UserProfileDetailsDto? profile;
    private bool isLoading = true;
    private System.Threading.Timer? _timer;
    private DateTime _lastPollTime = DateTime.UtcNow;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            profile = await Http.GetFromJsonAsync<UserProfileDetailsDto>("api/users/profile-details");
            
            // Start polling (every 3 seconds)
            _timer = new System.Threading.Timer(async _ => await PollUpdates(), null, 3000, 3000);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task PollUpdates()
    {
        try
        {
            // Use local variable to avoid race conditions if poll takes long (though single threaded context mostly)
            var checkTime = _lastPollTime;
            
            // We ask for updates SINCE last poll time
            var url = $"api/users/updates?since={checkTime.ToString("o")}";
            var updates = await Http.GetFromJsonAsync<List<UserUpdateDto>>(url);

            if (updates != null && updates.Any())
            {
                // Update last poll time to the most recent event + 1 tick to avoid duplicate
                _lastPollTime = updates.Max(u => u.Date).AddTicks(1);

                // Show feedback for each update
                foreach (var update in updates)
                {
                    await InvokeAsync(async () => 
                    {
                        await ShowFeedbackDialog(update);
                        UserStateService.NotifyUserDataChanged(); // Refresh Top Bar
                    });
                }
            }
            else
            {
                 // If nothing found, simply advance the window to "now" to avoid querying too far back later
                 _lastPollTime = DateTime.UtcNow;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Polling error: {ex.Message}");
        }
    }

    private async Task ShowFeedbackDialog(UserUpdateDto update)
    {
        string icon = update.Type == "Validation" ? Icons.Material.Filled.EmojiEvents : Icons.Material.Filled.ShoppingBag;
        Color color = update.Type == "Validation" ? Color.Warning : Color.Info;

        var parameters = new DialogParameters();
        
        var result = await DialogService.ShowMessageBox(
            update.Title, 
            (MarkupString)$"{update.Message}<br/><br/>{(update.XpGained > 0 ? $"<b>+{update.XpGained} XP</b>" : "")}{(update.CurrencyGained > 0 ? $" &nbsp; <b>+{update.CurrencyGained} Crédits</b>" : "")}", 
            yesText: "Génial !", cancelText: null, options: new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
    }

    private async Task PrintCard()
    {
        await JSRuntime.InvokeVoidAsync("print");
    }

    private async Task ShareCard()
    {
        if (profile == null) return;

        string color = "000000";
        string bgcolor = "FFFFFF";

        if (profile.ActiveQrCodeStyle == "QR_STYLE_GOLD")
        {
            color = "000000";
            bgcolor = "D4AF37";
        }
        else if (profile.ActiveQrCodeStyle == "QR_STYLE_INVERTED")
        {
            color = "FFFFFF";
            bgcolor = "000000";
        }

        string qrImageUrl = $"https://api.qrserver.com/v1/create-qr-code/?size=300x300&data={profile.QrCode}&color={color}&bgcolor={bgcolor}";

        await JSRuntime.InvokeVoidAsync("window.shareQrImage",
            "Mon Pass GamifyMe",
            $"Voici mon code joueur pour {profile.FirstName} {profile.Username}",
            qrImageUrl);
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}