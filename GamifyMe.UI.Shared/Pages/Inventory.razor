@page "/inventory"
@using GamifyMe.Shared.Dtos
@using GamifyMe.UI.Shared.Helpers
@using GamifyMe.UI.Shared.Components
@using System.Net.Http.Json
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject GamifyMe.UI.Shared.Services.ThemeService ThemeService
@inject IDialogService DialogService

<PageTitle>Mon Inventaire</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4 mb-16">
    <div class="d-flex justify-space-between align-center mb-6">
        <MudText Typo="Typo.h4" Color="Color.Primary">Mon Inventaire</MudText>
    </div>

    @if (isLoading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="ma-auto d-block" />
    }
    else if (inventoryItems == null || !inventoryItems.Any())
    {
        <MudAlert Severity="Severity.Info">Votre inventaire est vide. Achetez des objets dans la boutique !</MudAlert>
    }
    else
    {
        <MudExpansionPanels MultiExpansion="true">
            <MudExpansionPanel Text="@($"Objets Physiques ({PhysicalItems.Count()})")" Expanded="false">
                @if (PhysicalItems.Any())
                {
                    <div class="horizontal-scroll-container mb-2">
                        @foreach (var item in PhysicalItems)
                        {
                            <InventoryItemCard Item="item" OnClick="@(() => OpenItemDetails(item))" />
                        }
                    </div>
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="pa-4 text-muted">Aucun objet physique.</MudText>
                }
            </MudExpansionPanel>

            <MudExpansionPanel Text="@($"Interfaces ({InterfaceItems.Count()})")" Expanded="false">
                @if (InterfaceItems.Any())
                {
                    <div class="horizontal-scroll-container mb-2">
                        @foreach (var item in InterfaceItems)
                        {
                            <InventoryItemCard Item="item" OnClick="@(() => OpenItemDetails(item))" />
                        }
                    </div>
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="pa-4 text-muted">Aucune interface.</MudText>
                }
            </MudExpansionPanel>

            <MudExpansionPanel Text="@($"Sons ({SoundItems.Count()})")" Expanded="false">
                @if (SoundItems.Any())
                {
                    <div class="horizontal-scroll-container mb-2">
                        @foreach (var item in SoundItems)
                        {
                            <InventoryItemCard Item="item" OnClick="@(() => OpenItemDetails(item))" />
                        }
                    </div>
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="pa-4 text-muted">Aucun son.</MudText>
                }
            </MudExpansionPanel>

            <MudExpansionPanel Text="@($"Styles QR Code ({QrCodeItems.Count()})")" Expanded="false">
                @if (QrCodeItems.Any())
                {
                    <div class="horizontal-scroll-container mb-2">
                        @foreach (var item in QrCodeItems)
                        {
                            <InventoryItemCard Item="item" OnClick="@(() => OpenItemDetails(item))" />
                        }
                    </div>
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="pa-4 text-muted">Aucun style QR code.</MudText>
                }
            </MudExpansionPanel>


        </MudExpansionPanels>
    }
</MudContainer>

<style>
    .horizontal-scroll-container {
        display: flex;
        overflow-x: auto;
        gap: 16px;
        padding-bottom: 8px; /* Space for scrollbar */
        scrollbar-width: thin; /* Firefox */
    }
    
    .horizontal-scroll-container::-webkit-scrollbar {
        height: 8px;
    }
    
    .horizontal-scroll-container::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 4px;
    }
    
    .horizontal-scroll-container::-webkit-scrollbar-thumb {
        background: #888;
        border-radius: 4px;
    }
    
    .horizontal-scroll-container::-webkit-scrollbar-thumb:hover {
        background: #555;
    }

    .inventory-card {
        min-width: 160px;
        width: 160px;
        flex-shrink: 0;
        cursor: pointer;
        transition: transform 0.2s;
    }

    .inventory-card:hover {
        transform: translateY(-5px);
    }
</style>

@code {
    private List<UserInventoryDto> inventoryItems = new();
    private bool isLoading = true;

    private IEnumerable<UserInventoryDto> PhysicalItems => GetSortedItems(inventoryItems.Where(i => i.ItemType == "Physical"));
    
    private IEnumerable<UserInventoryDto> InterfaceItems => GetSortedItems(inventoryItems.Where(i => i.ItemType == "Digital" && 
                                                                           i.DigitalActionCode != null && 
                                                                           i.DigitalActionCode.StartsWith("UI_THEME_", StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<UserInventoryDto> SoundItems => GetSortedItems(inventoryItems.Where(i => i.ItemType == "Digital" && 
                                                                           i.DigitalActionCode == "SCAN_SOUND"));

    private IEnumerable<UserInventoryDto> QrCodeItems => GetSortedItems(inventoryItems.Where(i => i.ItemType == "Digital" && 
                                                                           i.DigitalActionCode != null && 
                                                                           i.DigitalActionCode.StartsWith("QR_STYLE_", StringComparison.OrdinalIgnoreCase)));
                                                                           
    private IEnumerable<UserInventoryDto> BoostItems => GetSortedItems(inventoryItems.Where(i => i.ItemType == "Digital" && 
                                                                          i.DigitalActionCode != null && 
                                                                          i.DigitalActionCode.Contains("BOOST", StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<UserInventoryDto> GetSortedItems(IEnumerable<UserInventoryDto> items)
    {
        return items.OrderByDescending(i => i.IsActive)
                    .ThenByDescending(i => i.AcquiredDate);
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadInventory();
    }

    private async Task LoadInventory()
    {
        isLoading = true;
        try
        {
            inventoryItems = await Http.GetFromJsonAsync<List<UserInventoryDto>>("api/users/inventory") ?? new List<UserInventoryDto>();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur de chargement : {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OpenItemDetails(UserInventoryDto item)
    {
        var parameters = new DialogParameters<InventoryItemDetailsDialog> 
        { 
            { x => x.Item, item },
            { x => x.OnPlaySound, EventCallback.Factory.Create<string>(this, PreviewSound) }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        
        var dialog = DialogService.Show<InventoryItemDetailsDialog>("Détails", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is bool confirmed && confirmed)
        {
            await ToggleItem(item);
        }
    }

    private async Task ToggleItem(UserInventoryDto item)
    {
        try
        {
            var response = await Http.PostAsync($"api/users/inventory/{item.Id}/toggle", null);
            if (response.IsSuccessStatusCode)
            {
                await LoadInventory();
                Snackbar.Add("Inventaire mis à jour", Severity.Success);
                
                // Play sound if we just equipped a sound item
                if (!item.IsActive && item.DigitalActionCode == "SCAN_SOUND" && !string.IsNullOrEmpty(item.DigitalAssetUrl))
                {
                    await PreviewSound(item.DigitalAssetUrl);
                }

                // Update Theme if we toggled a UI Theme
                if (item.DigitalActionCode != null && item.DigitalActionCode.StartsWith("UI_THEME_"))
                {
                    if (!item.IsActive) // Was inactive, now active (logic inverted because we reload inventory after, but here we use the old item state)
                    {
                        ThemeService.SetTheme(item.DigitalActionCode);
                    }
                    else // Was active, now inactive
                    {
                        ThemeService.SetTheme(GamifyMe.Shared.Constants.ThemeConstants.Default);
                    }
                }
            }
            else
            {
                Snackbar.Add("Erreur lors de la mise à jour", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
    }

    private async Task PreviewSound(string? url)
    {
        if (string.IsNullOrEmpty(url)) return;
        try
        {
            if (!url.StartsWith("http") && Http.BaseAddress != null)
            {
                url = new Uri(Http.BaseAddress, url).ToString();
            }
            await JSRuntime.InvokeVoidAsync("eval", $"new Audio('{url}').play()");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error playing sound: {ex.Message}");
            Snackbar.Add("Impossible de lire l'audio", Severity.Error);
        }
    }
}
