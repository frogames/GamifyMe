@page "/devhome"
@layout GamifyMe.UI.Shared.Layout.LandingLayout
@attribute [AllowAnonymous]
@using MudBlazor

<PageTitle>MeritoPass - Gamifiez votre établissement</PageTitle>

<style>
    /* Charte Graphique MeritoPass */
    :root {
        --mp-bleu-nuit: #1A2B4C;
        --mp-orange-vif: #FFA400;
        --mp-vert-menthe: #CBF7ED;
        --mp-bleu-ardoise: #8EA8C3;
        --mp-vieux-rose: #B15E6C;
    }
    
    .mp-title { color: var(--mp-bleu-nuit); font-family: 'Poppins', sans-serif; }
    .mp-text { color: var(--mp-bleu-nuit); opacity: 0.9; font-family: 'Inter', sans-serif; font-size: 16px; }
    .mp-cta { 
        background: var(--mp-orange-vif) !important; 
        color: var(--mp-bleu-nuit) !important; 
        font-weight: bold !important;
        border-radius: 50px !important;
    }
    .mp-cta:hover { 
        background: #FF9500 !important; 
    }
    .mp-section-zen { background-color: var(--mp-vert-menthe); border-radius: 20px; }
    .mp-section-dark { background-color: var(--mp-bleu-nuit); color: white; border-radius: 20px; }
</style>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-16 mb-16 px-4">

    @* HERO SECTION - Fond Blanc, Titre Bleu Nuit, CTA Orange *@
    <section class="d-flex flex-column align-center justify-center text-center py-16" style="background: white;">
        <MudText Typo="Typo.h2" Class="mp-title mb-6" Style="font-weight: 800; line-height: 1.2;">
            Engagez votre communauté<br />
            <span style="border-bottom: 6px solid var(--mp-vert-menthe); display: inline-block;">grâce à la Gamification</span>
        </MudText>
        <MudText Typo="Typo.h6" Class="mp-text mb-8" Style="max-width: 800px;">
            Transformez l'expérience de vos membres. Définissez des objectifs, récompensez les accomplissements et créez une dynamique unique au sein de votre établissement.
        </MudText>
        <div class="d-flex gap-4 flex-wrap justify-center">
            <MudButton Variant="Variant.Filled" Size="Size.Large" Class="mp-cta px-8 py-3" Href="/register">Commencer gratuitement</MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Large" Class="rounded-pill px-8 py-3" Style="color: var(--mp-bleu-nuit); border-color: var(--mp-bleu-nuit);">Voir la démo</MudButton>
        </div>
        
        @* Hero Image Placeholder - Style Corporate Memphis *@
        <MudPaper Elevation="0" Class="mt-16 overflow-hidden" Style="border-radius: 20px; width: 100%; max-width: 1000px; aspect-ratio: 16/9; background: linear-gradient(135deg, var(--mp-vert-menthe) 0%, var(--mp-bleu-ardoise) 100%); display: flex; align-items: center; justify-content: center; position: relative;">
            @* Floating geometric shapes *@
            <div style="position: absolute; top: 20%; left: 10%; width: 60px; height: 60px; background: var(--mp-orange-vif); opacity: 0.3; transform: rotate(45deg);"></div>
            <div style="position: absolute; bottom: 15%; right: 15%; width: 40px; height: 40px; border: 4px solid var(--mp-bleu-nuit); opacity: 0.4; border-radius: 50%;"></div>
            <MudText Typo="Typo.h5" Class="mp-title" Style="opacity: 0.6; text-align: center; padding: 20px;">[Illustration Corporate Memphis:<br/>Personnage tenant un téléphone géant,<br/>en train de scanner un QR Code hexagonal]</MudText>
        </MudPaper>
    </section>

    @* FEATURES SECTION - Fond Blanc, Cartes avec bordure légère *@
    <section id="features" class="py-16">
        <div class="text-center mb-16">
            <MudText Typo="Typo.caption" Style="font-weight: bold; letter-spacing: 1.5px; color: var(--mp-orange-vif);">FONCTIONNALITÉS</MudText>
            <MudText Typo="Typo.h3" Class="mp-title mt-2" Style="font-weight: 700;">Tout pour gérer votre gamification</MudText>
        </div>

        <MudGrid Spacing="4">
            <MudItem xs="12" sm="4">
                <MudPaper Elevation="1" Class="pa-8 d-flex flex-column align-center text-center h-100" Style="background-color: white; border-left: 4px solid var(--mp-orange-vif); border-radius: 8px;">
                    <div style="width: 80px; height: 80px; background: var(--mp-vert-menthe); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                        <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Size="Size.Large" Style="color: var(--mp-bleu-nuit);" />
                    </div>
                    <MudText Typo="Typo.h6" Class="mp-title mb-2">Objectifs & Badges</MudText>
                    <MudText Typo="Typo.body2" Class="mp-text">Créez des défis sur mesure et récompensez vos utilisateurs avec des badges exclusifs.</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Elevation="1" Class="pa-8 d-flex flex-column align-center text-center h-100" Style="background-color: white; border-left: 4px solid var(--mp-vieux-rose); border-radius: 8px;">
                    <div style="width: 80px; height: 80px; background: var(--mp-vert-menthe); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                        <MudIcon Icon="@Icons.Material.Filled.Store" Size="Size.Large" Style="color: var(--mp-bleu-nuit);" />
                    </div>
                    <MudText Typo="Typo.h6" Class="mp-title mb-2">Boutique de Récompenses</MudText>
                    <MudText Typo="Typo.body2" Class="mp-text">Permettez aux utilisateurs de dépenser leurs crédits gagnés contre des avantages réels ou virtuels.</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Elevation="1" Class="pa-8 d-flex flex-column align-center text-center h-100" Style="background-color: white; border-left: 4px solid var(--mp-bleu-ardoise); border-radius: 8px;">
                    <div style="width: 80px; height: 80px; background: var(--mp-vert-menthe); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                        <MudIcon Icon="@Icons.Material.Filled.QrCodeScanner" Size="Size.Large" Style="color: var(--mp-bleu-nuit);" />
                    </div>
                    <MudText Typo="Typo.h6" Class="mp-title mb-2">Validation par QR Code</MudText>
                    <MudText Typo="Typo.body2" Class="mp-text">Un système simple pour votre staff : scannez le QR code de l'utilisateur pour valider ses actions.</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </section>

    @* SOCIAL PROOF - Fond Vert Menthe (Zen) *@
    <section id="reviews" class="py-16 px-4 mp-section-zen">
        <div class="text-center mb-12">
            <MudText Typo="Typo.h4" Class="mp-title" Style="font-weight: 700;">Ils nous font confiance</MudText>
        </div>
        
        <MudGrid Class="px-4">
            <MudItem xs="12" md="6">
                <MudPaper Elevation="2" Class="pa-6" Style="background: white; border-radius: 12px;">
                    <div class="d-flex mb-4">
                        <MudRating ReadOnly="true" SelectedValue="5" Color="Color.Warning" />
                    </div>
                    <MudText Typo="Typo.body1" Class="mp-text mb-4" Style="font-style: italic; line-height: 1.6;">"MeritoPass a complètement changé l'ambiance dans notre salle de sport. Les adhérents sont plus motivés que jamais !"</MudText>
                    <div class="d-flex align-center">
                        <div style="width: 50px; height: 50px; background: var(--mp-vieux-rose); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 15px; font-weight: bold; color: white;">TD</div>
                        <div>
                            <MudText Typo="Typo.subtitle2" Class="mp-title">Thomas D.</MudText>
                            <MudText Typo="Typo.caption" Class="mp-text">Gérant, FitLife Gym</MudText>
                        </div>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudPaper Elevation="2" Class="pa-6" Style="background: white; border-radius: 12px;">
                    <div class="d-flex mb-4">
                        <MudRating ReadOnly="true" SelectedValue="5" Color="Color.Warning" />
                    </div>
                    <MudText Typo="Typo.body1" Class="mp-text mb-4" Style="font-style: italic; line-height: 1.6;">"Un outil incroyable pour fidéliser nos étudiants. La mise en place a été super rapide."</MudText>
                    <div class="d-flex align-center">
                        <div style="width: 50px; height: 50px; background: var(--mp-bleu-ardoise); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 15px; font-weight: bold; color: white;">SL</div>
                        <div>
                            <MudText Typo="Typo.subtitle2" Class="mp-title">Sarah L.</MudText>
                            <MudText Typo="Typo.caption" Class="mp-text">Directrice, StudyHub</MudText>
                        </div>
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </section>

    @* PRICING - Fond Bleu Nuit (Sérieux/Dark Mode) *@
    <section id="pricing" class="py-16 px-4 mp-section-dark mt-16">
        <div class="text-center mb-8">
            <MudText Typo="Typo.h3" Style="font-weight: 700; color: white;">De la simple découverte au réseau complet</MudText>
            <MudText Typo="Typo.subtitle1" Style="color: rgba(255,255,255,0.7);" Class="mb-6">Toutes les fonctionnalités sont incluses dans chaque offre.<br/>La différence ? Le nombre d'utilisateurs.</MudText>
            
            @* Billing Toggle *@
            <div style="display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px; max-width: 500px; margin: 0 auto;">
                <MudText Align="Align.End" Style="@($"color: {(!_isAnnual ? "white" : "rgba(255,255,255,0.5)")}; font-weight: bold;")">Mensuel</MudText>
                <div class="d-flex justify-center">
                    <MudSwitch T="bool" @bind-Value="_isAnnual" Color="Color.Secondary" Style="transform: scale(1.2); margin: 0;" />
                </div>
                <MudText Align="Align.Start" Style="@($"color: {(_isAnnual ? "white" : "rgba(255,255,255,0.5)")}; font-weight: bold;")">Annuel <span style="background: var(--mp-orange-vif); color: var(--mp-bleu-nuit); font-size: 0.7rem; padding: 2px 6px; border-radius: 4px; vertical-align: middle; margin-left: 4px;">-16%</span></MudText>
            </div>
             <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.6);" Class="mt-4 d-block">
                @(_isAnnual 
                    ? "Facturé annuellement à la date anniversaire. Sans engagement. Paiement en début de période." 
                    : "Facturé mensuellement à la date anniversaire. Sans engagement. Paiement en début de période.")
            </MudText>
        </div>

        <MudGrid Class="justify-center" Spacing="4">
            @* Evaluation Plan *@
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="3" Class="pa-8 d-flex flex-column h-100" Style="border-radius: 16px; background: white;">
                    <MudText Typo="Typo.h5" Class="mp-title mb-2">Evaluation</MudText>
                    <MudText Typo="Typo.h3" Class="mp-title" Style="font-weight: 800;">0€<span style="font-size: 1rem; font-weight: normal; opacity: 0.6;"> HT</span></MudText>
                    <MudText Typo="Typo.caption" Class="mp-text" Style="opacity: 0.6;">&nbsp;</MudText>
                    <MudText Typo="Typo.body2" Class="mp-text mb-6 mt-2" Style="opacity: 0.7;">Idéal pour tester l'engagement.</MudText>
                    
                    <MudDivider Class="mb-4" />

                    @* Feature List *@
                    <MudList T="string" Dense="true" Class="mb-auto">
                        <MudListItem Icon="@Icons.Material.Filled.Person" Style="color: var(--mp-orange-vif); font-weight: bold; background-color: rgba(255, 164, 0, 0.1); border-radius: 8px;">15 utilisateurs max</MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.QrCodeScanner" Style="color: var(--mp-bleu-nuit);">Validation par Scan</MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.EmojiEvents" Style="color: var(--mp-bleu-nuit);">Système d'Objectifs</MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Store" Style="color: var(--mp-bleu-nuit);">Boutique & Inventaire</MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Group" Style="color: var(--mp-bleu-nuit);">Groupes & Classements</MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Shield" Style="color: var(--mp-bleu-nuit);">Système de Badges</MudListItem>
                    </MudList>
                    
                    <MudButton Variant="Variant.Outlined" FullWidth="true" Class="mt-8 py-2" Style="border-color: var(--mp-bleu-nuit); color: var(--mp-bleu-nuit); border-radius: 8px;" Href="/register-tenant?plan=evaluation">Commencer</MudButton>
                </MudPaper>
            </MudItem>
            
            @* Standard Plan *@
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="12" Class="pa-8 d-flex flex-column h-100 position-relative" Style="border-radius: 16px; border: 3px solid var(--mp-orange-vif); background: white;">
                    <div style="position: absolute; top: -15px; left: 50%; transform: translateX(-50%); background: var(--mp-orange-vif); color: var(--mp-bleu-nuit); padding: 6px 16px; border-radius: 20px; font-size: 0.75rem; font-weight: bold;">POPULAIRE</div>
                    <MudText Typo="Typo.h5" Class="mp-title mb-2" Style="margin-top: 10px;">Standard</MudText>
                    <div class="d-flex align-baseline">
                         <MudText Typo="Typo.h3" Class="mp-title" Style="font-weight: 800;">@(_isAnnual ? "390€" : "39€")<span style="font-size: 1rem; font-weight: normal; opacity: 0.6;"> HT /@(_isAnnual ? "an" : "mois")</span></MudText>
                    </div>
                     <MudText Typo="Typo.caption" Class="mp-text" Style="opacity: 0.6; color: var(--mp-orange-vif);">
                        @(_isAnnual ? "Soit 32,50€/mois (2 mois offerts)" : "Facturation mensuelle")
                    </MudText>
                    
                    <MudText Typo="Typo.body2" Class="mp-text mb-6 mt-2" Style="opacity: 0.7;">Pour les établissements en croissance.</MudText>
                    
                    <MudDivider Class="mb-4" />

                    <MudList T="string" Dense="true" Class="mb-auto">
                        <MudListItem Icon="@Icons.Material.Filled.Person" Style="color: var(--mp-orange-vif); font-weight: bold; background-color: rgba(255, 164, 0, 0.1); border-radius: 8px;">300 utilisateurs max</MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.QrCodeScanner" Style="color: var(--mp-bleu-nuit);">Validation par Scan</MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.EmojiEvents" Style="color: var(--mp-bleu-nuit);">Système d'Objectifs</MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Store" Style="color: var(--mp-bleu-nuit);">Boutique & Inventaire</MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Group" Style="color: var(--mp-bleu-nuit);">Groupes & Classements</MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Shield" Style="color: var(--mp-bleu-nuit);">Système de Badges</MudListItem>
                    </MudList>
                    
                    <MudButton Variant="Variant.Filled" FullWidth="true" Class="mp-cta mt-8 py-2" Href="@($"/register-tenant?plan=standard&billing={(_isAnnual ? "yearly" : "monthly")}")">Choisir</MudButton>
                </MudPaper>
            </MudItem>
            
            @* Corporate Plan *@
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="3" Class="pa-8 d-flex flex-column h-100" Style="border-radius: 16px; background: white;">
                    <MudText Typo="Typo.h5" Class="mp-title mb-2">Corporate</MudText>
                     <div class="d-flex align-baseline">
                         <MudText Typo="Typo.h3" Class="mp-title" Style="font-weight: 800;">@(_isAnnual ? "1980€" : "198€")<span style="font-size: 1rem; font-weight: normal; opacity: 0.6;"> HT /@(_isAnnual ? "an" : "mois")</span></MudText>
                    </div>
                     <MudText Typo="Typo.caption" Class="mp-text" Style="opacity: 0.6; color: var(--mp-orange-vif);">
                        @(_isAnnual ? "Soit 165€/mois (2 mois offerts)" : "Facturation mensuelle")
                    </MudText>
                    
                    <MudText Typo="Typo.body2" Class="mp-text mb-6 mt-2" Style="opacity: 0.7;">Pour les grandes structures.</MudText>
                    
                    <MudDivider Class="mb-4" />

                    <MudList T="string" Dense="true" Class="mb-auto">
                        <MudListItem Icon="@Icons.Material.Filled.Person" Style="color: var(--mp-orange-vif); font-weight: bold; background-color: rgba(255, 164, 0, 0.1); border-radius: 8px;">3000 utilisateurs max</MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.QrCodeScanner" Style="color: var(--mp-bleu-nuit);">Validation par Scan</MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.EmojiEvents" Style="color: var(--mp-bleu-nuit);">Système d'Objectifs</MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Store" Style="color: var(--mp-bleu-nuit);">Boutique & Inventaire</MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Group" Style="color: var(--mp-bleu-nuit);">Groupes & Classements</MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Shield" Style="color: var(--mp-bleu-nuit);">Système de Badges</MudListItem>
                    </MudList>
                    
                    <MudButton Variant="Variant.Outlined" FullWidth="true" Class="mt-8 py-2" Style="border-color: var(--mp-bleu-nuit); color: var(--mp-bleu-nuit); border-radius: 8px;" Href="@($"/register-tenant?plan=corporate&billing={(_isAnnual ? "yearly" : "monthly")}")">Choisir</MudButton>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </section>

</MudContainer>

@code {
    private bool _isAnnual = false;
}
