@using GamifyMe.Shared.Dtos
@using GamifyMe.UI.Shared.Helpers
@using MudBlazor
@inject HttpClient Http

<MudDialog Class="custom-dialog-content">
    <DialogContent>
        <div class="d-flex flex-column align-center pa-4">
             <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Style="width: 80px; height: 80px; font-size: 2rem;">
                @if (!string.IsNullOrEmpty(PlayerDetails.FirstName))
                {
                    @PlayerDetails.FirstName.Substring(0, 1).ToUpper()
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Person" />
                }
            </MudAvatar>
            
            <MudText Typo="Typo.h5" Class="mt-3 mb-1" Style="font-weight: bold;">@PlayerDetails.FirstName @PlayerDetails.LastName</MudText>
            
            @if (PlayerDetails.RegistrationDate.HasValue)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">Membre depuis le @PlayerDetails.RegistrationDate.Value.ToString("d")</MudText>
            }

            @if (!string.IsNullOrEmpty(PlayerDetails.GroupName))
            {
                <div class="d-flex align-center mt-2 pa-2 rounded" style="background-color: #f5f5f5;">
                     @if (!string.IsNullOrEmpty(PlayerDetails.GroupImageUrl))
                     {
                          <MudAvatar Size="Size.Small" Class="mr-2">
                               <MudImage Src="@GetImageSrc(PlayerDetails.GroupImageUrl)" ObjectFit="ObjectFit.Cover" Class="rounded-circle" Style="width:100%;height:100%"/>
                          </MudAvatar>
                     }
                     else
                     {
                         <MudIcon Icon="@IconLibrary.GetIcon(PlayerDetails.GroupIcon)" Size="Size.Small" Style="@(!string.IsNullOrEmpty(PlayerDetails.GroupColor) ? $"color:{PlayerDetails.GroupColor};" : "")" Class="mr-2" />
                     }
                     <MudText Typo="Typo.body2" Style="font-weight:bold;">@PlayerDetails.GroupName</MudText>
                </div>
            }

            <div class="d-flex gap-4 mt-4 w-100 justify-center">
                 <MudPaper Elevation="0" Class="d-flex flex-column align-center pa-3" Style="background-color: #f5f5f5; min-width: 100px;">
                     <MudText Typo="Typo.h6" Color="Color.Warning" Style="font-weight: bold;">@PlayerDetails.TotalXp</MudText>
                     <MudText Typo="Typo.caption">XP Total</MudText>
                 </MudPaper>
                 <MudPaper Elevation="0" Class="d-flex flex-column align-center pa-3" Style="background-color: #f5f5f5; min-width: 100px;">
                     <MudText Typo="Typo.h6" Color="Color.Success" Style="font-weight: bold;">@PlayerDetails.TotalCurrency</MudText>
                     <MudText Typo="Typo.caption">Crédits</MudText>
                 </MudPaper>
            </div>

            @if (PlayerDetails.PrincipalStreaks != null && PlayerDetails.PrincipalStreaks.Any())
            {
                <MudDivider Class="my-4 w-100" />
                <MudText Typo="Typo.subtitle1" Class="align-self-start mb-2" Style="font-weight: bold;">🔥 Séries en cours (Objectifs Principaux)</MudText>
                
                <div class="w-100 d-flex flex-column gap-2">
                    @foreach (var streak in PlayerDetails.PrincipalStreaks)
                    {
                        <div class="d-flex align-center justify-space-between pa-2" style="background-color: #fff3e0; border-radius: 8px;">
                            <div class="d-flex align-center">
                                <MudIcon Icon="@IconLibrary.GetIcon(streak.IconName)" Color="Color.Warning" Size="Size.Small" Class="mr-2" />
                                <MudText Typo="Typo.body2">@streak.ObjectiveTitle</MudText>
                            </div>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.LocalFireDepartment" Color="Color.Warning" Size="Size.Small" />
                                <MudText Typo="Typo.subtitle2" Color="Color.Warning" Class="ml-1" Style="font-weight: bold;">@streak.CurrentStreak</MudText>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                 <MudDivider Class="my-4 w-100" />
                 <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2 text-center">Aucune série active sur les objectifs principaux.</MudText>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Color="Color.Primary">Fermer</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public PlayerDetailsDto PlayerDetails { get; set; } = new();

    private string GetImageSrc(string imageUrl)
    {
        if (string.IsNullOrEmpty(imageUrl)) return "";
        return $"{Http.BaseAddress}{imageUrl.TrimStart('/')}?v={Guid.NewGuid()}";
    }

    private void Close() => MudDialog.Close();
}
