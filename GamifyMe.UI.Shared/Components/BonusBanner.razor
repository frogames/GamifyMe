@using GamifyMe.Shared.Dtos
@using System.Net.Http.Json
@using GamifyMe.UI.Shared.Helpers
@inject HttpClient Http
@implements IDisposable

@if (activeBonus != null)
{
    <div class="bonus-banner d-flex justify-center align-center pa-2">
        <MudIcon Icon="@GetIcon()" Class="mr-2 pulse-animation" Size="Size.Large" />
        <div class="d-flex flex-column align-center">
             <MudText Typo="Typo.h6" Class="pulse-text" Align="Align.Center">@activeBonus.Name</MudText>
             <MudText Typo="Typo.body2" Class="pulse-text" Align="Align.Center" Style="font-size: 0.8rem;">@GetBonusDescription()</MudText>
        </div>
        <MudIcon Icon="@GetIcon()" Class="ml-2 pulse-animation" Size="Size.Large" />
    </div>

    <style>
        .bonus-banner {
            background: linear-gradient(45deg, #ff357a, #fff172);
            color: #000;
            box-shadow: 0 4px 15px rgba(255, 53, 122, 0.4);
            position: sticky;
            top: 0;
            z-index: 10; /* Lower than MudDrawer (typically 1100+) */
            width: 100%;
            border-radius: 0 0 16px 16px;
        }

        @@media (max-width: 600px) {
            .bonus-banner h6 {
                font-size: 0.9rem !important;
            }
            .bonus-banner .mud-icon-root {
                font-size: 1.25rem !important;
            }
        }

        @@keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); } /* Reduced pulse scale for mobile comfort */
            100% { transform: scale(1); }
        }

        .pulse-animation {
            animation: pulse 1.5s infinite;
        }
        
        .pulse-text {
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
    </style>
}

@code {
    private BonusPeriodDto? activeBonus;
    private System.Timers.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await LoadBonus();
    }

    public void Dispose()
    {
        _timer?.Stop();
        _timer?.Dispose();
    }

    private void StartTimer()
    {
        _timer = new System.Timers.Timer(1000);
        _timer.Elapsed += (s, e) => InvokeAsync(StateHasChanged);
        _timer.AutoReset = true;
        _timer.Start();
    }

    private async Task LoadBonus()
    {
        try
        {
            var response = await Http.GetAsync("api/bonus-periods/current");
            if (response.StatusCode == System.Net.HttpStatusCode.NoContent)
            {
                activeBonus = null;
            }
            else if (response.IsSuccessStatusCode)
            {
                activeBonus = await response.Content.ReadFromJsonAsync<BonusPeriodDto>();
                if (activeBonus != null)
                {
                    StartTimer();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading bonus: {ex.Message}");
        }
    }

    private string GetIcon()
    {
        return activeBonus?.Type == GamifyMe.Shared.Models.BonusType.Xp 
            ? Icons.Material.Filled.Star 
            : Icons.Material.Filled.AttachMoney;
    }

    private string GetMultiplierText()
    {
        if (activeBonus == null) return "";
        return activeBonus.Type == GamifyMe.Shared.Models.BonusType.Xp 
            ? $"XP x{activeBonus.Multiplier}" 
            : $"Monnaie x{activeBonus.Multiplier}";
    }

    private string GetBonusDescription()
    {
        if (activeBonus == null) return "";

        var typeStr = activeBonus.Type == GamifyMe.Shared.Models.BonusType.Xp ? "XP" : "Crédits";
        var multipliedStr = activeBonus.Type == GamifyMe.Shared.Models.BonusType.Xp ? "multipliée" : "multipliés";
        
        var remaining = activeBonus.EndDate - DateTime.UtcNow;
        
        string timeStr;
        if (remaining.TotalHours > 24)
        {
            timeStr = $"{remaining.Days} jours et {remaining.Hours} heures";
        }
        else if (remaining.TotalHours >= 1)
        {
             timeStr = $"{remaining.Hours} heures et {remaining.Minutes} minutes";
        }
        else
        {
            timeStr = $"{remaining.Minutes} minutes";
        }

        return $"{typeStr} {multipliedStr} par {activeBonus.Multiplier} pendant encore {timeStr} !";
    }
}
