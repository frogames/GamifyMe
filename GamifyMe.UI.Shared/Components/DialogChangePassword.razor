@using GamifyMe.Shared.Dtos
@using MudBlazor
@using System.ComponentModel.DataAnnotations

<MudDialog>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="@success">
            <MudTextField @bind-Value="Model.OldPassword" Label="Ancien mot de passe" InputType="InputType.Password" Required="true" />
            <MudTextField @bind-Value="Model.NewPassword" Label="Nouveau mot de passe" InputType="InputType.Password" Required="true" 
                          Validation="@(new Func<string, IEnumerable<string>>(PasswordStrength))"/>
            <MudTextField @bind-Value="Model.ConfirmNewPassword" Label="Confirmer le mot de passe" InputType="InputType.Password" Required="true"
                          Validation="@(new Func<string, string>(PasswordMatch))"/>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Annuler</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" Disabled="@(!success)">Changer le mot de passe</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public ChangePasswordDto Model { get; set; } = new();

    bool success;
    MudForm form;

    private IEnumerable<string> PasswordStrength(string pw)
    {
        if (string.IsNullOrWhiteSpace(pw))
        {
            yield return "Le mot de passe est requis";
            yield break;
        }
        if (pw.Length < 6)
            yield return "Le mot de passe doit contenir au moins 6 caractères";
    }

    private string PasswordMatch(string arg)
    {
        if (Model.NewPassword != arg)
            return "Les mots de passe ne correspondent pas";
        return null;
    }

    void Submit() => MudDialog.Close(DialogResult.Ok(Model));
    void Cancel() => MudDialog.Cancel();
}
