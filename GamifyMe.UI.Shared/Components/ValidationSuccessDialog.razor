@using GamifyMe.Shared.Dtos
@using GamifyMe.Shared.Models
@using MudBlazor

@using GamifyMe.UI.Shared.Components.Dialogs

<CelebrationDialog Title="Félicitations !">
    <!-- Message -->
    <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-6" Style="font-weight: 500; opacity: 0.9; color: var(--mud-palette-text-primary);">
        @Response.Message
    </MudText>

    <!-- Rewards (XP & Currency) -->
    @if (Response.RewardXp > 0 || Response.RewardCurrency > 0)
    {
        <div class="d-flex justify-center flex-wrap gap-4 mb-6 w-100">
                @if (Response.RewardXp > 0)
                {
                <div class="d-flex flex-column align-center pa-2" style="border: 1px solid var(--mud-palette-warning); border-radius: 12px; min-width: 100px;">
                        <MudIcon Icon="@Icons.Material.Filled.Bolt" Color="Color.Warning" Size="Size.Medium" Class="mb-1" />
                        <MudText Typo="Typo.h5" Style="font-weight: 900; color: var(--mud-palette-warning); line-height: 1;">+@Response.RewardXp</MudText>
                        <MudText Typo="Typo.caption" Style="text-transform: uppercase; opacity: 0.7;">XP</MudText>
                </div>
                }
                @if (Response.RewardCurrency > 0)
                {
                <div class="d-flex flex-column align-center pa-2" style="border: 1px solid var(--mud-palette-info); border-radius: 12px; min-width: 100px;">
                        <MudIcon Icon="@Icons.Material.Filled.MonetizationOn" Color="Color.Info" Size="Size.Medium" Class="mb-1" />
                        <MudText Typo="Typo.h5" Style="font-weight: 900; color: var(--mud-palette-info); line-height: 1;">+@Response.RewardCurrency</MudText>
                        <MudText Typo="Typo.caption" Style="text-transform: uppercase; opacity: 0.7;">@CurrencyName</MudText>
                </div>
                }
        </div>
    }

    <!-- Unlocks (Badges & Objectives) -->
    @if ((Response.NewAvailableBadges != null && Response.NewAvailableBadges.Any()) || (Response.NewAvailableObjectives != null && Response.NewAvailableObjectives.Any()))
    {
        <div class="w-100 mt-2 mb-4">
            @if (Response.NewAvailableBadges != null && Response.NewAvailableBadges.Any())
            {
                <MudText Typo="Typo.overline" Align="Align.Center" Class="mb-2 d-block" Color="Color.Secondary">Badges Débloqués</MudText>
                @foreach (var badge in Response.NewAvailableBadges)
                {
                    <div class="d-flex align-center pa-2 mb-2 rounded" style="background-color: var(--mud-palette-background-grey);">
                        <MudIcon Icon="@(!string.IsNullOrEmpty(badge.IconName) ? badge.IconName : Icons.Material.Filled.MilitaryTech)" Class="mr-3" Size="Size.Medium" Color="Color.Warning" />
                        <div>
                            <MudText Typo="Typo.subtitle2" Style="font-weight: bold; line-height: 1.2;">@badge.Name</MudText>
                            <MudText Typo="Typo.caption">Nouveau badge acquis !</MudText>
                        </div>
                    </div>
                }
            }

            @if (Response.NewAvailableObjectives != null && Response.NewAvailableObjectives.Any())
            {
                    <MudText Typo="Typo.overline" Align="Align.Center" Class="mt-3 mb-2 d-block" Color="Color.Info">Nouvelles opportunités</MudText>
                    @foreach (var obj in Response.NewAvailableObjectives)
                {
                    <div class="d-flex align-center pa-2 mb-2 rounded" style="background-color: var(--mud-palette-background-grey);">
                        <MudIcon Icon="@(!string.IsNullOrEmpty(obj.IconName) ? obj.IconName : Icons.Material.Filled.Star)" Class="mr-3" Size="Size.Medium" Color="Color.Info" />
                        <div>
                            <MudText Typo="Typo.subtitle2" Style="font-weight: bold; line-height: 1.2;">@obj.Title</MudText>
                            <MudText Typo="Typo.caption">Débloqué !</MudText>
                        </div>
                    </div>
                }
            }
        </div>
    }

    <!-- Action Button -->
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" OnClick="Close" Class="mt-4 rounded-lg">
        Génial !
    </MudButton>

</CelebrationDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public ValidationResponseDto Response { get; set; }
    [Parameter] public string CurrencyName { get; set; } = "Crédits";

    private void Close() => MudDialog.Close(DialogResult.Ok(true));
}
