@using MudBlazor

<style>
    .celebration-dialog {
        animation: boing 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
        transform-origin: center;
    }

    @@keyframes boing {
        0% {
            transform: scale(0.8);
            opacity: 0;
        }
        40% {
            transform: scale(1.1);
            opacity: 1;
        }
        70% {
            transform: scale(0.95);
        }
        100% {
            transform: scale(1);
        }
    }
</style>

<MudDialog Class="celebration-dialog" ContentClass="pa-0" Style="border-radius: 16px; overflow: hidden;">
    <DialogContent>
        <div style="position: relative; width: 100%; height: 200px;">
            <MudImage Src="/img/celebration_header.png" ObjectFit="ObjectFit.Cover" Style="width: 100%; height: 100%;" />
            <div style="position: absolute; bottom: 0; left: 0; right: 0; background: linear-gradient(to top, rgba(0,0,0,0.7), transparent); padding: 1rem; text-align: center;">
                <MudText Typo="Typo.h5" Style="color: white; font-weight: bold; text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">@Title</MudText>
            </div>
        </div>
        
        <div class="pa-4 d-flex flex-column align-center text-center">
            @ChildContent
        </div>

    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }

    [Parameter] public string Title { get; set; } = "Félicitations !";
    [Parameter] public RenderFragment ChildContent { get; set; }

    public void Close() => MudDialog.Close(DialogResult.Ok(true));
}
