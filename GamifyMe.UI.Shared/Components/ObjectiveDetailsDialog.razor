@using GamifyMe.Shared.Dtos
@using GamifyMe.Shared.Models
@using GamifyMe.UI.Shared.Helpers
@using MudBlazor
@using GamifyMe.UI.Shared.Components
@using Microsoft.AspNetCore.Components.Authorization

@inject AuthenticationStateProvider AuthenticationStateProvider

<MudDialog Class="custom-dialog-content" Style="background-color: transparent; box-shadow: none; overflow: visible;">
    <DialogContent>
        <style>
            .custom-dialog-content .mud-dialog-content {
                padding: 0 !important;
            }
        </style>
        @{
            var bgColor = !string.IsNullOrEmpty(Objective.Color) ? Objective.Color : "#ffffff";
            var textColor = ColorHelper.GetContrastColor(bgColor);
            var style = !string.IsNullOrEmpty(Objective.Color) ? $"background-color: {bgColor}; color: {textColor};" : "";
            var iconColor = textColor == "white" ? Color.Surface : Color.Default;
            var iconStyle = textColor == "white" ? "color: white;" : "";
        }

        <div class="pa-4" style="@($"border-radius: 8px; {style} min-width: 300px; cursor: pointer;")" @onclick="Cancel">
            <div class="d-flex flex-column align-center mb-4">
                <MudAvatar Color="@(string.IsNullOrEmpty(Objective.Color) ? Color.Primary : Color.Default)" Variant="Variant.Filled" Size="Size.Large" Class="mb-2" Style="@(!string.IsNullOrEmpty(Objective.Color) ? $"background-color:{Objective.Color}; width: 80px; height: 80px; filter: brightness(0.9);" : "width: 80px; height: 80px;")">
                    <GamifyIcon IconName="@Objective.IconName" Size="Size.Large" Style="font-size: 3rem; color: white;" />
                </MudAvatar>
                <MudText Typo="Typo.h5" Align="Align.Center" Style="@($"color: {textColor}; font-weight: bold;")">@Objective.Title</MudText>
                
                @if (Objective.ChainLength > 1)
                {
                    <div class="d-flex align-center mt-2 flex-column">
                         <MudProgressLinear Value="@((double)(Objective.ChainPosition ?? 0))" Max="@((double)(Objective.ChainLength ?? 1))" Rounded="true" Style="@($"height: 12px; width: 150px; border-radius: 6px; --mud-palette-primary: {textColor};")" Color="Color.Primary" />
                         <MudText Typo="Typo.caption" Class="mt-1" Style="@($"color: {textColor}; font-weight: bold;")">Étape @Objective.ChainPosition sur @Objective.ChainLength</MudText>
                    </div>
                }

                @if (Objective.IsUnique)
                {
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Class="mt-2">Objectif Unique</MudChip>
                }
            </div>

            <MudText Typo="Typo.body1" Class="mb-4 text-justify" Style="@($"color: {textColor};")">
                @Objective.Description
                <br /><br />

            </MudText>

            @if (Objective.UnlockedObjectiveTitles.Any() || (Objective.UnlockedBadges != null && Objective.UnlockedBadges.Any()))
            {
                <div class="mb-4 p-2" style="background-color: rgba(255,255,255,0.1); border-radius: 8px;">
                     <MudText Typo="Typo.subtitle2" Class="mb-1" Style="@($"color: {textColor}; font-weight: bold;")">Débloque :</MudText>
                     @foreach(var title in Objective.UnlockedObjectiveTitles)
                     {
                         <div class="d-flex align-center mb-1">
                             <MudIcon Icon="@Icons.Material.Filled.LockOpen" Size="Size.Small" Class="mr-2" Style="@iconStyle" />
                             <MudText Typo="Typo.body2" Style="@($"color: {textColor};")">Objectif : @title</MudText>
                         </div>
                     }
                     @foreach(var badge in Objective.UnlockedBadges)
                     {
                         <div class="d-flex align-center mb-1">
                             <MudIcon Icon="@Icons.Material.Filled.MilitaryTech" Size="Size.Small" Class="mr-2" Style="@iconStyle" />
                             <MudText Typo="Typo.body2" Style="@($"color: {textColor};")">Badge : @badge.Name</MudText>
                         </div>
                     }
                </div>
            }

            <MudDivider Class="mb-4" />

            <div class="d-flex flex-column gap-2">
                <div class="d-flex align-center flex-wrap">
                    @* Validation Methods Instructions *@
                    <div class="d-flex flex-column gap-2 mb-2">
                         <MudText Typo="Typo.subtitle2" Style="@($"color: {textColor}; font-weight: bold;")">Comment valider :</MudText>
                         
                         @if (Objective.AllowedValidationMethods.HasFlag(ValidationMethod.StaffScan))
                         {
                             <div class="d-flex align-center">
                                 <MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Small" Class="mr-2" Style="@iconStyle" />
                                 <MudText Typo="Typo.body2" Style="@($"color: {textColor};")">Présentez votre profil à un membre du staff.</MudText>
                             </div>
                         }
                         @if (Objective.AllowedValidationMethods.HasFlag(ValidationMethod.QrCode))
                         {
                             <div class="d-flex align-center">
                                 <MudIcon Icon="@Icons.Material.Filled.QrCode" Size="Size.Small" Class="mr-2" Style="@iconStyle" />
                                 <MudText Typo="Typo.body2" Style="@($"color: {textColor};")">Scannez le QR Code de l'objectif sur place.</MudText>
                             </div>
                         }
                         @if (Objective.AllowedValidationMethods.HasFlag(ValidationMethod.Self))
                         {
                             <div class="d-flex align-center">
                                 <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="mr-2" Style="@iconStyle" />
                                 <MudText Typo="Typo.body2" Style="@($"color: {textColor};")">Validez vous-même via le bouton ci-bas.</MudText>
                             </div>
                         }
                         @if (Objective.AllowedValidationMethods.HasFlag(ValidationMethod.PeerDuo))
                         {
                             <div class="d-flex align-center">
                                 <MudIcon Icon="@Icons.Material.Filled.Group" Size="Size.Small" Class="mr-2" Style="@iconStyle" />
                                 <MudText Typo="Typo.body2" Style="@($"color: {textColor};")">Faites scanner votre QR (Duo) par un partenaire.</MudText>
                             </div>
                         }
                         @if (Objective.AllowedValidationMethods.HasFlag(ValidationMethod.PeerCrowd))
                         {
                             <div class="d-flex align-center">
                                 <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" Class="mr-2" Style="@iconStyle" />
                                 <MudText Typo="Typo.body2" Style="@($"color: {textColor};")">Récoltez @(Objective.RequiredPeerValidations ?? 1) signatures d'autres joueurs.</MudText>
                             </div>
                         }
                    </div>
                </div>
                @if (Objective.EventDate.HasValue)
                {
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" Class="mr-2" Style="@iconStyle" />
                        <MudText Typo="Typo.body2" Style="@($"color: {textColor};")"><strong>Date :</strong> @Objective.EventDate.Value.ToString("g")</MudText>
                    </div>
                }

                @if (Objective.EndDate.HasValue)
                {
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Timer" Size="Size.Small" Class="mr-2" Style="@iconStyle" />
                        <MudText Typo="Typo.body2" Style="@($"color: {textColor};")"><strong>@GetTimeRemainingText(Objective.EndDate.Value)</strong></MudText>
                    </div>
                }

                 @if (!string.IsNullOrEmpty(Objective.Location))
                {
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" Class="mr-2" Style="@iconStyle" />
                        <MudText Typo="Typo.body2" Style="@($"color: {textColor};")"><strong>Lieu :</strong> @Objective.Location</MudText>
                    </div>
                }

                @if (Objective.FrequencyHours.HasValue && !Objective.IsUnique)
                {
                     <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Autorenew" Size="Size.Small" Class="mr-2" Style="@iconStyle" />
                         <MudText Typo="Typo.body2" Style="@($"color: {textColor};")">
                            <strong>Fréquence :</strong> Réalisable toutes les @FormatFrequency(Objective.FrequencyHours.Value)
                        </MudText>
                    </div>
                }

                @if (Objective.ExpirationDate.HasValue)
                {
                     <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.HourglassBottom" Size="Size.Small" Class="mr-2" Style="@iconStyle" />
                        <MudText Typo="Typo.body2" Style="@($"color: {textColor};")">
                             <strong>@GetTimeRemainingText(Objective.ExpirationDate.Value)</strong>
                        </MudText>
                    </div>
                }

                @if (!Objective.IsUnique)
                {
                    <div class="d-flex align-center mt-2">
                        <MudIcon Icon="@Icons.Material.Filled.Repeat" Size="Size.Small" Class="mr-2" Style="@iconStyle" />
                        <MudText Typo="Typo.body2" Style="@($"color: {textColor};")">
                             Validé <strong>@Objective.ValidationCount</strong> fois
                        </MudText>
                    </div>

                    @if (Objective.IsStreakEnabled)
                    {
                        <div class="d-flex align-center mt-2">
                            <MudIcon Icon="@Icons.Material.Filled.Loop" Size="Size.Small" Class="mr-2" Style="@iconStyle" />
                            <MudText Typo="Typo.body2" Style="@($"color: {textColor};")">
                                <strong>Série :</strong> Doit être validé @FormatStreakFrequency(Objective)
                            </MudText>
                        </div>
                    }

                    @if (Objective.IsStreakEnabled && Objective.CurrentStreak > 0)
                    {
                         <div class="d-flex align-center mt-4 px-3 py-2" style="background: rgba(255, 255, 255, 0.9); border-radius: 8px; width: fit-content; border: 1px solid #ff9800;">
                            <div class="d-flex align-center streak-badge" style="animation: pulse-orange 2s infinite;">
                                <MudIcon Icon="@Icons.Material.Filled.LocalFireDepartment" Size="Size.Small" Color="Color.Warning" Class="mr-2" />
                                <MudText Typo="Typo.subtitle2" Color="Color.Warning" Style="font-weight: bold; color: #ff9800 !important;">Série en cours : @Objective.CurrentStreak</MudText>
                            </div>
                         </div>
                    }
                }


                @if (Objective.AllowedValidationMethods.HasFlag(ValidationMethod.Self) && !Objective.IsAlreadyCompleted)
                {
                     <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" Class="mt-2" OnClick="ValidateSelf" Disabled="isValidating">
                        @if (isValidating) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                        Valider cet objectif
                     </MudButton>
                }

                @if (Objective.AllowedValidationMethods.HasFlag(ValidationMethod.QrCode) && !Objective.IsAlreadyCompleted)
                {
                     <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.QrCodeScanner" FullWidth="true" Class="mt-2" OnClick="ValidateQr" Disabled="isValidating">
                        Scanner le Code
                     </MudButton>
                }

                @if (Objective.AllowedValidationMethods.HasFlag(ValidationMethod.PeerDuo) && !Objective.IsAlreadyCompleted)
                {
                     <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.QrCode2" FullWidth="true" Class="mt-2" OnClick="@(() => GeneratePeerQr(ValidationMethod.PeerDuo))" Disabled="isValidating">
                        Générer QR (Duo)
                     </MudButton>
                }

                @if (Objective.AllowedValidationMethods.HasFlag(ValidationMethod.PeerCrowd) && !Objective.IsAlreadyCompleted)
                {
                     var required = Objective.RequiredPeerValidations ?? 1;
                     var current = Objective.CurrentPeerSignatures;
                     var progress = Math.Min(100, (double)current / required * 100);

                     <div class="mt-4 mb-2 pa-3" style="background: rgba(255,255,255,0.1); border-radius: 8px;">
                        <div class="d-flex justify-space-between align-center mb-1">
                             <MudText Typo="Typo.body2" Style="@($"color: {textColor};")">Signatures : <strong>@current / @required</strong></MudText>
                             <MudText Typo="Typo.caption" Style="@($"color: {textColor};")">@((int)progress)%</MudText>
                        </div>
                        <MudProgressLinear Color="Color.Success" Value="@progress" Class="my-2" Rounded="true" Size="Size.Large" Stripe="true" />
                        <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.7);">Faites scanner votre QR code par @(required - current) autres personnes.</MudText>
                     </div>

                     <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Groups" FullWidth="true" Class="mt-2" OnClick="@(() => GeneratePeerQr(ValidationMethod.PeerCrowd))" Disabled="isValidating">
                        Générer QR (Foule)
                     </MudButton>
                }
            </div>

            <style>
                @@keyframes pulse-orange {
                    0% { transform: scale(1); }
                    50% { transform: scale(1.05); }
                    100% { transform: scale(1); }
                }
            </style>
            
             <MudDivider Class="my-4" />
             <div class="d-flex justify-center gap-4">
                 <MudChip T="string" Icon="@Icons.Material.Filled.Bolt" Color="Color.Warning" Variant="Variant.Filled" Style="@(textColor == "white" ? "border: 1px solid white;" : "")">
                    +@(Objective.XpReward * Objective.ActiveMultiplier) XP
                </MudChip>
                @if (IsShopEnabled)
                {
                    <MudChip T="string" Icon="@Icons.Material.Filled.MonetizationOn" Color="Color.Info" Variant="Variant.Filled" Style="@(textColor == "white" ? "border: 1px solid white;" : "")">
                        +@Objective.DocPointsReward @CurrencyName
                    </MudChip>
                }
             </div>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Inject] ISnackbar Snackbar { get; set; }
    [Inject] HttpClient Http { get; set; }
    [Inject] IDialogService DialogService { get; set; }
    [Inject] IJSRuntime JSRuntime { get; set; }

    [Parameter] public ObjectiveDto Objective { get; set; }
    [Parameter] public bool IsShopEnabled { get; set; } = true;

    [Parameter] public string CurrencyName { get; set; } = "Crédits";

    private bool isValidating = false;

    private void Cancel() => MudDialog.Cancel();

    private async Task ValidateSelf()
    {
        isValidating = true;
        try
        {
            var response = await Http.PostAsync($"api/objectives/{Objective.Id}/validate-self", null);
            if (response.IsSuccessStatusCode)
            {
                 var result = await response.Content.ReadFromJsonAsync<ValidationResponseDto>();
                 await HandleSuccess(result);
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ValidationResponseDto>(); // Try read DTO first
                Snackbar.Add(error?.Message ?? "Erreur lors de la validation.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur technique: {ex.Message}", Severity.Error);
        }
        finally
        {
            isValidating = false;
        }
    }

    private async Task ValidateQr()
    {
        var options = new DialogOptions { FullScreen = true, CloseButton = true };
        var dialog = DialogService.Show<UserScanDialog>("Scanner", options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is string code)
        {
             isValidating = true;
             try
             {
                 var request = new QrValidationRequestDto { Content = code };
                 
                 // Auto-detect Method based on payload prefix
                 if (code.StartsWith("PEER_DUO|")) request.Method = ValidationMethod.PeerDuo;
                 else if (code.StartsWith("PEER_CROWD|")) request.Method = ValidationMethod.PeerCrowd;
                 else request.Method = ValidationMethod.QrCode;

                 var response = await Http.PostAsJsonAsync($"api/objectives/{Objective.Id}/validate-qr", request);
                 
                 if (response.IsSuccessStatusCode)
                 {
                     var resDto = await response.Content.ReadFromJsonAsync<ValidationResponseDto>();
                     await HandleSuccess(resDto);
                 }
                 else
                 {
                     try 
                     {
                        var error = await response.Content.ReadFromJsonAsync<ValidationResponseDto>();
                        Snackbar.Add(error?.Message ?? "QR Code invalide.", Severity.Error);
                     }
                     catch
                     {
                         Snackbar.Add("QR Code invalide ou erreur serveur.", Severity.Error);
                     }
                 }
             }
             catch (Exception ex)
             {
                 Snackbar.Add($"Erreur technique: {ex.Message}", Severity.Error);
             }
             finally
             {
                 isValidating = false;
             }
        }
    }

    private async Task GeneratePeerQr(ValidationMethod method)
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        
        if (string.IsNullOrEmpty(userId)) return;

        string prefix = method == ValidationMethod.PeerDuo ? "PEER_DUO" : "PEER_CROWD";
        string payload = $"{prefix}|{Objective.Id}|{userId}";
        string audience = method == ValidationMethod.PeerDuo ? "votre partenaire" : "un témoin";

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var parameters = new DialogParameters<QrDisplayDialog>
        {
            { x => x.QrData, payload },
            { x => x.TargetAudience, audience }
        };
        
        DialogService.Show<QrDisplayDialog>("Validation par les Pairs", parameters, options);
    }

    private async Task HandleSuccess(ValidationResponseDto? result)
    {
        if (result == null) return;
        
        // Play sound if available
        if (!string.IsNullOrEmpty(result.ScanSoundUrl))
        {
             try { await JSRuntime.InvokeVoidAsync("eval", $"new Audio('{result.ScanSoundUrl}').play()"); } catch {}
        }

        // Show "Congratulations" Dialog
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = false, NoHeader = true };
        var parameters = new DialogParameters<ValidationSuccessDialog>
        {
            { x => x.Response, result },
            { x => x.CurrencyName, CurrencyName }
        };
        
        await DialogService.Show<ValidationSuccessDialog>("Félicitations", parameters, options).Result;

        MudDialog.Close(DialogResult.Ok(true));
    }


    private string FormatFrequency(int hours)
    {
        if (hours <= 24) return $"{hours} heures";
        
        int days = hours / 24;
        int remHours = hours % 24;
        
        if (remHours > 0)
            return $"{days} jours et {remHours} heures";
        else
            return $"{days} jours";
    }

    private string GetTimeRemainingText(DateTime endDate)
    {
        var remaining = endDate - DateTime.UtcNow;
        if (remaining.TotalSeconds <= 0) return "Expiré";

        var sb = new System.Text.StringBuilder();
        sb.Append("cet objectif disparaitra dans ");

        var parts = new List<string>();

        if (remaining.Days > 0)
            parts.Add($"{remaining.Days} jour{(remaining.Days > 1 ? "s" : "")}");

        if (remaining.Hours > 0)
            parts.Add($"{remaining.Hours} heure{(remaining.Hours > 1 ? "s" : "")}");

        if (remaining.Minutes > 0 || parts.Count == 0)
            parts.Add($"{remaining.Minutes} minute{(remaining.Minutes > 1 ? "s" : "")}");

        if (parts.Count == 1)
        {
            sb.Append(parts[0]);
        }
        else if (parts.Count == 2)
        {
            sb.Append($"{parts[0]} et {parts[1]}");
        }
        else
        {
            sb.Append($"{parts[0]}, {parts[1]} et {parts[2]}");
        }
        
        return sb.ToString(); 
    }

    private string FormatStreakFrequency(ObjectiveDto obj)
    {
        switch (obj.StreakFrequency)
        {
            case StreakFrequency.Hourly:
                 return $"toutes les heures (max {obj.StreakTerminalHours}h)";
            case StreakFrequency.Daily:
                return "tous les jours";
            case StreakFrequency.Weekly:
                return "toutes les semaines";
            case StreakFrequency.Monthly:
                return "tous les mois";
            default:
                return "régulièrement";
        }
    }
}
