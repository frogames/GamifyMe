@using GamifyMe.Shared.Dtos
@using GamifyMe.UI.Shared.Helpers
@using MudBlazor

<MudCard Elevation="3" Class="inventory-card d-flex flex-column" @onclick="OnClick" Style="@($"background-color: {(string.IsNullOrEmpty(Item.Color) ? "var(--mud-palette-surface)" : Item.Color)};")">
    <div class="d-flex justify-center align-center pa-4"
         style="height: 120px;">
        <MudIcon Icon="@IconLibrary.GetIcon(Item.IconName)" 
                 Color="@(string.IsNullOrEmpty(Item.Color) ? (Item.IsActive ? Color.Success : Color.Default) : Color.Inherit)"
                 Style="@(!string.IsNullOrEmpty(Item.Color) ? $"color: {ColorHelper.GetContrastColor(Item.Color)}; font-size: 3rem;" : "font-size: 3rem;")" />
    </div>

    <MudCardContent Class="flex-grow-1 pt-2 px-3 pb-3">
        <MudText Typo="Typo.subtitle2" Align="Align.Center" Class="mb-1 text-truncate" Style="@($"font-weight:bold; color:{(string.IsNullOrEmpty(Item.Color) ? "inherit" : ColorHelper.GetContrastColor(Item.Color))}")">@Item.ItemName</MudText>
        
        <div class="d-flex justify-center">
            @if (Item.ItemType == "Physical")
            {
                if (Item.IsActive)
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled" Class="ma-0">Retiré</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled" Class="ma-0">À retirer</MudChip>
                }
            }
            else if (Item.IsActive)
            {
                if (Item.DigitalActionCode != null && Item.DigitalActionCode.Contains("BOOST", StringComparison.OrdinalIgnoreCase))
                {
                     <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Filled" Class="ma-0">En cours</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled" Class="ma-0">Actif</MudChip>
                }
            }
            else if (Item.ExpiresAt.HasValue && Item.ExpiresAt.Value < DateTime.UtcNow)
            {
                 <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled" Class="ma-0">Expiré</MudChip>
            }
        </div>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public UserInventoryDto Item { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
}
