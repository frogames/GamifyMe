@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Authorization
@using GamifyMe.UI.Shared.Layout
@using GamifyMe.UI.Shared.Components
@using System.Reflection

@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(MainLayout).Assembly" AdditionalAssemblies="@_additionalAssemblies">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="pa-4">Page introuvable</div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    [Parameter]
    public IEnumerable<string> AdditionalAssemblyNames { get; set; } = Array.Empty<string>();

    private IEnumerable<Assembly> _additionalAssemblies;

    protected override void OnInitialized()
    {
        var assemblies = new List<Assembly>();
        foreach (var name in AdditionalAssemblyNames)
        {
            try
            {
                // Tente de charger l'assembly par son nom
                var assembly = AppDomain.CurrentDomain.GetAssemblies().FirstOrDefault(a => a.GetName().Name == name);
                if (assembly != null)
                {
                    assemblies.Add(assembly);
                }
            }
            catch
            {
                // Ignore si l'assembly n'est pas trouvé (ex: code serveur sur le client)
            }
        }
        _additionalAssemblies = assemblies;
    }
}