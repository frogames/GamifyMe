@using Microsoft.Extensions.Localization
@using GamifyMe.UI.Shared.Services
@using GamifyMe.Shared.Dtos
@implements IDisposable
@inject NotificationService NotificationService
@inject IStringLocalizer<GamifyMe.UI.Shared.Resources.App> Loc

<MudNavMenu>
    <!-- Main navigation -->
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
        @Loc["Home"]
    </MudNavLink>
    <MudNavLink Href="my-qrcode" Icon="@Icons.Material.Filled.QrCode2">
        @Loc["MyPass"]
    </MudNavLink>
    
    <div class="d-flex align-center justify-space-between">
        <MudNavLink Href="objectives" Icon="@Icons.Material.Filled.Assignment" Class="flex-grow-1">
            @Loc["Objectives"]
        </MudNavLink>
        @if (NotificationService.NewObjectivesCount > 0)
        {
            <div class="notification-badge mr-3">@NotificationService.NewObjectivesCount</div>
        }
    </div>

    @if (UserStats?.IsShopEnabled ?? true)
    {
        <div class="d-flex align-center justify-space-between">
            <MudNavLink Href="store" Icon="@Icons.Material.Filled.Store" Class="flex-grow-1">
                @Loc["Store"]
            </MudNavLink>
            @if (NotificationService.NewStoreItemsCount > 0)
            {
                <div class="notification-badge mr-3">@NotificationService.NewStoreItemsCount</div>
            }
        </div>

        <MudNavLink Href="inventory" Icon="@Icons.Material.Filled.Inventory">
            @Loc["Inventory"]
        </MudNavLink>
    }


    
    @if (UserStats?.IsGroupsEnabled ?? true)
    {
        <div class="d-flex align-center justify-space-between">
            <MudNavLink Href="groups" Icon="@Icons.Material.Filled.Groups" Class="flex-grow-1">
                @Loc["Groups"]
            </MudNavLink>
            @if (NotificationService.NewGroupsCount > 0)
            {
                <div class="notification-badge mr-3">@NotificationService.NewGroupsCount</div>
            }
        </div>

        <MudNavLink Href="leaderboard" Icon="@Icons.Material.Filled.EmojiEvents">
            @Loc["Leaderboard"]
        </MudNavLink>
    }

    <MudNavLink Href="badges" Icon="@Icons.Material.Filled.MilitaryTech">
        Badges
    </MudNavLink>

    <AuthorizeView Roles="SuperAdmin,Admin,Editeur,Gestionnaire">
        <MudDivider Class="my-2" />
        <MudText Typo="Typo.subtitle2" Class="px-4 mt-2 mb-1" Color="Color.Secondary">
            @Loc["Management"]
        </MudText>
        <MudNavLink Href="dashboard" Icon="@Icons.Material.Filled.Dashboard">
            Dashboard
        </MudNavLink>
        <MudNavLink Href="scanner" Icon="@Icons.Material.Filled.QrCodeScanner">
            @Loc["Scanner"]
        </MudNavLink>
        <MudNavLink Href="admin/objectives" Icon="@Icons.Material.Filled.Assignment">
            @Loc["Objectives"]
        </MudNavLink>
        @if (UserStats?.IsShopEnabled ?? true)
        {
            <MudNavLink Href="admin/store" Icon="@Icons.Material.Filled.Store">
                @Loc["Store"]
            </MudNavLink>
        }
        @if (UserStats?.IsGroupsEnabled ?? true)
        {
            <MudNavLink Href="admin/groups" Icon="@Icons.Material.Filled.Groups">
                @Loc["Groups"]
            </MudNavLink>
        }
        <MudNavLink Href="admin/badges" Icon="@Icons.Material.Filled.MilitaryTech">
            Badges
        </MudNavLink>
        <MudNavLink Href="admin/bonus-periods" Icon="@Icons.Material.Filled.Stars">
            @Loc["Bonus"]
        </MudNavLink>

        <MudDivider Class="my-2" />
        <MudText Typo="Typo.subtitle2" Class="px-4 mt-2 mb-1" Color="Color.Secondary">
            Administration
        </MudText>
        <MudNavLink Href="admin/dashboard" Icon="@Icons.Material.Filled.DashboardCustomize">
            Dashboard
        </MudNavLink>
        <MudNavLink Href="admin/establishment" Icon="@Icons.Material.Filled.Business">
            Établissement
        </MudNavLink>
        <MudNavLink Href="admin/users" Icon="@Icons.Material.Filled.People">
            Utilisateurs
        </MudNavLink>
        <MudNavLink Href="admin/stats" Icon="@Icons.Material.Filled.PieChart">
            Statistiques
        </MudNavLink>
        <MudNavLink Href="admin/subscription" Icon="@Icons.Material.Filled.CreditCard">
            Forfait
        </MudNavLink>
    </AuthorizeView>
</MudNavMenu>

<style>
    .notification-badge {
        background-color: #F44336; /* Red */
        color: white;
        border-radius: 50%;
        width: 20px;
        height: 20px;
        font-size: 12px;
        font-weight: bold;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

@code {
    [CascadingParameter]
    public UserProfileDetailsDto? UserStats { get; set; }

    protected override async Task OnInitializedAsync()
    {
        NotificationService.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await NotificationService.LoadCountsAsync();
        }
    }

    public void Dispose()
    {
        NotificationService.OnChange -= StateHasChanged;
    }
}
