@using Microsoft.Extensions.Localization
@using GamifyMe.UI.Shared.Services
@using GamifyMe.Shared.Dtos
@implements IDisposable
@inject NotificationService NotificationService
@inject IStringLocalizer<GamifyMe.UI.Shared.Resources.App> Loc

@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using GamifyMe.Shared.Constants

<MudNavMenu>
    @if (_isPrivileged)
    {
        <MudNavGroup Title="@Loc["Main Menu"]" @bind-Expanded="_expandMain" Icon="@Icons.Material.Filled.Menu" Class="mp-menu-main">
            @CommonLinks
        </MudNavGroup>

        <AuthorizeView Roles="SuperAdmin,Admin,Coach,Staff">
            <MudNavGroup Title="@Loc["Management"]" @bind-Expanded="_expandManagement" Icon="@Icons.Material.Filled.Dashboard" Class="mp-menu-management">
                 @ManagementLinks
            </MudNavGroup>
            
            <MudNavGroup Title="Administration" @bind-Expanded="_expandAdmin" Icon="@Icons.Material.Filled.Settings" Class="mp-menu-admin">
                @AdminLinks
            </MudNavGroup>
        </AuthorizeView>

        <AuthorizeView Roles="SuperAdmin">
             <MudNavGroup Title="SuperAdmin" @bind-Expanded="_expandSuperAdmin" Icon="@Icons.Material.Filled.SupervisorAccount" Class="mp-menu-superadmin">
                <MudNavLink Href="superadmin/dashboard" Icon="@Icons.Material.Filled.Dashboard">Dashboard Global</MudNavLink>
                <MudNavLink Href="superadmin/establishments" Icon="@Icons.Material.Filled.Business">Établissements</MudNavLink>
                <MudNavLink Href="superadmin/kits" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Inventory">Gestion des Kits</MudNavLink>
                <MudNavLink Href="superadmin/stats" Icon="@Icons.Material.Filled.Analytics">Stats Globales</MudNavLink>
                <MudNavLink Href="admin/blog" Icon="@Icons.Material.Filled.Article">Blog</MudNavLink>
                <MudNavLink Href="help/superadmin" Icon="@Icons.Material.Filled.Help">Aide</MudNavLink>
            </MudNavGroup>
        </AuthorizeView>
    }
    else
    {
        @CommonLinks
    }
</MudNavMenu>

@code {
    RenderFragment CommonLinks => __builder =>
    {
        <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">@Loc["Home"]</MudNavLink>
        <MudNavLink Href="my-qrcode" Icon="@Icons.Material.Filled.QrCode2">@Loc["MyPass"]</MudNavLink>
        
        <div class="d-flex align-center justify-space-between">
            <MudNavLink Href="objectives" Icon="@Icons.Material.Filled.Assignment" Class="flex-grow-1">@Loc["Objectives"]</MudNavLink>
            @if (NotificationService.NewObjectivesCount > 0)
            {
                <div class="notification-badge mr-3">@NotificationService.NewObjectivesCount</div>
            }
        </div>

        @if (UserStats?.IsShopEnabled ?? true)
        {
            <div class="d-flex align-center justify-space-between">
                <MudNavLink Href="store" Icon="@Icons.Material.Filled.Store" Class="flex-grow-1">@Loc["Store"]</MudNavLink>
                @if (NotificationService.NewStoreItemsCount > 0)
                {
                    <div class="notification-badge mr-3">@NotificationService.NewStoreItemsCount</div>
                }
            </div>
            <MudNavLink Href="inventory" Icon="@Icons.Material.Filled.Inventory">@Loc["Inventory"]</MudNavLink>
        }

        @if (UserStats?.IsGroupsEnabled ?? true)
        {
            <div class="d-flex align-center justify-space-between">
                <MudNavLink Href="groups" Icon="@Icons.Material.Filled.Groups" Class="flex-grow-1">@Loc["Groups"]</MudNavLink>
                @if (NotificationService.NewGroupsCount > 0)
                {
                    <div class="notification-badge mr-3">@NotificationService.NewGroupsCount</div>
                }
            </div>
            <MudNavLink Href="leaderboard" Icon="@Icons.Material.Filled.EmojiEvents">@Loc["Leaderboard"]</MudNavLink>
        }
        <MudNavLink Href="badges" Icon="@Icons.Material.Filled.MilitaryTech">Badges</MudNavLink>
        <MudNavLink Href="faq" Icon="@Icons.Material.Filled.QuestionAnswer">FAQ</MudNavLink>
    };

    RenderFragment ManagementLinks => __builder =>
    {
        <MudNavLink Href="dashboard" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
        <MudNavLink Href="scanner" Icon="@Icons.Material.Filled.QrCodeScanner">@Loc["Scanner"]</MudNavLink>
        @if (UserStats?.IsShopEnabled ?? true)
        {
            <MudNavLink Href="admin/system-health" Icon="@Icons.Material.Filled.MonitorHeart">Santé Système</MudNavLink>
        }
        <MudNavLink Href="admin/objectives" Icon="@Icons.Material.Filled.Assignment">@Loc["Objectives"]</MudNavLink>
        @if (UserStats?.IsShopEnabled ?? true)
        {
            <MudNavLink Href="admin/store" Icon="@Icons.Material.Filled.Store">@Loc["Store"]</MudNavLink>
        }
        @if (UserStats?.IsGroupsEnabled ?? true)
        {
            <MudNavLink Href="admin/groups" Icon="@Icons.Material.Filled.Groups">@Loc["Groups"]</MudNavLink>
        }
        <MudNavLink Href="admin/badges" Icon="@Icons.Material.Filled.MilitaryTech">Badges</MudNavLink>
        <MudNavLink Href="admin/bonus-periods" Icon="@Icons.Material.Filled.Stars">@Loc["Bonus"]</MudNavLink>
        <MudNavLink Href="help/coach" Icon="@Icons.Material.Filled.Help">Aide</MudNavLink>
    };

    RenderFragment AdminLinks => __builder =>
    {
        <MudNavLink Href="admin/dashboard" Icon="@Icons.Material.Filled.DashboardCustomize">Dashboard</MudNavLink>
        <MudNavLink Href="admin/establishment" Icon="@Icons.Material.Filled.Business">Établissement</MudNavLink>
        <MudNavLink Href="admin/strategy" Icon="@Icons.Material.Filled.Tune">Configuration Stratégique</MudNavLink>
        <MudNavLink Href="admin/kits" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Inventory2">Kits de Contenu</MudNavLink>
        <MudNavLink Href="admin/users" Icon="@Icons.Material.Filled.People">Utilisateurs</MudNavLink>
        <MudNavLink Href="admin/stats" Icon="@Icons.Material.Filled.PieChart">Statistiques</MudNavLink>
        <MudNavLink Href="admin/subscription" Icon="@Icons.Material.Filled.CreditCard">Forfait</MudNavLink>
        <MudNavLink Href="help/admin" Icon="@Icons.Material.Filled.Help">Aide</MudNavLink>
    };
}

<style>
    .notification-badge {
        background-color: #F44336; /* Red */
        color: white;
        border-radius: 50%;
        width: 20px;
        height: 20px;
        font-size: 12px;
        font-weight: bold;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .mp-menu-main { background-color: rgba(26, 43, 76, 0.05); margin-bottom: 4px; }
    .mp-menu-management { background-color: rgba(203, 247, 237, 0.3); margin-bottom: 4px; }
    .mp-menu-admin { background-color: rgba(255, 164, 0, 0.1); margin-bottom: 4px; }
    .mp-menu-superadmin { background-color: rgba(177, 94, 108, 0.1); margin-bottom: 4px; }
</style>

@code {
    [CascadingParameter]
    public UserProfileDetailsDto? UserStats { get; set; }

    [Inject] AuthenticationStateProvider AuthStateProvider { get; set; } = default!;

    private bool _isPrivileged;
    private bool _expandMain;
    private bool _expandManagement;
    private bool _expandAdmin;
    private bool _expandSuperAdmin;

    protected override async Task OnInitializedAsync()
    {
        NotificationService.OnChange += StateHasChanged;
        
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var isAdmin = user.IsInRole(Roles.Admin) || user.IsInRole(Roles.SuperAdmin);
            var isEditorOrManager = user.IsInRole(Roles.Coach) || user.IsInRole(Roles.Staff);
            
            _isPrivileged = isAdmin || isEditorOrManager;

            if (user.IsInRole(Roles.SuperAdmin))
            {
                _expandSuperAdmin = true;
                _expandAdmin = false;
                _expandMain = false; 
                _expandManagement = false;
            }
            else if (isAdmin) // Admin but not SuperAdmin
            {
                _expandAdmin = true;
                _expandMain = false; 
                _expandManagement = false;
                _expandSuperAdmin = false;
            }
            else if (isEditorOrManager)
            {
                _expandManagement = true;
                _expandMain = false;
                _expandAdmin = false;
                _expandSuperAdmin = false;
            }
            else 
            {
                 // Default for standard users or fallback
                 _expandMain = true;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await NotificationService.LoadCountsAsync();
        }
    }

    public void Dispose()
    {
        NotificationService.OnChange -= StateHasChanged;
    }
}
