@inherits LayoutComponentBase
@using MudBlazor
@using GamifyMe.UI.Shared.Layout

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Color="Color.Transparent" Fixed="true" Class="landing-appbar" Style="background-color: rgba(255,255,255,0.95); backdrop-filter: blur(10px); border-bottom: 1px solid #eee;">
        <MudContainer MaxWidth="MaxWidth.Large" Class="d-flex align-center justify-space-between py-2">
            
            @* LOGO (Top Left) *@
            <div class="d-flex align-center cursor-pointer" @onclick="@(() => Navigation.NavigateTo("/"))">
                <img src="img/logo.png" alt="MeritoPass" style="height: 40px;" />
            </div>

            @* MENU (Top Center - Hidden on Mobile) *@
            <div class="d-none d-md-flex gap-8">
                <MudLink Href="#features" Underline="Underline.None" Color="Color.Dark" Typo="Typo.body1" Style="font-weight: 500;">Fonctionnalités</MudLink>
                <MudLink Href="#reviews" Underline="Underline.None" Color="Color.Dark" Typo="Typo.body1" Style="font-weight: 500;">Témoignages</MudLink>
                <MudLink Href="#pricing" Underline="Underline.None" Color="Color.Dark" Typo="Typo.body1" Style="font-weight: 500;">Tarifs</MudLink>
            </div>

            @* LOGIN (Top Right) *@
            <div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/login" Class="rounded-pill px-6">Connexion</MudButton>
            </div>

        </MudContainer>
    </MudAppBar>

    <MudMainContent Class="pt-16">
        @Body
        
        @* FOOTER (Forced Visible) *@
        <AppFooter IsAppMode="false" />
    </MudMainContent>
</MudLayout>

@code {
    [Inject] NavigationManager Navigation { get; set; } = default!;
}
