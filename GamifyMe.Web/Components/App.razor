@using Microsoft.AspNetCore.Components.Web
@using GamifyMe.UI.Shared
@using GamifyMe.UI.Shared.Layout
@using GamifyMe.UI.Shared.Components

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentCulture.Name">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link rel="icon" type="image/png" href="img/logo.png" />

    <HeadOutlet @rendermode="new InteractiveAutoRenderMode(prerender: false)" />
</head>

<body>
    <Routes @rendermode="new InteractiveAutoRenderMode(prerender: false)" 
            AdditionalAssemblyNames="@(new[] { "GamifyMe.Web.Client", "GamifyMe.Web" })" />

    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>

    <script src="js/html5-qrcode.min.js"></script>
    <script src="js/qrScanner.js"></script>
    <script src="js/qrcode-share.js"></script>
    <script src="js/downloadFile.js"></script>
    <script>
        window.getCookie = function(name) {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return parts.pop().split(';').shift();
            return null;
        }
    </script>
</body>

</html>